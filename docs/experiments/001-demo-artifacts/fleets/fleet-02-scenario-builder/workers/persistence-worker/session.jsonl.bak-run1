{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xe1SevyyYRA3HMNWx3LPP2","type":"tool_result","content":"1\t/**\n2\t * ScenarioManager — save/load and preset library for pathfinding scenarios.\n3\t *\n4\t * Scenario schema:\n5\t *   { width, height, startX, startY, endX, endY, matrix }\n6\t *   matrix[y][x] === 1 → wall, 0 → walkable\n7\t */\n8\t\n9\tvar REQUIRED_FIELDS = ['width', 'height', 'startX', 'startY', 'endX', 'endY', 'matrix'];\n10\tvar PRESET_SIZE = 15;\n11\t\n12\t// ---------------------------------------------------------------------------\n13\t// Helpers\n14\t// ---------------------------------------------------------------------------\n15\t\n16\tfunction emptyMatrix(width, height) {\n17\t    var m = [];\n18\t    for (var y = 0; y < height; y++) {\n19\t        m[y] = [];\n20\t        for (var x = 0; x < width; x++) {\n21\t            m[y][x] = 0;\n22\t        }\n23\t    }\n24\t    return m;\n25\t}\n26\t\n27\tfunction validateObject(obj) {\n28\t    REQUIRED_FIELDS.forEach(function(f) {\n29\t        if (obj[f] === undefined || obj[f] === null) {\n30\t            throw new Error('Missing required field: ' + f);\n31\t        }\n32\t    });\n33\t    if (!Array.isArray(obj.matrix) || obj.matrix.length !== obj.height ||\n34\t        !Array.isArray(obj.matrix[0]) || obj.matrix[0].length !== obj.width) {\n35\t        throw new Error('matrix dimensions do not match width/height');\n36\t    }\n37\t}\n38\t\n39\t// ---------------------------------------------------------------------------\n40\t// Public API\n41\t// ---------------------------------------------------------------------------\n42\t\n43\tfunction save(scenario) {\n44\t    return JSON.stringify(scenario);\n45\t}\n46\t\n47\tfunction load(jsonString) {\n48\t    var obj;\n49\t    try {\n50\t        obj = JSON.parse(jsonString);\n51\t    } catch (e) {\n52\t        throw new Error('Invalid JSON: ' + e.message);\n53\t    }\n54\t    validateObject(obj);\n55\t    return obj;\n56\t}\n57\t\n58\tfunction saveObject(scenario) {\n59\t    return JSON.parse(JSON.stringify(scenario)); // deep clone\n60\t}\n61\t\n62\tfunction loadObject(obj) {\n63\t    validateObject(obj);\n64\t    return JSON.parse(JSON.stringify(obj)); // defensive clone\n65\t}\n66\t\n67\t// ---------------------------------------------------------------------------\n68\t// Preset generators (all 15x15, deterministic except 'random')\n69\t// ---------------------------------------------------------------------------\n70\t\n71\tfunction makeEmpty() {\n72\t    return {\n73\t        width: PRESET_SIZE,\n74\t        height: PRESET_SIZE,\n75\t        startX: 0,\n76\t        startY: 0,\n77\t        endX: PRESET_SIZE - 1,\n78\t        endY: PRESET_SIZE - 1,\n79\t        matrix: emptyMatrix(PRESET_SIZE, PRESET_SIZE)\n80\t    };\n81\t}\n82\t\n83\tfunction makeMaze() {\n84\t    var S = PRESET_SIZE;\n85\t    var m = emptyMatrix(S, S);\n86\t\n87\t    // Horizontal walls every 2 rows with staggered gaps (corridor maze)\n88\t    for (var y = 2; y < S - 1; y += 4) {\n89\t        for (var x = 0; x < S; x++) {\n90\t            m[y][x] = 1;\n91\t        }\n92\t        // gap on right side\n93\t        m[y][S - 2] = 0;\n94\t    }\n95\t    for (var y2 = 4; y2 < S - 1; y2 += 4) {\n96\t        for (var x2 = 0; x2 < S; x2++) {\n97\t            m[y2][x2] = 1;\n98\t        }\n99\t        // gap on left side\n100\t        m[y2][1] = 0;\n101\t    }\n102\t\n103\t    // Keep start/end clear\n104\t    m[0][0] = 0;\n105\t    m[S - 1][S - 1] = 0;\n106\t\n107\t    return {\n108\t        width: S, height: S,\n109\t        startX: 0, startY: 0,\n110\t        endX: S - 1, endY: S - 1,\n111\t        matrix: m\n112\t    };\n113\t}\n114\t\n115\tfunction makeSpiral() {\n116\t    var S = PRESET_SIZE;\n117\t    var m = emptyMatrix(S, S);\n118\t\n119\t    // Draw concentric rectangular rings (partial, leaving a gap to enter inner ring)\n120\t    var rings = Math.floor(S / 4);\n121\t    for (var r = 0; r < rings; r++) {\n122\t        var top    = r * 2;\n123\t        var left   = r * 2;\n124\t        var bottom = S - 1 - r * 2;\n125\t        var right  = S - 1 - r * 2;\n126\t\n127\t        if (top >= bottom || left >= right) break;\n128\t\n129\t        // top row\n130\t        for (var x = left; x <= right; x++) m[top][x] = 1;\n131\t        // right col\n132\t        for (var y = top; y <= bottom; y++) m[y][right] = 1;\n133\t        // bottom row\n134\t        for (var x2 = left; x2 <= right; x2++) m[bottom][x2] = 1;\n135\t        // left col\n136\t        for (var y2 = top; y2 <= bottom; y2++) m[y2][left] = 1;\n137\t\n138\t        // opening: alternate top-right gap and bottom-left gap per ring\n139\t        if (r % 2 === 0) {\n140\t            // gap at bottom-left\n141\t            m[bottom][left + 1] = 0;\n142\t        } else {\n143\t            // gap at top-right\n144\t            m[top][right - 1] = 0;\n145\t        }\n146\t    }\n147\t\n148\t    // Always clear start and end\n149\t    m[0][0] = 0;\n150\t    m[S - 1][S - 1] = 0;\n151\t\n152\t    return {\n153\t        width: S, height: S,\n154\t        startX: 0, startY: 0,\n155\t        endX: S - 1, endY: S - 1,\n156\t        matrix: m\n157\t    };\n158\t}\n159\t\n160\tfunction makeBottleneck() {\n161\t    var S = PRESET_SIZE;\n162\t    var m = emptyMatrix(S, S);\n163\t    var midY = Math.floor(S / 2);\n164\t    var gapX = Math.floor(S / 2); // single cell gap in the middle\n165\t\n166\t    // Wall across the full middle row except one gap\n167\t    for (var x = 0; x < S; x++) {\n168\t        if (x !== gapX) {\n169\t            m[midY][x] = 1;\n170\t        }\n171\t    }\n172\t\n173\t    m[0][0] = 0;\n174\t    m[S - 1][S - 1] = 0;\n175\t\n176\t    return {\n177\t        width: S, height: S,\n178\t        startX: 0, startY: 0,\n179\t        endX: S - 1, endY: S - 1,\n180\t        matrix: m\n181\t    };\n182\t}\n183\t\n184\tfunction makeRandom() {\n185\t    var S = PRESET_SIZE;\n186\t    var m = emptyMatrix(S, S);\n187\t    var startX = 0, startY = 0, endX = S - 1, endY = S - 1;\n188\t\n189\t    // Seeded-ish deterministic \"random\" using a simple LCG for reproducibility\n190\t    var seed = 42;\n191\t    function rand() {\n192\t        seed = (seed * 1664525 + 1013904223) & 0xffffffff;\n193\t        return (seed >>> 0) / 0xffffffff;\n194\t    }\n195\t\n196\t    var density = 0.25;\n197\t    for (var y = 0; y < S; y++) {\n198\t        for (var x = 0; x < S; x++) {\n199\t            // Never wall start or end\n200\t            if ((x === startX && y === startY) || (x === endX && y === endY)) continue;\n201\t            if (rand() < density) m[y][x] = 1;\n202\t        }\n203\t    }\n204\t\n205\t    return {\n206\t        width: S, height: S,\n207\t        startX: startX, startY: startY,\n208\t        endX: endX, endY: endY,\n209\t        matrix: m\n210\t    };\n211\t}\n212\t\n213\t// ---------------------------------------------------------------------------\n214\t// Preset registry\n215\t// ---------------------------------------------------------------------------\n216\t\n217\tvar PRESETS = {\n218\t    empty:       makeEmpty,\n219\t    maze:        makeMaze,\n220\t    spiral:      makeSpiral,\n221\t    bottleneck:  makeBottleneck,\n222\t    random:      makeRandom\n223\t};\n224\t\n225\tfunction presetNames() {\n226\t    return Object.keys(PRESETS);\n227\t}\n228\t\n229\tfunction loadPreset(name) {\n230\t    if (!PRESETS[name]) {\n231\t        throw new Error('Unknown preset: \"' + name + '\"');\n232\t    }\n233\t    return PRESETS[name]();\n234\t}\n235\t\n236\t// ---------------------------------------------------------------------------\n237\t// Exports\n238\t// ---------------------------------------------------------------------------\n239\t\n240\tmodule.exports = {\n241\t    emptyMatrix:  emptyMatrix,\n242\t    save:         save,\n243\t    load:         load,\n244\t    saveObject:   saveObject,\n245\t    loadObject:   loadObject,\n246\t    presetNames:  presetNames,\n247\t    loadPreset:   loadPreset\n248\t};\n249\t"}]},"parent_tool_use_id":null,"session_id":"e42e832b-8d8e-44ac-8ac9-00a63c895cb9","uuid":"f4a3bfcf-dc8a-472f-8f80-bf25cae42626","timestamp":"2026-04-16T15:38:29.840Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/docs/experiments/001-demo-artifacts/fleets/fleet-02-scenario-builder/workers/persistence-worker/output/ScenarioManager.js","content":"/**\n * ScenarioManager — save/load and preset library for pathfinding scenarios.\n *\n * Scenario schema:\n *   { width, height, startX, startY, endX, endY, matrix }\n *   matrix[y][x] === 1 → wall, 0 → walkable\n */\n\nvar REQUIRED_FIELDS = ['width', 'height', 'startX', 'startY', 'endX', 'endY', 'matrix'];\nvar PRESET_SIZE = 15;\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfunction emptyMatrix(width, height) {\n    var m = [];\n    for (var y = 0; y < height; y++) {\n        m[y] = [];\n        for (var x = 0; x < width; x++) {\n            m[y][x] = 0;\n        }\n    }\n    return m;\n}\n\nfunction validateObject(obj) {\n    REQUIRED_FIELDS.forEach(function(f) {\n        if (obj[f] === undefined || obj[f] === null) {\n            throw new Error('Missing required field: ' + f);\n        }\n    });\n    if (!Array.isArray(obj.matrix) || obj.matrix.length !== obj.height ||\n        !Array.isArray(obj.matrix[0]) || obj.matrix[0].length !== obj.width) {\n        throw new Error('matrix dimensions do not match width/height');\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\nfunction save(scenario) {\n    return JSON.stringify(scenario);\n}\n\nfunction load(jsonString) {\n    var obj;\n    try {\n        obj = JSON.parse(jsonString);\n    } catch (e) {\n        throw new Error('Invalid JSON: ' + e.message);\n    }\n    validateObject(obj);\n    return obj;\n}\n\nfunction saveObject(scenario) {\n    return JSON.parse(JSON.stringify(scenario)); // deep clone\n}\n\nfunction loadObject(obj) {\n    validateObject(obj);\n    return JSON.parse(JSON.stringify(obj)); // defensive clone\n}\n\n// ---------------------------------------------------------------------------\n// Preset generators (all 15x15, deterministic except 'random')\n// ---------------------------------------------------------------------------\n\nfunction makeEmpty() {\n    return {\n        width: PRESET_SIZE,\n        height: PRESET_SIZE,\n        startX: 0,\n        startY: 0,\n        endX: PRESET_SIZE - 1,\n        endY: PRESET_SIZE - 1,\n        matrix: emptyMatrix(PRESET_SIZE, PRESET_SIZE)\n    };\n}\n\nfunction makeMaze() {\n    var S = PRESET_SIZE;\n    var m = emptyMatrix(S, S);\n\n    // Horizontal walls every 2 rows with staggered gaps (corridor maze)\n    for (var y = 2; y < S - 1; y += 4) {\n        for (var x = 0; x < S; x++) {\n            m[y][x] = 1;\n        }\n        // gap on right side\n        m[y][S - 2] = 0;\n    }\n    for (var y2 = 4; y2 < S - 1; y2 += 4) {\n        for (var x2 = 0; x2 < S; x2++) {\n            m[y2][x2] = 1;\n        }\n        // gap on left side\n        m[y2][1] = 0;\n    }\n\n    // Keep start/end clear\n    m[0][0] = 0;\n    m[S - 1][S - 1] = 0;\n\n    return {\n        width: S, height: S,\n        startX: 0, startY: 0,\n        endX: S - 1, endY: S - 1,\n        matrix: m\n    };\n}\n\nfunction makeSpiral() {\n    var S = PRESET_SIZE;\n    var m = emptyMatrix(S, S);\n\n    // Draw concentric rectangular rings (partial, leaving a gap to enter inner ring)\n    var rings = Math.floor(S / 4);\n    for (var r = 0; r < rings; r++) {\n        var top    = r * 2;\n        var left   = r * 2;\n        var bottom = S - 1 - r * 2;\n        var right  = S - 1 - r * 2;\n\n        if (top >= bottom || left >= right) break;\n\n        // top row\n        for (var x = left; x <= right; x++) m[top][x] = 1;\n        // right col\n        for (var y = top; y <= bottom; y++) m[y][right] = 1;\n        // bottom row\n        for (var x2 = left; x2 <= right; x2++) m[bottom][x2] = 1;\n        // left col\n        for (var y2 = top; y2 <= bottom; y2++) m[y2][left] = 1;\n\n        // opening: alternate top-right gap and bottom-left gap per ring\n        if (r % 2 === 0) {\n            // gap at bottom-left\n            m[bottom][left + 1] = 0;\n        } else {\n            // gap at top-right\n            m[top][right - 1] = 0;\n        }\n    }\n\n    // Always clear start and end\n    m[0][0] = 0;\n    m[S - 1][S - 1] = 0;\n\n    return {\n        width: S, height: S,\n        startX: 0, startY: 0,\n        endX: S - 1, endY: S - 1,\n        matrix: m\n    };\n}\n\nfunction makeBottleneck() {\n    var S = PRESET_SIZE;\n    var m = emptyMatrix(S, S);\n    var midY = Math.floor(S / 2);\n    var gapX = Math.floor(S / 2); // single cell gap in the middle\n\n    // Wall across the full middle row except one gap\n    for (var x = 0; x < S; x++) {\n        if (x !== gapX) {\n            m[midY][x] = 1;\n        }\n    }\n\n    m[0][0] = 0;\n    m[S - 1][S - 1] = 0;\n\n    return {\n        width: S, height: S,\n        startX: 0, startY: 0,\n        endX: S - 1, endY: S - 1,\n        matrix: m\n    };\n}\n\nfunction makeRandom() {\n    var S = PRESET_SIZE;\n    var m = emptyMatrix(S, S);\n    var startX = 0, startY = 0, endX = S - 1, endY = S - 1;\n\n    // Seeded-ish deterministic \"random\" using a simple LCG for reproducibility\n    var seed = 42;\n    function rand() {\n        seed = (seed * 1664525 + 1013904223) & 0xffffffff;\n        return (seed >>> 0) / 0xffffffff;\n    }\n\n    var density = 0.25;\n    for (var y = 0; y < S; y++) {\n        for (var x = 0; x < S; x++) {\n            // Never wall start or end\n            if ((x === startX && y === startY) || (x === endX && y === endY)) continue;\n            if (rand() < density) m[y][x] = 1;\n        }\n    }\n\n    return {\n        width: S, height: S,\n        startX: startX, startY: startY,\n        endX: endX, endY: endY,\n        matrix: m\n    };\n}\n\n// ---------------------------------------------------------------------------\n// Preset registry\n// ---------------------------------------------------------------------------\n\nvar PRESETS = {\n    empty:       makeEmpty,\n    maze:        makeMaze,\n    spiral:      makeSpiral,\n    bottleneck:  makeBottleneck,\n    random:      makeRandom\n};\n\nfunction presetNames() {\n    return Object.keys(PRESETS);\n}\n\nfunction loadPreset(name) {\n    if (!PRESETS[name]) {\n        throw new Error('Unknown preset: \"' + name + '\"');\n    }\n    return PRESETS[name]();\n}\n\n// ---------------------------------------------------------------------------\n// Exports\n// ---------------------------------------------------------------------------\n\nmodule.exports = {\n    emptyMatrix:  emptyMatrix,\n    save:         save,\n    load:         load,\n    saveObject:   saveObject,\n    loadObject:   loadObject,\n    presetNames:  presetNames,\n    loadPreset:   loadPreset\n};\n","numLines":249,"startLine":1,"totalLines":249}}}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01VGCyRk6mpHwpojeYbJ7wdN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FduhWE9xwQgtkf5cgSZuzB","name":"Read","input":{"file_path":"/home/sagar/template-repo/docs/experiments/001-demo-artifacts/fleets/fleet-02-scenario-builder/workers/persistence-worker/output/ScenarioManager.test.js"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2967,"cache_read_input_tokens":17878,"cache_creation":{"ephemeral_5m_input_tokens":2967,"ephemeral_1h_input_tokens":0},"output_tokens":38,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e42e832b-8d8e-44ac-8ac9-00a63c895cb9","uuid":"841b1ff5-4230-41b8-9e58-accb6659d990"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FduhWE9xwQgtkf5cgSZuzB","type":"tool_result","content":"1\tvar should = require('should');\n2\tvar ScenarioManager = require('../src/scenario/ScenarioManager');\n3\t\n4\tvar SIZE = 15;\n5\t\n6\tfunction makeEmptyScenario() {\n7\t    return {\n8\t        width: SIZE,\n9\t        height: SIZE,\n10\t        startX: 0,\n11\t        startY: 0,\n12\t        endX: SIZE - 1,\n13\t        endY: SIZE - 1,\n14\t        matrix: ScenarioManager.emptyMatrix(SIZE, SIZE)\n15\t    };\n16\t}\n17\t\n18\tdescribe('ScenarioManager', function() {\n19\t\n20\t    describe('emptyMatrix', function() {\n21\t        it('should return SIZE x SIZE matrix of zeros', function() {\n22\t            var m = ScenarioManager.emptyMatrix(SIZE, SIZE);\n23\t            m.should.have.length(SIZE);\n24\t            m[0].should.have.length(SIZE);\n25\t            m[0][0].should.equal(0);\n26\t            m[SIZE - 1][SIZE - 1].should.equal(0);\n27\t        });\n28\t    });\n29\t\n30\t    describe('save', function() {\n31\t        it('should serialize scenario to JSON string', function() {\n32\t            var scenario = makeEmptyScenario();\n33\t            var json = ScenarioManager.save(scenario);\n34\t            json.should.be.a.String();\n35\t            var parsed = JSON.parse(json);\n36\t            parsed.width.should.equal(SIZE);\n37\t            parsed.height.should.equal(SIZE);\n38\t            parsed.startX.should.equal(0);\n39\t            parsed.startY.should.equal(0);\n40\t            parsed.endX.should.equal(SIZE - 1);\n41\t            parsed.endY.should.equal(SIZE - 1);\n42\t            parsed.matrix.should.have.length(SIZE);\n43\t        });\n44\t\n45\t        it('should preserve wall positions', function() {\n46\t            var scenario = makeEmptyScenario();\n47\t            scenario.matrix[3][7] = 1;\n48\t            scenario.matrix[0][1] = 1;\n49\t            var parsed = JSON.parse(ScenarioManager.save(scenario));\n50\t            parsed.matrix[3][7].should.equal(1);\n51\t            parsed.matrix[0][1].should.equal(1);\n52\t            parsed.matrix[0][0].should.equal(0);\n53\t        });\n54\t    });\n55\t\n56\t    describe('load', function() {\n57\t        it('should deserialize JSON string back to scenario', function() {\n58\t            var original = makeEmptyScenario();\n59\t            original.matrix[5][5] = 1;\n60\t            var json = ScenarioManager.save(original);\n61\t            var loaded = ScenarioManager.load(json);\n62\t            loaded.width.should.equal(SIZE);\n63\t            loaded.height.should.equal(SIZE);\n64\t            loaded.startX.should.equal(0);\n65\t            loaded.endY.should.equal(SIZE - 1);\n66\t            loaded.matrix[5][5].should.equal(1);\n67\t            loaded.matrix[0][0].should.equal(0);\n68\t        });\n69\t\n70\t        it('should throw on invalid JSON', function() {\n71\t            (function() {\n72\t                ScenarioManager.load('not-valid-json');\n73\t            }).should.throw();\n74\t        });\n75\t\n76\t        it('should throw if required fields missing', function() {\n77\t            (function() {\n78\t                ScenarioManager.load('{\"width\":15}');\n79\t            }).should.throw(/missing required field/i);\n80\t        });\n81\t\n82\t        it('should throw if matrix dimensions mismatch', function() {\n83\t            var scenario = makeEmptyScenario();\n84\t            var obj = JSON.parse(ScenarioManager.save(scenario));\n85\t            obj.matrix = [[0, 0], [0, 0]]; // wrong size\n86\t            (function() {\n87\t                ScenarioManager.load(JSON.stringify(obj));\n88\t            }).should.throw(/matrix/i);\n89\t        });\n90\t    });\n91\t\n92\t    describe('saveObject / loadObject', function() {\n93\t        it('saveObject should return plain object (not string)', function() {\n94\t            var scenario = makeEmptyScenario();\n95\t            var obj = ScenarioManager.saveObject(scenario);\n96\t            obj.should.be.an.Object().and.not.be.a.String();\n97\t            obj.width.should.equal(SIZE);\n98\t        });\n99\t\n100\t        it('loadObject should accept plain object', function() {\n101\t            var scenario = makeEmptyScenario();\n102\t            scenario.matrix[2][9] = 1;\n103\t            var obj = ScenarioManager.saveObject(scenario);\n104\t            var loaded = ScenarioManager.loadObject(obj);\n105\t            loaded.matrix[2][9].should.equal(1);\n106\t        });\n107\t    });\n108\t\n109\t    describe('presets', function() {\n110\t        it('should list at least 5 preset names', function() {\n111\t            var names = ScenarioManager.presetNames();\n112\t            names.should.be.an.Array();\n113\t            names.length.should.be.aboveOrEqual(5);\n114\t        });\n115\t\n116\t        describe('empty preset', function() {\n117\t            var scenario;\n118\t            before(function() { scenario = ScenarioManager.loadPreset('empty'); });\n119\t\n120\t            it('should be 15x15', function() {\n121\t                scenario.width.should.equal(SIZE);\n122\t                scenario.height.should.equal(SIZE);\n123\t            });\n124\t\n125\t            it('should have no walls', function() {\n126\t                for (var y = 0; y < SIZE; y++) {\n127\t                    for (var x = 0; x < SIZE; x++) {\n128\t                        scenario.matrix[y][x].should.equal(0);\n129\t                    }\n130\t                }\n131\t            });\n132\t\n133\t            it('should have valid start and end', function() {\n134\t                scenario.startX.should.be.within(0, SIZE - 1);\n135\t                scenario.startY.should.be.within(0, SIZE - 1);\n136\t                scenario.endX.should.be.within(0, SIZE - 1);\n137\t                scenario.endY.should.be.within(0, SIZE - 1);\n138\t            });\n139\t        });\n140\t\n141\t        describe('maze preset', function() {\n142\t            var scenario;\n143\t            before(function() { scenario = ScenarioManager.loadPreset('maze'); });\n144\t\n145\t            it('should be 15x15', function() {\n146\t                scenario.width.should.equal(SIZE);\n147\t                scenario.height.should.equal(SIZE);\n148\t            });\n149\t\n150\t            it('should have walls (non-zero cells)', function() {\n151\t                var wallCount = 0;\n152\t                for (var y = 0; y < SIZE; y++) {\n153\t                    for (var x = 0; x < SIZE; x++) {\n154\t                        if (scenario.matrix[y][x] === 1) wallCount++;\n155\t                    }\n156\t                }\n157\t                wallCount.should.be.above(10);\n158\t            });\n159\t        });\n160\t\n161\t        describe('spiral preset', function() {\n162\t            var scenario;\n163\t            before(function() { scenario = ScenarioManager.loadPreset('spiral'); });\n164\t\n165\t            it('should be 15x15 with walls', function() {\n166\t                scenario.width.should.equal(SIZE);\n167\t                scenario.height.should.equal(SIZE);\n168\t                var wallCount = 0;\n169\t                for (var y = 0; y < SIZE; y++) {\n170\t                    for (var x = 0; x < SIZE; x++) {\n171\t                        if (scenario.matrix[y][x] === 1) wallCount++;\n172\t                    }\n173\t                }\n174\t                wallCount.should.be.above(5);\n175\t            });\n176\t        });\n177\t\n178\t        describe('bottleneck preset', function() {\n179\t            var scenario;\n180\t            before(function() { scenario = ScenarioManager.loadPreset('bottleneck'); });\n181\t\n182\t            it('should be 15x15', function() {\n183\t                scenario.width.should.equal(SIZE);\n184\t                scenario.height.should.equal(SIZE);\n185\t            });\n186\t\n187\t            it('should have a narrow passage (many walls across middle)', function() {\n188\t                var wallCountMiddleRow = 0;\n189\t                var midY = Math.floor(SIZE / 2);\n190\t                for (var x = 0; x < SIZE; x++) {\n191\t                    if (scenario.matrix[midY][x] === 1) wallCountMiddleRow++;\n192\t                }\n193\t                // bottleneck: most of the middle row is walls with a gap\n194\t                wallCountMiddleRow.should.be.above(SIZE / 2);\n195\t            });\n196\t        });\n197\t\n198\t        describe('random preset', function() {\n199\t            var scenario;\n200\t            before(function() { scenario = ScenarioManager.loadPreset('random'); });\n201\t\n202\t            it('should be 15x15', function() {\n203\t                scenario.width.should.equal(SIZE);\n204\t                scenario.height.should.equal(SIZE);\n205\t            });\n206\t\n207\t            it('should have some walls', function() {\n208\t                var wallCount = 0;\n209\t                for (var y = 0; y < SIZE; y++) {\n210\t                    for (var x = 0; x < SIZE; x++) {\n211\t                        if (scenario.matrix[y][x] === 1) wallCount++;\n212\t                    }\n213\t                }\n214\t                wallCount.should.be.above(0);\n215\t            });\n216\t\n217\t            it('start and end cells should always be walkable', function() {\n218\t                scenario.matrix[scenario.startY][scenario.startX].should.equal(0);\n219\t                scenario.matrix[scenario.endY][scenario.endX].should.equal(0);\n220\t            });\n221\t        });\n222\t\n223\t        it('should throw on unknown preset name', function() {\n224\t            (function() {\n225\t                ScenarioManager.loadPreset('does-not-exist');\n226\t            }).should.throw(/unknown preset/i);\n227\t        });\n228\t    });\n229\t\n230\t    describe('round-trip', function() {\n231\t        it('each preset should survive save/load round-trip', function() {\n232\t            ScenarioManager.presetNames().forEach(function(name) {\n233\t                var original = ScenarioManager.loadPreset(name);\n234\t                var json = ScenarioManager.save(original);\n235\t                var loaded = ScenarioManager.load(json);\n236\t                loaded.width.should.equal(original.width);\n237\t                loaded.height.should.equal(original.height);\n238\t                loaded.matrix[0][0].should.equal(original.matrix[0][0]);\n239\t                loaded.matrix[SIZE - 1][SIZE - 1].should.equal(original.matrix[SIZE - 1][SIZE - 1]);\n240\t            });\n241\t        });\n242\t    });\n243\t\n244\t});\n245\t"}]},"parent_tool_use_id":null,"session_id":"e42e832b-8d8e-44ac-8ac9-00a63c895cb9","uuid":"735b2a9d-e5ea-42f1-a46f-cdbb1bc31915","timestamp":"2026-04-16T15:38:33.238Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/docs/experiments/001-demo-artifacts/fleets/fleet-02-scenario-builder/workers/persistence-worker/output/ScenarioManager.test.js","content":"var should = require('should');\nvar ScenarioManager = require('../src/scenario/ScenarioManager');\n\nvar SIZE = 15;\n\nfunction makeEmptyScenario() {\n    return {\n        width: SIZE,\n        height: SIZE,\n        startX: 0,\n        startY: 0,\n        endX: SIZE - 1,\n        endY: SIZE - 1,\n        matrix: ScenarioManager.emptyMatrix(SIZE, SIZE)\n    };\n}\n\ndescribe('ScenarioManager', function() {\n\n    describe('emptyMatrix', function() {\n        it('should return SIZE x SIZE matrix of zeros', function() {\n            var m = ScenarioManager.emptyMatrix(SIZE, SIZE);\n            m.should.have.length(SIZE);\n            m[0].should.have.length(SIZE);\n            m[0][0].should.equal(0);\n            m[SIZE - 1][SIZE - 1].should.equal(0);\n        });\n    });\n\n    describe('save', function() {\n        it('should serialize scenario to JSON string', function() {\n            var scenario = makeEmptyScenario();\n            var json = ScenarioManager.save(scenario);\n            json.should.be.a.String();\n            var parsed = JSON.parse(json);\n            parsed.width.should.equal(SIZE);\n            parsed.height.should.equal(SIZE);\n            parsed.startX.should.equal(0);\n            parsed.startY.should.equal(0);\n            parsed.endX.should.equal(SIZE - 1);\n            parsed.endY.should.equal(SIZE - 1);\n            parsed.matrix.should.have.length(SIZE);\n        });\n\n        it('should preserve wall positions', function() {\n            var scenario = makeEmptyScenario();\n            scenario.matrix[3][7] = 1;\n            scenario.matrix[0][1] = 1;\n            var parsed = JSON.parse(ScenarioManager.save(scenario));\n            parsed.matrix[3][7].should.equal(1);\n            parsed.matrix[0][1].should.equal(1);\n            parsed.matrix[0][0].should.equal(0);\n        });\n    });\n\n    describe('load', function() {\n        it('should deserialize JSON string back to scenario', function() {\n            var original = makeEmptyScenario();\n            original.matrix[5][5] = 1;\n            var json = ScenarioManager.save(original);\n            var loaded = ScenarioManager.load(json);\n            loaded.width.should.equal(SIZE);\n            loaded.height.should.equal(SIZE);\n            loaded.startX.should.equal(0);\n            loaded.endY.should.equal(SIZE - 1);\n            loaded.matrix[5][5].should.equal(1);\n            loaded.matrix[0][0].should.equal(0);\n        });\n\n        it('should throw on invalid JSON', function() {\n            (function() {\n                ScenarioManager.load('not-valid-json');\n            }).should.throw();\n        });\n\n        it('should throw if required fields missing', function() {\n            (function() {\n                ScenarioManager.load('{\"width\":15}');\n            }).should.throw(/missing required field/i);\n        });\n\n        it('should throw if matrix dimensions mismatch', function() {\n            var scenario = makeEmptyScenario();\n            var obj = JSON.parse(ScenarioManager.save(scenario));\n            obj.matrix = [[0, 0], [0, 0]]; // wrong size\n            (function() {\n                ScenarioManager.load(JSON.stringify(obj));\n            }).should.throw(/matrix/i);\n        });\n    });\n\n    describe('saveObject / loadObject', function() {\n        it('saveObject should return plain object (not string)', function() {\n            var scenario = makeEmptyScenario();\n            var obj = ScenarioManager.saveObject(scenario);\n            obj.should.be.an.Object().and.not.be.a.String();\n            obj.width.should.equal(SIZE);\n        });\n\n        it('loadObject should accept plain object', function() {\n            var scenario = makeEmptyScenario();\n            scenario.matrix[2][9] = 1;\n            var obj = ScenarioManager.saveObject(scenario);\n            var loaded = ScenarioManager.loadObject(obj);\n            loaded.matrix[2][9].should.equal(1);\n        });\n    });\n\n    describe('presets', function() {\n        it('should list at least 5 preset names', function() {\n            var names = ScenarioManager.presetNames();\n            names.should.be.an.Array();\n            names.length.should.be.aboveOrEqual(5);\n        });\n\n        describe('empty preset', function() {\n            var scenario;\n            before(function() { scenario = ScenarioManager.loadPreset('empty'); });\n\n            it('should be 15x15', function() {\n                scenario.width.should.equal(SIZE);\n                scenario.height.should.equal(SIZE);\n            });\n\n            it('should have no walls', function() {\n                for (var y = 0; y < SIZE; y++) {\n                    for (var x = 0; x < SIZE; x++) {\n                        scenario.matrix[y][x].should.equal(0);\n                    }\n                }\n            });\n\n            it('should have valid start and end', function() {\n                scenario.startX.should.be.within(0, SIZE - 1);\n                scenario.startY.should.be.within(0, SIZE - 1);\n                scenario.endX.should.be.within(0, SIZE - 1);\n                scenario.endY.should.be.within(0, SIZE - 1);\n            });\n        });\n\n        describe('maze preset', function() {\n            var scenario;\n            before(function() { scenario = ScenarioManager.loadPreset('maze'); });\n\n            it('should be 15x15', function() {\n                scenario.width.should.equal(SIZE);\n                scenario.height.should.equal(SIZE);\n            });\n\n            it('should have walls (non-zero cells)', function() {\n                var wallCount = 0;\n                for (var y = 0; y < SIZE; y++) {\n                    for (var x = 0; x < SIZE; x++) {\n                        if (scenario.matrix[y][x] === 1) wallCount++;\n                    }\n                }\n                wallCount.should.be.above(10);\n            });\n        });\n\n        describe('spiral preset', function() {\n            var scenario;\n            before(function() { scenario = ScenarioManager.loadPreset('spiral'); });\n\n            it('should be 15x15 with walls', function() {\n                scenario.width.should.equal(SIZE);\n                scenario.height.should.equal(SIZE);\n                var wallCount = 0;\n                for (var y = 0; y < SIZE; y++) {\n                    for (var x = 0; x < SIZE; x++) {\n                        if (scenario.matrix[y][x] === 1) wallCount++;\n                    }\n                }\n                wallCount.should.be.above(5);\n            });\n        });\n\n        describe('bottleneck preset', function() {\n            var scenario;\n            before(function() { scenario = ScenarioManager.loadPreset('bottleneck'); });\n\n            it('should be 15x15', function() {\n                scenario.width.should.equal(SIZE);\n                scenario.height.should.equal(SIZE);\n            });\n\n            it('should have a narrow passage (many walls across middle)', function() {\n                var wallCountMiddleRow = 0;\n                var midY = Math.floor(SIZE / 2);\n                for (var x = 0; x < SIZE; x++) {\n                    if (scenario.matrix[midY][x] === 1) wallCountMiddleRow++;\n                }\n                // bottleneck: most of the middle row is walls with a gap\n                wallCountMiddleRow.should.be.above(SIZE / 2);\n            });\n        });\n\n        describe('random preset', function() {\n            var scenario;\n            before(function() { scenario = ScenarioManager.loadPreset('random'); });\n\n            it('should be 15x15', function() {\n                scenario.width.should.equal(SIZE);\n                scenario.height.should.equal(SIZE);\n            });\n\n            it('should have some walls', function() {\n                var wallCount = 0;\n                for (var y = 0; y < SIZE; y++) {\n                    for (var x = 0; x < SIZE; x++) {\n                        if (scenario.matrix[y][x] === 1) wallCount++;\n                    }\n                }\n                wallCount.should.be.above(0);\n            });\n\n            it('start and end cells should always be walkable', function() {\n                scenario.matrix[scenario.startY][scenario.startX].should.equal(0);\n                scenario.matrix[scenario.endY][scenario.endX].should.equal(0);\n            });\n        });\n\n        it('should throw on unknown preset name', function() {\n            (function() {\n                ScenarioManager.loadPreset('does-not-exist');\n            }).should.throw(/unknown preset/i);\n        });\n    });\n\n    describe('round-trip', function() {\n        it('each preset should survive save/load round-trip', function() {\n            ScenarioManager.presetNames().forEach(function(name) {\n                var original = ScenarioManager.loadPreset(name);\n                var json = ScenarioManager.save(original);\n                var loaded = ScenarioManager.load(json);\n                loaded.width.should.equal(original.width);\n                loaded.height.should.equal(original.height);\n                loaded.matrix[0][0].should.equal(original.matrix[0][0]);\n                loaded.matrix[SIZE - 1][SIZE - 1].should.equal(original.matrix[SIZE - 1][SIZE - 1]);\n            });\n        });\n    });\n\n});\n","numLines":245,"startLine":1,"totalLines":245}}}
