{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KcbqWo8cvt2K4jN3JVDVki","type":"tool_result","content":"1\t<!DOCTYPE HTML>\n2\t<html lang=\"en\">\n3\t  <head>\n4\t    <meta charset=\"UTF-8\">\n5\t    <title>PathFinding.js</title>\n6\t\n7\t    <link rel=\"stylesheet\" href=\"./css/style.css\" />\n8\t    <link rel=\"stylesheet\" href=\"./lib/themes/jquery.ui.all.css\" />\n9\t\n10\t    <script type=\"text/javascript\" src=\"./lib/raphael-min.js\"></script>\n11\t    <script type=\"text/javascript\" src=\"./lib/es5-shim.min.js\"></script>\n12\t    <script type=\"text/javascript\" src=\"./lib/jquery-1.7.2.min.js\"></script>\n13\t    <script type=\"text/javascript\" src=\"./lib/state-machine.min.js\"></script>\n14\t    <script type=\"text/javascript\" src=\"./lib/async.min.js\"></script>\n15\t\n16\t    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.core.min.js\"></script>\n17\t    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.widget.min.js\"></script>\n18\t    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.mouse.min.js\"></script>\n19\t    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.draggable.min.js\"></script>\n20\t    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.accordion.min.js\"></script>\n21\t    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.slider.min.js\"></script>\n22\t\n23\t    <script type=\"text/javascript\" src=\"./lib/pathfinding-browser.min.js\"></script>\n24\t\n25\t    <script type=\"text/javascript\" src=\"./js/view.js\"></script>\n26\t    <script type=\"text/javascript\" src=\"./js/controller.js\"></script>\n27\t    <script type=\"text/javascript\" src=\"./js/panel.js\"></script>\n28\t    <script type=\"text/javascript\" src=\"./js/scorer.js\"></script>\n29\t    <script type=\"text/javascript\" src=\"./js/scenario.js\"></script>\n30\t    <script type=\"text/javascript\" src=\"./js/main.js\"></script>\n31\t  </head>\n32\t  <body>\n33\t    <div id=\"draw_area\"></div>\n34\t\n35\t    <div id=\"instructions_panel\" class=\"panel\">\n36\t      <header>\n37\t        <h2 class=\"header_title\">Instructions</h2>\n38\t        <span id=\"hide_instructions\">hide</span>\n39\t      </header>\n40\t      Click within the <span class=\"white\">white</span> grid and drag your mouse to draw obstacles. <br>\n41\t      Drag the <span class=\"green\">green</span> node to set the start position. <br>\n42\t      Drag the <span class=\"red\">red</span> node to set the end position. <br>\n43\t      Choose an algorithm from the right-hand panel. <br>\n44\t      Click Start Search in the lower-right corner to start the animation.\n45\t    </div>\n46\t\n47\t    <div id=\"algorithm_panel\" class=\"panel right_panel\">\n48\t      <header><h2 class=\"header_title\">Select Algorithm</h2></header>\n49\t\n50\t      <div class=\"accordion\">\n51\t        <h3 id=\"astar_header\"><a href=\"#\">A*</a></h3>\n52\t        <div id=\"astar_section\" class=\"finder_section\">\n53\t          <header class=\"option_header\">\n54\t            <h3>Heuristic</h3>\n55\t          </header>\n56\t          <div id=\"astar_heuristic\" class=\"sub_options\">\n57\t            <input type=\"radio\" name=\"astar_heuristic\" value=\"manhattan\" checked />\n58\t            <label class=\"option_label\">Manhattan</label> <br>\n59\t            <input type=\"radio\" name=\"astar_heuristic\" value=\"euclidean\"/>\n60\t            <label class=\"option_label\">Euclidean</label> <br>\n61\t            <input type=\"radio\" name=\"astar_heuristic\" value=\"octile\"/>\n62\t            <label class=\"option_label\">Octile</label> <br>\n63\t            <input type=\"radio\" name=\"astar_heuristic\" value=\"chebyshev\"/>\n64\t            <label class=\"option_label\">Chebyshev</label> <br>\n65\t          </div>\n66\t\n67\t          <header class=\"option_header\">\n68\t            <h3>Options</h3>\n69\t          </header>\n70\t          <div class=\"optional sub_options\">\n71\t            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n72\t            <label class=\"option_label\">Allow Diagonal</label> <br>\n73\t            <input type=\"checkbox\" class=\"bi-directional\">\n74\t            <label class=\"option_label\">Bi-directional</label> <br>\n75\t            <input type=\"checkbox\" class=\"dont_cross_corners\">\n76\t            <label class=\"option_label\">Don't Cross Corners</label> <br>\n77\t            <input class=\"spinner\" name=\"astar_weight\" value=\"1\">\n78\t            <label class=\"option_label\">Weight</label> <br>\n79\t          </div>\n80\t        </div>\n81\t\n82\t        <h3 id=\"ida_header\"><a href=\"#\">IDA*</a></h3>\n83\t        <div id=\"ida_section\" class=\"finder_section\">\n84\t          <header class=\"option_header\">\n85\t            <h3>Heuristic</h3>\n86\t          </header>\n87\t          <div id=\"ida_heuristic\" class=\"sub_options\">\n88\t            <input type=\"radio\" name=\"ida_heuristic\" value=\"manhattan\" checked />\n89\t            <label class=\"option_label\">Manhattan</label> <br>\n90\t            <input type=\"radio\" name=\"ida_heuristic\" value=\"euclidean\"/>\n91\t            <label class=\"option_label\">Euclidean</label> <br>\n92\t            <input type=\"radio\" name=\"ida_heuristic\" value=\"octile\"/>\n93\t            <label class=\"option_label\">Octile</label> <br>\n94\t            <input type=\"radio\" name=\"ida_heuristic\" value=\"chebyshev\"/>\n95\t            <label class=\"option_label\">Chebyshev</label> <br>\n96\t          </div>\n97\t          <header class=\"option_header\">\n98\t            <h3>Options</h3>\n99\t          </header>\n100\t          <div class=\"optional sub_options\">\n101\t            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n102\t            <label class=\"option_label\">Allow Diagonal</label> <br>\n103\t            <input type=\"checkbox\" class=\"dont_cross_corners\">\n104\t            <label class=\"option_label\">Don't Cross Corners</label> <br>\n105\t            <input class=\"spinner\" name=\"astar_weight\" value=\"1\">\n106\t            <label class=\"option_label\">Weight</label> <br>\n107\t            <input class=\"spinner\" name=\"time_limit\" value=\"10\">\n108\t            <label class=\"option_label\">Seconds limit</label> <br>\n109\t            <input type=\"checkbox\" class=\"track_recursion\" checked />\n110\t            <label class=\"option_label\">Visualize recursion</label> <br>\n111\t          </div>\n112\t        </div>\n113\t\n114\t        <h3 id=\"breadthfirst_header\"><a href=\"#\">Breadth-First-Search</a></h3>\n115\t        <div id=\"breadthfirst_section\" class=\"finder_section\">\n116\t          <header class=\"option_header\">\n117\t            <h3>Options</h3>\n118\t          </header>\n119\t          <div class=\"optional sub_options\">\n120\t            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n121\t            <label class=\"option_label\">Allow Diagonal</label> <br>\n122\t            <input type=\"checkbox\" class=\"bi-directional\">\n123\t            <label class=\"option_label\">Bi-directional</label> <br>\n124\t            <input type=\"checkbox\" class=\"dont_cross_corners\">\n125\t            <label class=\"option_label\">Don't Cross Corners</label> <br>\n126\t          </div>\n127\t        </div>\n128\t\n129\t        <h3 id=\"bestfirst_header\"><a href=\"#\">Best-First-Search</a></h3>\n130\t        <div id=\"bestfirst_section\" class=\"finder_section\">\n131\t          <header class=\"option_header\">\n132\t            <h3>Heuristic</h3>\n133\t          </header>\n134\t          <div id=\"bestfirst_heuristic\" class=\"sub_options\">\n135\t            <input type=\"radio\" name=\"bestfirst_heuristic\" value=\"manhattan\" checked />\n136\t            <label class=\"option_label\">Manhattan</label> <br>\n137\t            <input type=\"radio\" name=\"bestfirst_heuristic\" value=\"euclidean\"/>\n138\t            <label class=\"option_label\">Euclidean</label> <br>\n139\t            <input type=\"radio\" name=\"bestfirst_heuristic\" value=\"octile\"/>\n140\t            <label class=\"option_label\">Octile</label> <br>\n141\t            <input type=\"radio\" name=\"bestfirst_heuristic\" value=\"chebyshev\"/>\n142\t            <label class=\"option_label\">Chebyshev</label> <br>\n143\t          </div>\n144\t\n145\t          <header class=\"option_header\">\n146\t            <h3>Options</h3>\n147\t          </header>\n148\t          <div class=\"optional sub_options\">\n149\t            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n150\t            <label class=\"option_label\">Allow Diagonal</label> <br>\n151\t            <input type=\"checkbox\" class=\"bi-directional\">\n152\t            <label class=\"option_label\">Bi-directional</label> <br>\n153\t            <input type=\"checkbox\" class=\"dont_cross_corners\">\n154\t            <label class=\"option_label\">Don't Cross Corners</label> <br>\n155\t          </div>\n156\t        </div>\n157\t\n158\t        <h3 id=\"dijkstra_header\"><a href=\"#\">Dijkstra</a></h3>\n159\t        <div id=\"dijkstra_section\" class=\"finder_section\">\n160\t          <header class=\"option_header\">\n161\t            <h3>Options</h3>\n162\t          </header>\n163\t          <div class=\"optional sub_options\">\n164\t            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n165\t            <label class=\"option_label\">Allow Diagonal</label> <br>\n166\t            <input type=\"checkbox\" class=\"bi-directional\">\n167\t            <label class=\"option_label\">Bi-directional</label> <br>\n168\t            <input type=\"checkbox\" class=\"dont_cross_corners\">\n169\t            <label class=\"option_label\">Don't Cross Corners</label> <br>\n170\t          </div>\n171\t        </div>\n172\t\n173\t        <h3 id=\"jump_point_header\"><a href=\"#\">Jump Point Search</a></h3>\n174\t        <div id=\"jump_point_section\" class=\"finder_section\">\n175\t          <header class=\"option_header\">\n176\t            <h3>Heuristic</h3>\n177\t          </header>\n178\t          <div id=\"jump_point_heuristic\" class=\"sub_options\">\n179\t            <input type=\"radio\" name=\"jump_point_heuristic\" value=\"manhattan\" checked />\n180\t            <label class=\"option_label\">Manhattan</label> <br>\n181\t            <input type=\"radio\" name=\"jump_point_heuristic\" value=\"euclidean\"/>\n182\t            <label class=\"option_label\">Euclidean</label> <br>\n183\t            <input type=\"radio\" name=\"jump_point_heuristic\" value=\"octile\"/>\n184\t            <label class=\"option_label\">Octile</label> <br>\n185\t            <input type=\"radio\" name=\"jump_point_heuristic\" value=\"chebyshev\"/>\n186\t            <label class=\"option_label\">Chebyshev</label> <br>\n187\t          </div>\n188\t          <header class=\"option_header\">\n189\t            <h3>Options</h3>\n190\t          </header>\n191\t          <div class=\"optional sub_options\">\n192\t            <input type=\"checkbox\" class=\"track_recursion\" checked>\n193\t            <label class=\"option_label\">Visualize recursion</label> <br>\n194\t          </div>\n195\t        </div>\n196\t\n197\t\t<h3 id=\"orth_jump_point_header\"><a href=\"#\">Orthogonal Jump Point Search</a></h3>\n198\t        <div id=\"orth_jump_point_section\" class=\"finder_section\">\n199\t          <header class=\"option_header\">\n200\t            <h3>Heuristic</h3>\n201\t          </header>\n202\t          <div id=\"orth_jump_point_heuristic\" class=\"sub_options\">\n203\t            <input type=\"radio\" name=\"orth_jump_point_heuristic\" value=\"manhattan\" checked />\n204\t            <label class=\"option_label\">Manhattan</label> <br>\n205\t            <input type=\"radio\" name=\"orth_jump_point_heuristic\" value=\"euclidean\"/>\n206\t            <label class=\"option_label\">Euclidean</label> <br>\n207\t            <input type=\"radio\" name=\"orth_jump_point_heuristic\" value=\"octile\"/>\n208\t            <label class=\"option_label\">Octile</label> <br>\n209\t            <input type=\"radio\" name=\"orth_jump_point_heuristic\" value=\"chebyshev\"/>\n210\t            <label class=\"option_label\">Chebyshev</label> <br>\n211\t          </div>\n212\t          <header class=\"option_header\">\n213\t            <h3>Options</h3>\n214\t          </header>\n215\t          <div class=\"optional sub_options\">\n216\t            <input type=\"checkbox\" class=\"track_recursion\" checked>\n217\t            <label class=\"option_label\">Visualize recursion</label> <br>\n218\t          </div>\n219\t        </div>\n220\t\n221\t      </div><!-- .accordion -->\n222\t    </div><!-- #algorithm_panel -->\n223\t\n224\t    <div id=\"play_panel\" class=\"panel right_panel\">\n225\t      <button id=\"button1\" class=\"control_button\">Start Search</button>\n226\t      <button id=\"button2\" class=\"control_button\">Pause Search</button>\n227\t      <button id=\"button3\" class=\"control_button\">Clear Walls</button>\n228\t    </div>\n229\t\n230\t    <div id=\"stats\"></div>\n231\t\n232\t    <!-- Score card: shown after each run -->\n233\t    <div id=\"score_panel\" class=\"panel score-panel\" style=\"display:none;\">\n234\t      <div class=\"score-panel-header\">\n235\t        <span class=\"header_title\">Run Results</span>\n236\t        <button id=\"save_run\" class=\"score-action-btn\">Save Run</button>\n237\t        <button id=\"compare_runs\" class=\"score-action-btn\">Compare</button>\n238\t      </div>\n239\t    </div>\n240\t\n241\t    <!-- Comparison drawer: side-by-side saved runs -->\n242\t    <div id=\"comparison_drawer\" class=\"panel comparison-drawer\" style=\"display:none;\"></div>\n243\t\n244\t    <!-- Scenario panel: preset maps, save/load JSON, grid size, speed -->\n245\t    <div id=\"scenario_panel_ui\" class=\"panel right_panel\" style=\"top:auto;bottom:20px;\">\n246\t      <header><h2 class=\"header_title\">Scenarios</h2></header>\n247\t      <div style=\"padding:8px 10px;\">\n248\t        <div style=\"margin-bottom:8px;\">\n249\t          <label style=\"font-size:11px;display:block;margin-bottom:3px;\">Grid Size (cols × rows)</label>\n250\t          <div style=\"display:flex;align-items:center;gap:4px;margin-bottom:4px;\">\n251\t            <input type=\"number\" id=\"grid_cols\" value=\"15\" min=\"5\" max=\"100\" style=\"width:52px;text-align:center;padding:2px 4px;font-size:11px;\">\n252\t            <span style=\"font-size:11px;\">×</span>\n253\t            <input type=\"number\" id=\"grid_rows\" value=\"15\" min=\"5\" max=\"100\" style=\"width:52px;text-align:center;padding:2px 4px;font-size:11px;\">\n254\t            <button id=\"btn_apply_grid_size\" class=\"control_button\" style=\"flex:1;padding:2px 6px;font-size:11px;\">Apply</button>\n255\t          </div>\n256\t        </div>\n257\t        <div style=\"margin-bottom:8px;\">\n258\t          <label style=\"font-size:11px;display:block;margin-bottom:3px;\">Animation Speed: <span id=\"speed_val\">5</span></label>\n259\t          <input type=\"range\" id=\"speed_slider\" min=\"1\" max=\"10\" value=\"5\" style=\"width:100%;\">\n260\t        </div>\n261\t        <div style=\"margin-bottom:8px;\">\n262\t          <label style=\"font-size:11px;display:block;margin-bottom:3px;\">Preset Maps</label>\n263\t          <select id=\"scenario_preset_select\" style=\"width:100%;margin-bottom:4px;\">\n264\t            <option value=\"\">— choose preset —</option>\n265\t          </select>\n266\t          <button id=\"btn_scenario_load_preset\" class=\"control_button\" style=\"width:100%;padding:4px 8px;font-size:11px;\">Load Preset</button>\n267\t        </div>\n268\t        <div>\n269\t          <label style=\"font-size:11px;display:block;margin-bottom:3px;\">Scenario File</label>\n270\t          <button id=\"btn_scenario_save\" class=\"control_button\" style=\"width:100%;padding:4px 8px;font-size:11px;margin-bottom:3px;\">Save Scenario</button>\n271\t          <button id=\"btn_scenario_load\" class=\"control_button\" style=\"width:100%;padding:4px 8px;font-size:11px;\">Load Scenario…</button>\n272\t          <input type=\"file\" id=\"scenario_file_input\" accept=\".json,application/json\" style=\"display:none;\">\n273\t        </div>\n274\t      </div>\n275\t    </div>\n276\t\n277\t    <footer>\n278\t      Project Hosted on <a href=\"http://github.com/qiao/PathFinding.js\">Github</a>\n279\t    </footer>\n280\t\n281\t  </body>\n282\t</html>\n283\t"}]},"parent_tool_use_id":null,"session_id":"cd89119d-6b24-425c-8aae-6006f88d9fc0","uuid":"633883ae-7b11-4c68-a0ce-6cc02a142a6b","timestamp":"2026-04-16T15:38:57.177Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/visual/index.html","content":"<!DOCTYPE HTML>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>PathFinding.js</title>\n\n    <link rel=\"stylesheet\" href=\"./css/style.css\" />\n    <link rel=\"stylesheet\" href=\"./lib/themes/jquery.ui.all.css\" />\n\n    <script type=\"text/javascript\" src=\"./lib/raphael-min.js\"></script>\n    <script type=\"text/javascript\" src=\"./lib/es5-shim.min.js\"></script>\n    <script type=\"text/javascript\" src=\"./lib/jquery-1.7.2.min.js\"></script>\n    <script type=\"text/javascript\" src=\"./lib/state-machine.min.js\"></script>\n    <script type=\"text/javascript\" src=\"./lib/async.min.js\"></script>\n\n    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.core.min.js\"></script>\n    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.widget.min.js\"></script>\n    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.mouse.min.js\"></script>\n    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.draggable.min.js\"></script>\n    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.accordion.min.js\"></script>\n    <script type=\"text/javascript\" src=\"./lib/ui/jquery.ui.slider.min.js\"></script>\n\n    <script type=\"text/javascript\" src=\"./lib/pathfinding-browser.min.js\"></script>\n\n    <script type=\"text/javascript\" src=\"./js/view.js\"></script>\n    <script type=\"text/javascript\" src=\"./js/controller.js\"></script>\n    <script type=\"text/javascript\" src=\"./js/panel.js\"></script>\n    <script type=\"text/javascript\" src=\"./js/scorer.js\"></script>\n    <script type=\"text/javascript\" src=\"./js/scenario.js\"></script>\n    <script type=\"text/javascript\" src=\"./js/main.js\"></script>\n  </head>\n  <body>\n    <div id=\"draw_area\"></div>\n\n    <div id=\"instructions_panel\" class=\"panel\">\n      <header>\n        <h2 class=\"header_title\">Instructions</h2>\n        <span id=\"hide_instructions\">hide</span>\n      </header>\n      Click within the <span class=\"white\">white</span> grid and drag your mouse to draw obstacles. <br>\n      Drag the <span class=\"green\">green</span> node to set the start position. <br>\n      Drag the <span class=\"red\">red</span> node to set the end position. <br>\n      Choose an algorithm from the right-hand panel. <br>\n      Click Start Search in the lower-right corner to start the animation.\n    </div>\n\n    <div id=\"algorithm_panel\" class=\"panel right_panel\">\n      <header><h2 class=\"header_title\">Select Algorithm</h2></header>\n\n      <div class=\"accordion\">\n        <h3 id=\"astar_header\"><a href=\"#\">A*</a></h3>\n        <div id=\"astar_section\" class=\"finder_section\">\n          <header class=\"option_header\">\n            <h3>Heuristic</h3>\n          </header>\n          <div id=\"astar_heuristic\" class=\"sub_options\">\n            <input type=\"radio\" name=\"astar_heuristic\" value=\"manhattan\" checked />\n            <label class=\"option_label\">Manhattan</label> <br>\n            <input type=\"radio\" name=\"astar_heuristic\" value=\"euclidean\"/>\n            <label class=\"option_label\">Euclidean</label> <br>\n            <input type=\"radio\" name=\"astar_heuristic\" value=\"octile\"/>\n            <label class=\"option_label\">Octile</label> <br>\n            <input type=\"radio\" name=\"astar_heuristic\" value=\"chebyshev\"/>\n            <label class=\"option_label\">Chebyshev</label> <br>\n          </div>\n\n          <header class=\"option_header\">\n            <h3>Options</h3>\n          </header>\n          <div class=\"optional sub_options\">\n            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n            <label class=\"option_label\">Allow Diagonal</label> <br>\n            <input type=\"checkbox\" class=\"bi-directional\">\n            <label class=\"option_label\">Bi-directional</label> <br>\n            <input type=\"checkbox\" class=\"dont_cross_corners\">\n            <label class=\"option_label\">Don't Cross Corners</label> <br>\n            <input class=\"spinner\" name=\"astar_weight\" value=\"1\">\n            <label class=\"option_label\">Weight</label> <br>\n          </div>\n        </div>\n\n        <h3 id=\"ida_header\"><a href=\"#\">IDA*</a></h3>\n        <div id=\"ida_section\" class=\"finder_section\">\n          <header class=\"option_header\">\n            <h3>Heuristic</h3>\n          </header>\n          <div id=\"ida_heuristic\" class=\"sub_options\">\n            <input type=\"radio\" name=\"ida_heuristic\" value=\"manhattan\" checked />\n            <label class=\"option_label\">Manhattan</label> <br>\n            <input type=\"radio\" name=\"ida_heuristic\" value=\"euclidean\"/>\n            <label class=\"option_label\">Euclidean</label> <br>\n            <input type=\"radio\" name=\"ida_heuristic\" value=\"octile\"/>\n            <label class=\"option_label\">Octile</label> <br>\n            <input type=\"radio\" name=\"ida_heuristic\" value=\"chebyshev\"/>\n            <label class=\"option_label\">Chebyshev</label> <br>\n          </div>\n          <header class=\"option_header\">\n            <h3>Options</h3>\n          </header>\n          <div class=\"optional sub_options\">\n            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n            <label class=\"option_label\">Allow Diagonal</label> <br>\n            <input type=\"checkbox\" class=\"dont_cross_corners\">\n            <label class=\"option_label\">Don't Cross Corners</label> <br>\n            <input class=\"spinner\" name=\"astar_weight\" value=\"1\">\n            <label class=\"option_label\">Weight</label> <br>\n            <input class=\"spinner\" name=\"time_limit\" value=\"10\">\n            <label class=\"option_label\">Seconds limit</label> <br>\n            <input type=\"checkbox\" class=\"track_recursion\" checked />\n            <label class=\"option_label\">Visualize recursion</label> <br>\n          </div>\n        </div>\n\n        <h3 id=\"breadthfirst_header\"><a href=\"#\">Breadth-First-Search</a></h3>\n        <div id=\"breadthfirst_section\" class=\"finder_section\">\n          <header class=\"option_header\">\n            <h3>Options</h3>\n          </header>\n          <div class=\"optional sub_options\">\n            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n            <label class=\"option_label\">Allow Diagonal</label> <br>\n            <input type=\"checkbox\" class=\"bi-directional\">\n            <label class=\"option_label\">Bi-directional</label> <br>\n            <input type=\"checkbox\" class=\"dont_cross_corners\">\n            <label class=\"option_label\">Don't Cross Corners</label> <br>\n          </div>\n        </div>\n\n        <h3 id=\"bestfirst_header\"><a href=\"#\">Best-First-Search</a></h3>\n        <div id=\"bestfirst_section\" class=\"finder_section\">\n          <header class=\"option_header\">\n            <h3>Heuristic</h3>\n          </header>\n          <div id=\"bestfirst_heuristic\" class=\"sub_options\">\n            <input type=\"radio\" name=\"bestfirst_heuristic\" value=\"manhattan\" checked />\n            <label class=\"option_label\">Manhattan</label> <br>\n            <input type=\"radio\" name=\"bestfirst_heuristic\" value=\"euclidean\"/>\n            <label class=\"option_label\">Euclidean</label> <br>\n            <input type=\"radio\" name=\"bestfirst_heuristic\" value=\"octile\"/>\n            <label class=\"option_label\">Octile</label> <br>\n            <input type=\"radio\" name=\"bestfirst_heuristic\" value=\"chebyshev\"/>\n            <label class=\"option_label\">Chebyshev</label> <br>\n          </div>\n\n          <header class=\"option_header\">\n            <h3>Options</h3>\n          </header>\n          <div class=\"optional sub_options\">\n            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n            <label class=\"option_label\">Allow Diagonal</label> <br>\n            <input type=\"checkbox\" class=\"bi-directional\">\n            <label class=\"option_label\">Bi-directional</label> <br>\n            <input type=\"checkbox\" class=\"dont_cross_corners\">\n            <label class=\"option_label\">Don't Cross Corners</label> <br>\n          </div>\n        </div>\n\n        <h3 id=\"dijkstra_header\"><a href=\"#\">Dijkstra</a></h3>\n        <div id=\"dijkstra_section\" class=\"finder_section\">\n          <header class=\"option_header\">\n            <h3>Options</h3>\n          </header>\n          <div class=\"optional sub_options\">\n            <input type=\"checkbox\" class=\"allow_diagonal\" checked>\n            <label class=\"option_label\">Allow Diagonal</label> <br>\n            <input type=\"checkbox\" class=\"bi-directional\">\n            <label class=\"option_label\">Bi-directional</label> <br>\n            <input type=\"checkbox\" class=\"dont_cross_corners\">\n            <label class=\"option_label\">Don't Cross Corners</label> <br>\n          </div>\n        </div>\n\n        <h3 id=\"jump_point_header\"><a href=\"#\">Jump Point Search</a></h3>\n        <div id=\"jump_point_section\" class=\"finder_section\">\n          <header class=\"option_header\">\n            <h3>Heuristic</h3>\n          </header>\n          <div id=\"jump_point_heuristic\" class=\"sub_options\">\n            <input type=\"radio\" name=\"jump_point_heuristic\" value=\"manhattan\" checked />\n            <label class=\"option_label\">Manhattan</label> <br>\n            <input type=\"radio\" name=\"jump_point_heuristic\" value=\"euclidean\"/>\n            <label class=\"option_label\">Euclidean</label> <br>\n            <input type=\"radio\" name=\"jump_point_heuristic\" value=\"octile\"/>\n            <label class=\"option_label\">Octile</label> <br>\n            <input type=\"radio\" name=\"jump_point_heuristic\" value=\"chebyshev\"/>\n            <label class=\"option_label\">Chebyshev</label> <br>\n          </div>\n          <header class=\"option_header\">\n            <h3>Options</h3>\n          </header>\n          <div class=\"optional sub_options\">\n            <input type=\"checkbox\" class=\"track_recursion\" checked>\n            <label class=\"option_label\">Visualize recursion</label> <br>\n          </div>\n        </div>\n\n\t<h3 id=\"orth_jump_point_header\"><a href=\"#\">Orthogonal Jump Point Search</a></h3>\n        <div id=\"orth_jump_point_section\" class=\"finder_section\">\n          <header class=\"option_header\">\n            <h3>Heuristic</h3>\n          </header>\n          <div id=\"orth_jump_point_heuristic\" class=\"sub_options\">\n            <input type=\"radio\" name=\"orth_jump_point_heuristic\" value=\"manhattan\" checked />\n            <label class=\"option_label\">Manhattan</label> <br>\n            <input type=\"radio\" name=\"orth_jump_point_heuristic\" value=\"euclidean\"/>\n            <label class=\"option_label\">Euclidean</label> <br>\n            <input type=\"radio\" name=\"orth_jump_point_heuristic\" value=\"octile\"/>\n            <label class=\"option_label\">Octile</label> <br>\n            <input type=\"radio\" name=\"orth_jump_point_heuristic\" value=\"chebyshev\"/>\n            <label class=\"option_label\">Chebyshev</label> <br>\n          </div>\n          <header class=\"option_header\">\n            <h3>Options</h3>\n          </header>\n          <div class=\"optional sub_options\">\n            <input type=\"checkbox\" class=\"track_recursion\" checked>\n            <label class=\"option_label\">Visualize recursion</label> <br>\n          </div>\n        </div>\n\n      </div><!-- .accordion -->\n    </div><!-- #algorithm_panel -->\n\n    <div id=\"play_panel\" class=\"panel right_panel\">\n      <button id=\"button1\" class=\"control_button\">Start Search</button>\n      <button id=\"button2\" class=\"control_button\">Pause Search</button>\n      <button id=\"button3\" class=\"control_button\">Clear Walls</button>\n    </div>\n\n    <div id=\"stats\"></div>\n\n    <!-- Score card: shown after each run -->\n    <div id=\"score_panel\" class=\"panel score-panel\" style=\"display:none;\">\n      <div class=\"score-panel-header\">\n        <span class=\"header_title\">Run Results</span>\n        <button id=\"save_run\" class=\"score-action-btn\">Save Run</button>\n        <button id=\"compare_runs\" class=\"score-action-btn\">Compare</button>\n      </div>\n    </div>\n\n    <!-- Comparison drawer: side-by-side saved runs -->\n    <div id=\"comparison_drawer\" class=\"panel comparison-drawer\" style=\"display:none;\"></div>\n\n    <!-- Scenario panel: preset maps, save/load JSON, grid size, speed -->\n    <div id=\"scenario_panel_ui\" class=\"panel right_panel\" style=\"top:auto;bottom:20px;\">\n      <header><h2 class=\"header_title\">Scenarios</h2></header>\n      <div style=\"padding:8px 10px;\">\n        <div style=\"margin-bottom:8px;\">\n          <label style=\"font-size:11px;display:block;margin-bottom:3px;\">Grid Size (cols × rows)</label>\n          <div style=\"display:flex;align-items:center;gap:4px;margin-bottom:4px;\">\n            <input type=\"number\" id=\"grid_cols\" value=\"15\" min=\"5\" max=\"100\" style=\"width:52px;text-align:center;padding:2px 4px;font-size:11px;\">\n            <span style=\"font-size:11px;\">×</span>\n            <input type=\"number\" id=\"grid_rows\" value=\"15\" min=\"5\" max=\"100\" style=\"width:52px;text-align:center;padding:2px 4px;font-size:11px;\">\n            <button id=\"btn_apply_grid_size\" class=\"control_button\" style=\"flex:1;padding:2px 6px;font-size:11px;\">Apply</button>\n          </div>\n        </div>\n        <div style=\"margin-bottom:8px;\">\n          <label style=\"font-size:11px;display:block;margin-bottom:3px;\">Animation Speed: <span id=\"speed_val\">5</span></label>\n          <input type=\"range\" id=\"speed_slider\" min=\"1\" max=\"10\" value=\"5\" style=\"width:100%;\">\n        </div>\n        <div style=\"margin-bottom:8px;\">\n          <label style=\"font-size:11px;display:block;margin-bottom:3px;\">Preset Maps</label>\n          <select id=\"scenario_preset_select\" style=\"width:100%;margin-bottom:4px;\">\n            <option value=\"\">— choose preset —</option>\n          </select>\n          <button id=\"btn_scenario_load_preset\" class=\"control_button\" style=\"width:100%;padding:4px 8px;font-size:11px;\">Load Preset</button>\n        </div>\n        <div>\n          <label style=\"font-size:11px;display:block;margin-bottom:3px;\">Scenario File</label>\n          <button id=\"btn_scenario_save\" class=\"control_button\" style=\"width:100%;padding:4px 8px;font-size:11px;margin-bottom:3px;\">Save Scenario</button>\n          <button id=\"btn_scenario_load\" class=\"control_button\" style=\"width:100%;padding:4px 8px;font-size:11px;\">Load Scenario…</button>\n          <input type=\"file\" id=\"scenario_file_input\" accept=\".json,application/json\" style=\"display:none;\">\n        </div>\n      </div>\n    </div>\n\n    <footer>\n      Project Hosted on <a href=\"http://github.com/qiao/PathFinding.js\">Github</a>\n    </footer>\n\n  </body>\n</html>\n","numLines":283,"startLine":1,"totalLines":283}}}
