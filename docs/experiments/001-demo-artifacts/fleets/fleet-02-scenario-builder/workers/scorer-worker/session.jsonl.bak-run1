{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E2VrMRVMhkru3ixWbjYeN6","type":"tool_result","content":"1\t/**\n2\t * Scorer: browser-side scoring and comparison system.\n3\t * Captures metrics, renders score cards, and manages a comparison drawer.\n4\t * Uses localStorage for persistence across page loads.\n5\t */\n6\tvar Scorer = (function() {\n7\t    var STORAGE_KEY = 'pf_runs';\n8\t    var _idCounter  = 0;\n9\t\n10\t    // --- Storage helpers ---\n11\t\n12\t    function _loadFromStorage() {\n13\t        try {\n14\t            var raw = localStorage.getItem(STORAGE_KEY);\n15\t            return raw ? JSON.parse(raw) : [];\n16\t        } catch (e) {\n17\t            return [];\n18\t        }\n19\t    }\n20\t\n21\t    function _saveToStorage(runs) {\n22\t        try {\n23\t            localStorage.setItem(STORAGE_KEY, JSON.stringify(runs));\n24\t        } catch (e) {}\n25\t    }\n26\t\n27\t    // --- Core API ---\n28\t\n29\t    /**\n30\t     * Capture a run record from Controller state.\n31\t     * @param {string} algorithm     - finder name\n32\t     * @param {Object} grid          - PF.Grid instance (to extract walls)\n33\t     * @param {Array}  path          - [[x,y],...] result from finder\n34\t     * @param {number} timeMs        - elapsed time string or number\n35\t     * @param {number} nodesExplored - Controller.operationCount\n36\t     * @returns {Object} run record\n37\t     */\n38\t    function capture(algorithm, grid, path, timeMs, nodesExplored) {\n39\t        _idCounter += 1;\n40\t        var walls = [];\n41\t        if (grid && grid.nodes) {\n42\t            for (var y = 0; y < grid.height; y++) {\n43\t                for (var x = 0; x < grid.width; x++) {\n44\t                    if (!grid.nodes[y][x].walkable) {\n45\t                        walls.push([x, y]);\n46\t                    }\n47\t                }\n48\t            }\n49\t        }\n50\t        return {\n51\t            id:        Date.now() + '_' + _idCounter,\n52\t            algorithm: algorithm,\n53\t            timestamp: Date.now(),\n54\t            map: {\n55\t                width:  grid ? grid.width  : 0,\n56\t                height: grid ? grid.height : 0,\n57\t                walls:  walls\n58\t            },\n59\t            metrics: {\n60\t                nodesExplored: nodesExplored,\n61\t                pathLength:    path.length > 1 ? path.length - 1 : 0,\n62\t                timeMs:        parseFloat(timeMs)\n63\t            }\n64\t        };\n65\t    }\n66\t\n67\t    function save(run) {\n68\t        var runs = _loadFromStorage();\n69\t        runs.push(run);\n70\t        _saveToStorage(runs);\n71\t    }\n72\t\n73\t    function load() {\n74\t        return _loadFromStorage();\n75\t    }\n76\t\n77\t    function clear() {\n78\t        _saveToStorage([]);\n79\t    }\n80\t\n81\t    function compare() {\n82\t        return _loadFromStorage().map(function(run) {\n83\t            return {\n84\t                algorithm: run.algorithm,\n85\t                timestamp: run.timestamp,\n86\t                metrics:   run.metrics\n87\t            };\n88\t        });\n89\t    }\n90\t\n91\t    function scoreCard(run) {\n92\t        return {\n93\t            algorithm:     run.algorithm,\n94\t            timestamp:     run.timestamp,\n95\t            metrics:       run.metrics,\n96\t            formattedTime: parseFloat(run.metrics.timeMs).toFixed(4) + ' ms'\n97\t        };\n98\t    }\n99\t\n100\t    // --- UI rendering ---\n101\t\n102\t    function _formatDate(ts) {\n103\t        var d = new Date(ts);\n104\t        return d.toLocaleTimeString();\n105\t    }\n106\t\n107\t    function _renderCard(run) {\n108\t        var card = scoreCard(run);\n109\t        var $el = $('<div class=\"score-card\">');\n110\t        $el.append(\n111\t            '<div class=\"score-card-header\">' + card.algorithm + '</div>' +\n112\t            '<table class=\"score-card-table\">' +\n113\t              '<tr><td>Nodes explored</td><td class=\"score-val\">' + card.metrics.nodesExplored + '</td></tr>' +\n114\t              '<tr><td>Path length</td><td class=\"score-val\">' + card.metrics.pathLength + '</td></tr>' +\n115\t              '<tr><td>Time</td><td class=\"score-val\">' + card.formattedTime + '</td></tr>' +\n116\t              '<tr><td>Saved at</td><td class=\"score-val\">' + _formatDate(card.timestamp) + '</td></tr>' +\n117\t            '</table>'\n118\t        );\n119\t        return $el;\n120\t    }\n121\t\n122\t    /** Show the score card panel after a run completes. */\n123\t    function showScoreCard(run) {\n124\t        var $panel = $('#score_panel');\n125\t        // Remove only previous card content, keep header with buttons intact\n126\t        $panel.find('.score-card').remove();\n127\t        // If header got destroyed (first render), rebuild it\n128\t        if ($panel.find('.score-panel-header').length === 0) {\n129\t            $panel.prepend(\n130\t                '<div class=\"score-panel-header\">' +\n131\t                    '<span class=\"header_title\">Run Results</span>' +\n132\t                    '<button id=\"save_run\" class=\"score-action-btn\">Save Run</button>' +\n133\t                    '<button id=\"compare_runs\" class=\"score-action-btn\">Compare</button>' +\n134\t                '</div>'\n135\t            );\n136\t        }\n137\t        $panel.append(_renderCard(run)).show();\n138\t    }\n139\t\n140\t    /** Open the comparison drawer with all saved runs. */\n141\t    function showComparisonDrawer() {\n142\t        var runs   = load();\n143\t        var $drawer = $('#comparison_drawer');\n144\t        $drawer.empty();\n145\t\n146\t        var $header = $('<div class=\"drawer-header\">' +\n147\t            '<span>Saved Runs (' + runs.length + ')</span>' +\n148\t            '<button id=\"close_comparison\">&#x2715;</button>' +\n149\t            '<button id=\"clear_runs\">Clear All</button>' +\n150\t        '</div>');\n151\t        $drawer.append($header);\n152\t\n153\t        if (runs.length === 0) {\n154\t            $drawer.append('<p class=\"drawer-empty\">No saved runs yet.</p>');\n155\t        } else {\n156\t            var $cards = $('<div class=\"drawer-cards\">');\n157\t            runs.forEach(function(run) {\n158\t                $cards.append(_renderCard(run));\n159\t            });\n160\t            $drawer.append($cards);\n161\t        }\n162\t\n163\t        $drawer.show();\n164\t\n165\t        $('#close_comparison').off('click').on('click', hideComparisonDrawer);\n166\t        $('#clear_runs').off('click').on('click', function() {\n167\t            clear();\n168\t            showComparisonDrawer();\n169\t        });\n170\t    }\n171\t\n172\t    /** Close the comparison drawer. */\n173\t    function hideComparisonDrawer() {\n174\t        $('#comparison_drawer').hide();\n175\t    }\n176\t\n177\t    return {\n178\t        capture:              capture,\n179\t        save:                 save,\n180\t        load:                 load,\n181\t        clear:                clear,\n182\t        compare:              compare,\n183\t        scoreCard:            scoreCard,\n184\t        showScoreCard:        showScoreCard,\n185\t        showComparisonDrawer: showComparisonDrawer,\n186\t        hideComparisonDrawer: hideComparisonDrawer\n187\t    };\n188\t})();\n189\t"}]},"parent_tool_use_id":null,"session_id":"cd89119d-6b24-425c-8aae-6006f88d9fc0","uuid":"411d7b3f-54b8-4694-8171-dfb36cce0ecd","timestamp":"2026-04-16T15:38:31.297Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/visual/js/scorer.js","content":"/**\n * Scorer: browser-side scoring and comparison system.\n * Captures metrics, renders score cards, and manages a comparison drawer.\n * Uses localStorage for persistence across page loads.\n */\nvar Scorer = (function() {\n    var STORAGE_KEY = 'pf_runs';\n    var _idCounter  = 0;\n\n    // --- Storage helpers ---\n\n    function _loadFromStorage() {\n        try {\n            var raw = localStorage.getItem(STORAGE_KEY);\n            return raw ? JSON.parse(raw) : [];\n        } catch (e) {\n            return [];\n        }\n    }\n\n    function _saveToStorage(runs) {\n        try {\n            localStorage.setItem(STORAGE_KEY, JSON.stringify(runs));\n        } catch (e) {}\n    }\n\n    // --- Core API ---\n\n    /**\n     * Capture a run record from Controller state.\n     * @param {string} algorithm     - finder name\n     * @param {Object} grid          - PF.Grid instance (to extract walls)\n     * @param {Array}  path          - [[x,y],...] result from finder\n     * @param {number} timeMs        - elapsed time string or number\n     * @param {number} nodesExplored - Controller.operationCount\n     * @returns {Object} run record\n     */\n    function capture(algorithm, grid, path, timeMs, nodesExplored) {\n        _idCounter += 1;\n        var walls = [];\n        if (grid && grid.nodes) {\n            for (var y = 0; y < grid.height; y++) {\n                for (var x = 0; x < grid.width; x++) {\n                    if (!grid.nodes[y][x].walkable) {\n                        walls.push([x, y]);\n                    }\n                }\n            }\n        }\n        return {\n            id:        Date.now() + '_' + _idCounter,\n            algorithm: algorithm,\n            timestamp: Date.now(),\n            map: {\n                width:  grid ? grid.width  : 0,\n                height: grid ? grid.height : 0,\n                walls:  walls\n            },\n            metrics: {\n                nodesExplored: nodesExplored,\n                pathLength:    path.length > 1 ? path.length - 1 : 0,\n                timeMs:        parseFloat(timeMs)\n            }\n        };\n    }\n\n    function save(run) {\n        var runs = _loadFromStorage();\n        runs.push(run);\n        _saveToStorage(runs);\n    }\n\n    function load() {\n        return _loadFromStorage();\n    }\n\n    function clear() {\n        _saveToStorage([]);\n    }\n\n    function compare() {\n        return _loadFromStorage().map(function(run) {\n            return {\n                algorithm: run.algorithm,\n                timestamp: run.timestamp,\n                metrics:   run.metrics\n            };\n        });\n    }\n\n    function scoreCard(run) {\n        return {\n            algorithm:     run.algorithm,\n            timestamp:     run.timestamp,\n            metrics:       run.metrics,\n            formattedTime: parseFloat(run.metrics.timeMs).toFixed(4) + ' ms'\n        };\n    }\n\n    // --- UI rendering ---\n\n    function _formatDate(ts) {\n        var d = new Date(ts);\n        return d.toLocaleTimeString();\n    }\n\n    function _renderCard(run) {\n        var card = scoreCard(run);\n        var $el = $('<div class=\"score-card\">');\n        $el.append(\n            '<div class=\"score-card-header\">' + card.algorithm + '</div>' +\n            '<table class=\"score-card-table\">' +\n              '<tr><td>Nodes explored</td><td class=\"score-val\">' + card.metrics.nodesExplored + '</td></tr>' +\n              '<tr><td>Path length</td><td class=\"score-val\">' + card.metrics.pathLength + '</td></tr>' +\n              '<tr><td>Time</td><td class=\"score-val\">' + card.formattedTime + '</td></tr>' +\n              '<tr><td>Saved at</td><td class=\"score-val\">' + _formatDate(card.timestamp) + '</td></tr>' +\n            '</table>'\n        );\n        return $el;\n    }\n\n    /** Show the score card panel after a run completes. */\n    function showScoreCard(run) {\n        var $panel = $('#score_panel');\n        // Remove only previous card content, keep header with buttons intact\n        $panel.find('.score-card').remove();\n        // If header got destroyed (first render), rebuild it\n        if ($panel.find('.score-panel-header').length === 0) {\n            $panel.prepend(\n                '<div class=\"score-panel-header\">' +\n                    '<span class=\"header_title\">Run Results</span>' +\n                    '<button id=\"save_run\" class=\"score-action-btn\">Save Run</button>' +\n                    '<button id=\"compare_runs\" class=\"score-action-btn\">Compare</button>' +\n                '</div>'\n            );\n        }\n        $panel.append(_renderCard(run)).show();\n    }\n\n    /** Open the comparison drawer with all saved runs. */\n    function showComparisonDrawer() {\n        var runs   = load();\n        var $drawer = $('#comparison_drawer');\n        $drawer.empty();\n\n        var $header = $('<div class=\"drawer-header\">' +\n            '<span>Saved Runs (' + runs.length + ')</span>' +\n            '<button id=\"close_comparison\">&#x2715;</button>' +\n            '<button id=\"clear_runs\">Clear All</button>' +\n        '</div>');\n        $drawer.append($header);\n\n        if (runs.length === 0) {\n            $drawer.append('<p class=\"drawer-empty\">No saved runs yet.</p>');\n        } else {\n            var $cards = $('<div class=\"drawer-cards\">');\n            runs.forEach(function(run) {\n                $cards.append(_renderCard(run));\n            });\n            $drawer.append($cards);\n        }\n\n        $drawer.show();\n\n        $('#close_comparison').off('click').on('click', hideComparisonDrawer);\n        $('#clear_runs').off('click').on('click', function() {\n            clear();\n            showComparisonDrawer();\n        });\n    }\n\n    /** Close the comparison drawer. */\n    function hideComparisonDrawer() {\n        $('#comparison_drawer').hide();\n    }\n\n    return {\n        capture:              capture,\n        save:                 save,\n        load:                 load,\n        clear:                clear,\n        compare:              compare,\n        scoreCard:            scoreCard,\n        showScoreCard:        showScoreCard,\n        showComparisonDrawer: showComparisonDrawer,\n        hideComparisonDrawer: hideComparisonDrawer\n    };\n})();\n","numLines":189,"startLine":1,"totalLines":189}}}
