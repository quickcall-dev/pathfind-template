{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cz9zVLqy1aNfKAX2NmAvKq","type":"tool_result","content":"1\t'use strict';\n2\tvar should = require('should');\n3\tvar ScenarioControls = require('../src/scenario/ScenarioControls');\n4\t\n5\tdescribe('ScenarioControls', function() {\n6\t\n7\t    describe('ALGORITHMS', function() {\n8\t        it('should be a non-empty array', function() {\n9\t            ScenarioControls.ALGORITHMS.should.be.an.Array();\n10\t            ScenarioControls.ALGORITHMS.length.should.be.above(0);\n11\t        });\n12\t\n13\t        it('should include AStarFinder', function() {\n14\t            ScenarioControls.ALGORITHMS.map(function(a) { return a.id; })\n15\t                .should.containEql('AStarFinder');\n16\t        });\n17\t\n18\t        it('each entry should have id and label', function() {\n19\t            ScenarioControls.ALGORITHMS.forEach(function(algo) {\n20\t                algo.should.have.property('id');\n21\t                algo.should.have.property('label');\n22\t                algo.id.should.be.a.String();\n23\t                algo.label.should.be.a.String();\n24\t            });\n25\t        });\n26\t    });\n27\t\n28\t    describe('PRESETS', function() {\n29\t        it('should be an object with at least one preset', function() {\n30\t            ScenarioControls.PRESETS.should.be.an.Object();\n31\t            Object.keys(ScenarioControls.PRESETS).length.should.be.above(0);\n32\t        });\n33\t\n34\t        it('each preset should have cols, rows, walls, startX, startY, endX, endY', function() {\n35\t            Object.keys(ScenarioControls.PRESETS).forEach(function(name) {\n36\t                var p = ScenarioControls.PRESETS[name];\n37\t                p.should.have.property('cols');\n38\t                p.should.have.property('rows');\n39\t                p.should.have.property('walls');\n40\t                p.should.have.property('startX');\n41\t                p.should.have.property('startY');\n42\t                p.should.have.property('endX');\n43\t                p.should.have.property('endY');\n44\t                p.walls.should.be.an.Array();\n45\t            });\n46\t        });\n47\t    });\n48\t\n49\t    describe('DEFAULT_GRID_SIZE', function() {\n50\t        it('should default to 15x15', function() {\n51\t            ScenarioControls.DEFAULT_GRID_SIZE.cols.should.equal(15);\n52\t            ScenarioControls.DEFAULT_GRID_SIZE.rows.should.equal(15);\n53\t        });\n54\t    });\n55\t\n56\t    describe('validateGridSize', function() {\n57\t        it('should accept valid sizes', function() {\n58\t            ScenarioControls.validateGridSize(10, 10).should.be.true();\n59\t            ScenarioControls.validateGridSize(15, 15).should.be.true();\n60\t            ScenarioControls.validateGridSize(50, 50).should.be.true();\n61\t        });\n62\t\n63\t        it('should reject cols or rows below 5', function() {\n64\t            ScenarioControls.validateGridSize(4, 10).should.be.false();\n65\t            ScenarioControls.validateGridSize(10, 4).should.be.false();\n66\t            ScenarioControls.validateGridSize(0, 0).should.be.false();\n67\t        });\n68\t\n69\t        it('should reject cols or rows above 100', function() {\n70\t            ScenarioControls.validateGridSize(101, 15).should.be.false();\n71\t            ScenarioControls.validateGridSize(15, 101).should.be.false();\n72\t        });\n73\t\n74\t        it('should reject non-integer values', function() {\n75\t            ScenarioControls.validateGridSize(10.5, 10).should.be.false();\n76\t            ScenarioControls.validateGridSize(10, 'abc').should.be.false();\n77\t        });\n78\t    });\n79\t\n80\t    describe('getAnimationInterval', function() {\n81\t        it('should return a positive number in ms', function() {\n82\t            ScenarioControls.getAnimationInterval(1).should.be.above(0);\n83\t            ScenarioControls.getAnimationInterval(10).should.be.above(0);\n84\t        });\n85\t\n86\t        it('higher speed value should produce smaller interval', function() {\n87\t            var slow = ScenarioControls.getAnimationInterval(1);\n88\t            var fast = ScenarioControls.getAnimationInterval(10);\n89\t            fast.should.be.below(slow);\n90\t        });\n91\t\n92\t        it('should clamp out-of-range values', function() {\n93\t            var atOne  = ScenarioControls.getAnimationInterval(1);\n94\t            var atTen  = ScenarioControls.getAnimationInterval(10);\n95\t            ScenarioControls.getAnimationInterval(0).should.equal(atOne);\n96\t            ScenarioControls.getAnimationInterval(11).should.equal(atTen);\n97\t        });\n98\t    });\n99\t\n100\t    describe('getOperationsPerSecond', function() {\n101\t        it('should return a positive integer', function() {\n102\t            var ops = ScenarioControls.getOperationsPerSecond(5);\n103\t            ops.should.be.above(0);\n104\t            ops.should.equal(Math.round(ops));\n105\t        });\n106\t\n107\t        it('higher speed should produce more operations per second', function() {\n108\t            var slow = ScenarioControls.getOperationsPerSecond(1);\n109\t            var fast = ScenarioControls.getOperationsPerSecond(10);\n110\t            fast.should.be.above(slow);\n111\t        });\n112\t\n113\t        it('should be inverse of getAnimationInterval', function() {\n114\t            [1, 5, 10].forEach(function(speed) {\n115\t                var interval = ScenarioControls.getAnimationInterval(speed);\n116\t                var ops      = ScenarioControls.getOperationsPerSecond(speed);\n117\t                ops.should.equal(Math.round(1000 / interval));\n118\t            });\n119\t        });\n120\t\n121\t        it('should clamp out-of-range values', function() {\n122\t            ScenarioControls.getOperationsPerSecond(0).should.equal(\n123\t                ScenarioControls.getOperationsPerSecond(1));\n124\t            ScenarioControls.getOperationsPerSecond(11).should.equal(\n125\t                ScenarioControls.getOperationsPerSecond(10));\n126\t        });\n127\t    });\n128\t\n129\t    describe('serializeScenario', function() {\n130\t        it('should return a JSON string', function() {\n131\t            var json = ScenarioControls.serializeScenario({\n132\t                cols: 15,\n133\t                rows: 15,\n134\t                walls: [[2, 3], [4, 5]],\n135\t                startX: 0,\n136\t                startY: 0,\n137\t                endX: 14,\n138\t                endY: 14,\n139\t                algorithm: 'AStarFinder'\n140\t            });\n141\t            json.should.be.a.String();\n142\t            (function() { JSON.parse(json); }).should.not.throw();\n143\t        });\n144\t\n145\t        it('should include all required fields', function() {\n146\t            var json = ScenarioControls.serializeScenario({\n147\t                cols: 10,\n148\t                rows: 10,\n149\t                walls: [],\n150\t                startX: 1,\n151\t                startY: 1,\n152\t                endX: 8,\n153\t                endY: 8,\n154\t                algorithm: 'DijkstraFinder'\n155\t            });\n156\t            var obj = JSON.parse(json);\n157\t            obj.should.have.property('cols', 10);\n158\t            obj.should.have.property('rows', 10);\n159\t            obj.should.have.property('walls');\n160\t            obj.should.have.property('startX', 1);\n161\t            obj.should.have.property('startY', 1);\n162\t            obj.should.have.property('endX', 8);\n163\t            obj.should.have.property('endY', 8);\n164\t            obj.should.have.property('algorithm', 'DijkstraFinder');\n165\t        });\n166\t\n167\t        it('should serialize walls as array of [x,y] pairs', function() {\n168\t            var walls = [[1, 2], [3, 4]];\n169\t            var json = ScenarioControls.serializeScenario({\n170\t                cols: 10, rows: 10, walls: walls,\n171\t                startX: 0, startY: 0, endX: 9, endY: 9,\n172\t                algorithm: 'AStarFinder'\n173\t            });\n174\t            JSON.parse(json).walls.should.eql(walls);\n175\t        });\n176\t    });\n177\t\n178\t    describe('deserializeScenario', function() {\n179\t        it('should parse valid JSON string', function() {\n180\t            var input = JSON.stringify({\n181\t                cols: 10,\n182\t                rows: 10,\n183\t                walls: [[2, 2]],\n184\t                startX: 0,\n185\t                startY: 0,\n186\t                endX: 9,\n187\t                endY: 9,\n188\t                algorithm: 'BreadthFirstFinder'\n189\t            });\n190\t            var result = ScenarioControls.deserializeScenario(input);\n191\t            result.cols.should.equal(10);\n192\t            result.rows.should.equal(10);\n193\t            result.walls.should.eql([[2, 2]]);\n194\t            result.algorithm.should.equal('BreadthFirstFinder');\n195\t        });\n196\t\n197\t        it('should parse JSON object directly', function() {\n198\t            var input = { cols: 5, rows: 5, walls: [], startX: 0, startY: 0, endX: 4, endY: 4, algorithm: 'DijkstraFinder' };\n199\t            var result = ScenarioControls.deserializeScenario(input);\n200\t            result.cols.should.equal(5);\n201\t        });\n202\t\n203\t        it('should throw on invalid JSON string', function() {\n204\t            (function() {\n205\t                ScenarioControls.deserializeScenario('{bad json}');\n206\t            }).should.throw();\n207\t        });\n208\t\n209\t        it('should throw when required fields missing', function() {\n210\t            (function() {\n211\t                ScenarioControls.deserializeScenario(JSON.stringify({ cols: 10 }));\n212\t            }).should.throw();\n213\t        });\n214\t    });\n215\t\n216\t    describe('getPresetNames', function() {\n217\t        it('should return array of preset name strings', function() {\n218\t            var names = ScenarioControls.getPresetNames();\n219\t            names.should.be.an.Array();\n220\t            names.length.should.be.above(0);\n221\t            names.forEach(function(n) { n.should.be.a.String(); });\n222\t        });\n223\t    });\n224\t\n225\t    describe('loadPreset', function() {\n226\t        it('should return preset data for valid name', function() {\n227\t            var name = ScenarioControls.getPresetNames()[0];\n228\t            var preset = ScenarioControls.loadPreset(name);\n229\t            preset.should.have.property('cols');\n230\t            preset.should.have.property('rows');\n231\t            preset.should.have.property('walls');\n232\t        });\n233\t\n234\t        it('should throw for unknown preset name', function() {\n235\t            (function() {\n236\t                ScenarioControls.loadPreset('__nonexistent__');\n237\t            }).should.throw();\n238\t        });\n239\t    });\n240\t});\n241\t"}]},"parent_tool_use_id":null,"session_id":"af9f5486-7903-4156-b0c4-5cf18c74697f","uuid":"e5f4d286-354f-4c3f-a4aa-1c8c9c16cbbc","timestamp":"2026-04-16T15:38:32.958Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/docs/experiments/001-demo-artifacts/fleets/fleet-02-scenario-builder/workers/controls-worker/output/ControlsPanel.test.js","content":"'use strict';\nvar should = require('should');\nvar ScenarioControls = require('../src/scenario/ScenarioControls');\n\ndescribe('ScenarioControls', function() {\n\n    describe('ALGORITHMS', function() {\n        it('should be a non-empty array', function() {\n            ScenarioControls.ALGORITHMS.should.be.an.Array();\n            ScenarioControls.ALGORITHMS.length.should.be.above(0);\n        });\n\n        it('should include AStarFinder', function() {\n            ScenarioControls.ALGORITHMS.map(function(a) { return a.id; })\n                .should.containEql('AStarFinder');\n        });\n\n        it('each entry should have id and label', function() {\n            ScenarioControls.ALGORITHMS.forEach(function(algo) {\n                algo.should.have.property('id');\n                algo.should.have.property('label');\n                algo.id.should.be.a.String();\n                algo.label.should.be.a.String();\n            });\n        });\n    });\n\n    describe('PRESETS', function() {\n        it('should be an object with at least one preset', function() {\n            ScenarioControls.PRESETS.should.be.an.Object();\n            Object.keys(ScenarioControls.PRESETS).length.should.be.above(0);\n        });\n\n        it('each preset should have cols, rows, walls, startX, startY, endX, endY', function() {\n            Object.keys(ScenarioControls.PRESETS).forEach(function(name) {\n                var p = ScenarioControls.PRESETS[name];\n                p.should.have.property('cols');\n                p.should.have.property('rows');\n                p.should.have.property('walls');\n                p.should.have.property('startX');\n                p.should.have.property('startY');\n                p.should.have.property('endX');\n                p.should.have.property('endY');\n                p.walls.should.be.an.Array();\n            });\n        });\n    });\n\n    describe('DEFAULT_GRID_SIZE', function() {\n        it('should default to 15x15', function() {\n            ScenarioControls.DEFAULT_GRID_SIZE.cols.should.equal(15);\n            ScenarioControls.DEFAULT_GRID_SIZE.rows.should.equal(15);\n        });\n    });\n\n    describe('validateGridSize', function() {\n        it('should accept valid sizes', function() {\n            ScenarioControls.validateGridSize(10, 10).should.be.true();\n            ScenarioControls.validateGridSize(15, 15).should.be.true();\n            ScenarioControls.validateGridSize(50, 50).should.be.true();\n        });\n\n        it('should reject cols or rows below 5', function() {\n            ScenarioControls.validateGridSize(4, 10).should.be.false();\n            ScenarioControls.validateGridSize(10, 4).should.be.false();\n            ScenarioControls.validateGridSize(0, 0).should.be.false();\n        });\n\n        it('should reject cols or rows above 100', function() {\n            ScenarioControls.validateGridSize(101, 15).should.be.false();\n            ScenarioControls.validateGridSize(15, 101).should.be.false();\n        });\n\n        it('should reject non-integer values', function() {\n            ScenarioControls.validateGridSize(10.5, 10).should.be.false();\n            ScenarioControls.validateGridSize(10, 'abc').should.be.false();\n        });\n    });\n\n    describe('getAnimationInterval', function() {\n        it('should return a positive number in ms', function() {\n            ScenarioControls.getAnimationInterval(1).should.be.above(0);\n            ScenarioControls.getAnimationInterval(10).should.be.above(0);\n        });\n\n        it('higher speed value should produce smaller interval', function() {\n            var slow = ScenarioControls.getAnimationInterval(1);\n            var fast = ScenarioControls.getAnimationInterval(10);\n            fast.should.be.below(slow);\n        });\n\n        it('should clamp out-of-range values', function() {\n            var atOne  = ScenarioControls.getAnimationInterval(1);\n            var atTen  = ScenarioControls.getAnimationInterval(10);\n            ScenarioControls.getAnimationInterval(0).should.equal(atOne);\n            ScenarioControls.getAnimationInterval(11).should.equal(atTen);\n        });\n    });\n\n    describe('getOperationsPerSecond', function() {\n        it('should return a positive integer', function() {\n            var ops = ScenarioControls.getOperationsPerSecond(5);\n            ops.should.be.above(0);\n            ops.should.equal(Math.round(ops));\n        });\n\n        it('higher speed should produce more operations per second', function() {\n            var slow = ScenarioControls.getOperationsPerSecond(1);\n            var fast = ScenarioControls.getOperationsPerSecond(10);\n            fast.should.be.above(slow);\n        });\n\n        it('should be inverse of getAnimationInterval', function() {\n            [1, 5, 10].forEach(function(speed) {\n                var interval = ScenarioControls.getAnimationInterval(speed);\n                var ops      = ScenarioControls.getOperationsPerSecond(speed);\n                ops.should.equal(Math.round(1000 / interval));\n            });\n        });\n\n        it('should clamp out-of-range values', function() {\n            ScenarioControls.getOperationsPerSecond(0).should.equal(\n                ScenarioControls.getOperationsPerSecond(1));\n            ScenarioControls.getOperationsPerSecond(11).should.equal(\n                ScenarioControls.getOperationsPerSecond(10));\n        });\n    });\n\n    describe('serializeScenario', function() {\n        it('should return a JSON string', function() {\n            var json = ScenarioControls.serializeScenario({\n                cols: 15,\n                rows: 15,\n                walls: [[2, 3], [4, 5]],\n                startX: 0,\n                startY: 0,\n                endX: 14,\n                endY: 14,\n                algorithm: 'AStarFinder'\n            });\n            json.should.be.a.String();\n            (function() { JSON.parse(json); }).should.not.throw();\n        });\n\n        it('should include all required fields', function() {\n            var json = ScenarioControls.serializeScenario({\n                cols: 10,\n                rows: 10,\n                walls: [],\n                startX: 1,\n                startY: 1,\n                endX: 8,\n                endY: 8,\n                algorithm: 'DijkstraFinder'\n            });\n            var obj = JSON.parse(json);\n            obj.should.have.property('cols', 10);\n            obj.should.have.property('rows', 10);\n            obj.should.have.property('walls');\n            obj.should.have.property('startX', 1);\n            obj.should.have.property('startY', 1);\n            obj.should.have.property('endX', 8);\n            obj.should.have.property('endY', 8);\n            obj.should.have.property('algorithm', 'DijkstraFinder');\n        });\n\n        it('should serialize walls as array of [x,y] pairs', function() {\n            var walls = [[1, 2], [3, 4]];\n            var json = ScenarioControls.serializeScenario({\n                cols: 10, rows: 10, walls: walls,\n                startX: 0, startY: 0, endX: 9, endY: 9,\n                algorithm: 'AStarFinder'\n            });\n            JSON.parse(json).walls.should.eql(walls);\n        });\n    });\n\n    describe('deserializeScenario', function() {\n        it('should parse valid JSON string', function() {\n            var input = JSON.stringify({\n                cols: 10,\n                rows: 10,\n                walls: [[2, 2]],\n                startX: 0,\n                startY: 0,\n                endX: 9,\n                endY: 9,\n                algorithm: 'BreadthFirstFinder'\n            });\n            var result = ScenarioControls.deserializeScenario(input);\n            result.cols.should.equal(10);\n            result.rows.should.equal(10);\n            result.walls.should.eql([[2, 2]]);\n            result.algorithm.should.equal('BreadthFirstFinder');\n        });\n\n        it('should parse JSON object directly', function() {\n            var input = { cols: 5, rows: 5, walls: [], startX: 0, startY: 0, endX: 4, endY: 4, algorithm: 'DijkstraFinder' };\n            var result = ScenarioControls.deserializeScenario(input);\n            result.cols.should.equal(5);\n        });\n\n        it('should throw on invalid JSON string', function() {\n            (function() {\n                ScenarioControls.deserializeScenario('{bad json}');\n            }).should.throw();\n        });\n\n        it('should throw when required fields missing', function() {\n            (function() {\n                ScenarioControls.deserializeScenario(JSON.stringify({ cols: 10 }));\n            }).should.throw();\n        });\n    });\n\n    describe('getPresetNames', function() {\n        it('should return array of preset name strings', function() {\n            var names = ScenarioControls.getPresetNames();\n            names.should.be.an.Array();\n            names.length.should.be.above(0);\n            names.forEach(function(n) { n.should.be.a.String(); });\n        });\n    });\n\n    describe('loadPreset', function() {\n        it('should return preset data for valid name', function() {\n            var name = ScenarioControls.getPresetNames()[0];\n            var preset = ScenarioControls.loadPreset(name);\n            preset.should.have.property('cols');\n            preset.should.have.property('rows');\n            preset.should.have.property('walls');\n        });\n\n        it('should throw for unknown preset name', function() {\n            (function() {\n                ScenarioControls.loadPreset('__nonexistent__');\n            }).should.throw();\n        });\n    });\n});\n","numLines":241,"startLine":1,"totalLines":241}}}
