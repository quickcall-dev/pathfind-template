{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016pUVKN2oi7RDFjo7kpQXQu","type":"tool_result","content":"1\t'use strict';\n2\t\n3\tvar REQUIRED_FIELDS = ['cols', 'rows', 'walls', 'startX', 'startY', 'endX', 'endY', 'algorithm'];\n4\t\n5\tvar ScenarioControls = {\n6\t\n7\t    ALGORITHMS: [\n8\t        { id: 'AStarFinder',                          label: 'A*' },\n9\t        { id: 'BiAStarFinder',                        label: 'A* (Bi-directional)' },\n10\t        { id: 'IDAStarFinder',                        label: 'IDA*' },\n11\t        { id: 'BreadthFirstFinder',                   label: 'Breadth-First Search' },\n12\t        { id: 'BiBreadthFirstFinder',                 label: 'Breadth-First Search (Bi-directional)' },\n13\t        { id: 'BestFirstFinder',                      label: 'Best-First Search' },\n14\t        { id: 'BiBestFirstFinder',                    label: 'Best-First Search (Bi-directional)' },\n15\t        { id: 'DijkstraFinder',                       label: 'Dijkstra' },\n16\t        { id: 'BiDijkstraFinder',                     label: 'Dijkstra (Bi-directional)' },\n17\t        { id: 'JumpPointFinder',                      label: 'Jump Point Search' },\n18\t        { id: 'JPFAlwaysMoveDiagonally',              label: 'JPS (Always Diagonal)' },\n19\t        { id: 'JPFMoveDiagonallyIfAtMostOneObstacle', label: 'JPS (Diagonal ≤1 Obstacle)' },\n20\t        { id: 'JPFMoveDiagonallyIfNoObstacles',       label: 'JPS (No Diagonal Obstacles)' },\n21\t        { id: 'JPFNeverMoveDiagonally',               label: 'JPS (Never Diagonal)' }\n22\t    ],\n23\t\n24\t    PRESETS: {\n25\t        'Empty 15x15': {\n26\t            cols: 15, rows: 15,\n27\t            walls: [],\n28\t            startX: 1, startY: 7,\n29\t            endX: 13, endY: 7\n30\t        },\n31\t        'Maze 15x15': {\n32\t            cols: 15, rows: 15,\n33\t            walls: [\n34\t                [3,1],[3,2],[3,3],[3,4],[3,5],[3,6],[3,7],[3,8],[3,9],\n35\t                [7,5],[7,6],[7,7],[7,8],[7,9],[7,10],[7,11],[7,12],[7,13],\n36\t                [11,1],[11,2],[11,3],[11,4],[11,5],[11,6],[11,7],[11,8],[11,9]\n37\t            ],\n38\t            startX: 1, startY: 7,\n39\t            endX: 13, endY: 7\n40\t        },\n41\t        'Corridors 20x20': {\n42\t            cols: 20, rows: 20,\n43\t            walls: (function() {\n44\t                var w = [];\n45\t                // horizontal walls with gaps\n46\t                for (var x = 0; x < 20; x++) { if (x !== 5)  w.push([x, 5]); }\n47\t                for (var x = 0; x < 20; x++) { if (x !== 14) w.push([x, 10]); }\n48\t                for (var x = 0; x < 20; x++) { if (x !== 5)  w.push([x, 15]); }\n49\t                return w;\n50\t            }()),\n51\t            startX: 1, startY: 1,\n52\t            endX: 18, endY: 18\n53\t        },\n54\t        'Diagonal Barrier': {\n55\t            cols: 15, rows: 15,\n56\t            walls: (function() {\n57\t                var w = [];\n58\t                for (var i = 2; i <= 12; i++) { w.push([i, i]); }\n59\t                return w;\n60\t            }()),\n61\t            startX: 1, startY: 7,\n62\t            endX: 13, endY: 7\n63\t        }\n64\t    },\n65\t\n66\t    DEFAULT_GRID_SIZE: { cols: 15, rows: 15 },\n67\t\n68\t    /**\n69\t     * Validate grid dimensions.\n70\t     * cols and rows must be integers in [5, 100].\n71\t     */\n72\t    validateGridSize: function(cols, rows) {\n73\t        if (typeof cols !== 'number' || typeof rows !== 'number') return false;\n74\t        if (!isFinite(cols) || !isFinite(rows)) return false;\n75\t        if (cols !== Math.floor(cols) || rows !== Math.floor(rows)) return false;\n76\t        return cols >= 5 && cols <= 100 && rows >= 5 && rows <= 100;\n77\t    },\n78\t\n79\t    /**\n80\t     * Map speed slider value [1..10] to animation interval in ms.\n81\t     * Speed 1 → 500ms/op, speed 10 → 10ms/op.\n82\t     */\n83\t    getAnimationInterval: function(speed) {\n84\t        var s = Math.min(10, Math.max(1, speed));\n85\t        // exponential scale: speed 1 = 500ms, speed 10 = 10ms\n86\t        return Math.round(500 * Math.pow(10 / 500, (s - 1) / 9));\n87\t    },\n88\t\n89\t    /**\n90\t     * Map speed slider value [1..10] to operations per second.\n91\t     * Inverse of getAnimationInterval: ops/sec = 1000 / interval.\n92\t     */\n93\t    getOperationsPerSecond: function(speed) {\n94\t        return Math.round(1000 / this.getAnimationInterval(speed));\n95\t    },\n96\t\n97\t    /**\n98\t     * Serialize current scenario to JSON string.\n99\t     * opts: { cols, rows, walls, startX, startY, endX, endY, algorithm }\n100\t     */\n101\t    serializeScenario: function(opts) {\n102\t        return JSON.stringify({\n103\t            cols:      opts.cols,\n104\t            rows:      opts.rows,\n105\t            walls:     opts.walls,\n106\t            startX:    opts.startX,\n107\t            startY:    opts.startY,\n108\t            endX:      opts.endX,\n109\t            endY:      opts.endY,\n110\t            algorithm: opts.algorithm\n111\t        }, null, 2);\n112\t    },\n113\t\n114\t    /**\n115\t     * Deserialize scenario from JSON string or plain object.\n116\t     * Throws on parse error or missing required fields.\n117\t     */\n118\t    deserializeScenario: function(input) {\n119\t        var obj;\n120\t        if (typeof input === 'string') {\n121\t            obj = JSON.parse(input); // throws on bad JSON\n122\t        } else {\n123\t            obj = input;\n124\t        }\n125\t        for (var i = 0; i < REQUIRED_FIELDS.length; i++) {\n126\t            if (!Object.prototype.hasOwnProperty.call(obj, REQUIRED_FIELDS[i])) {\n127\t                throw new Error('Missing required field: ' + REQUIRED_FIELDS[i]);\n128\t            }\n129\t        }\n130\t        return obj;\n131\t    },\n132\t\n133\t    /**\n134\t     * Return sorted list of preset names.\n135\t     */\n136\t    getPresetNames: function() {\n137\t        return Object.keys(this.PRESETS).sort();\n138\t    },\n139\t\n140\t    /**\n141\t     * Return preset data by name, or throw if not found.\n142\t     */\n143\t    loadPreset: function(name) {\n144\t        if (!Object.prototype.hasOwnProperty.call(this.PRESETS, name)) {\n145\t            throw new Error('Unknown preset: ' + name);\n146\t        }\n147\t        return this.PRESETS[name];\n148\t    }\n149\t};\n150\t\n151\tmodule.exports = ScenarioControls;\n152\t"}]},"parent_tool_use_id":null,"session_id":"af9f5486-7903-4156-b0c4-5cf18c74697f","uuid":"95c3f87e-a562-4e74-870f-0706e7da42f8","timestamp":"2026-04-16T15:38:32.427Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/docs/experiments/001-demo-artifacts/fleets/fleet-02-scenario-builder/workers/controls-worker/output/ScenarioControls.js","content":"'use strict';\n\nvar REQUIRED_FIELDS = ['cols', 'rows', 'walls', 'startX', 'startY', 'endX', 'endY', 'algorithm'];\n\nvar ScenarioControls = {\n\n    ALGORITHMS: [\n        { id: 'AStarFinder',                          label: 'A*' },\n        { id: 'BiAStarFinder',                        label: 'A* (Bi-directional)' },\n        { id: 'IDAStarFinder',                        label: 'IDA*' },\n        { id: 'BreadthFirstFinder',                   label: 'Breadth-First Search' },\n        { id: 'BiBreadthFirstFinder',                 label: 'Breadth-First Search (Bi-directional)' },\n        { id: 'BestFirstFinder',                      label: 'Best-First Search' },\n        { id: 'BiBestFirstFinder',                    label: 'Best-First Search (Bi-directional)' },\n        { id: 'DijkstraFinder',                       label: 'Dijkstra' },\n        { id: 'BiDijkstraFinder',                     label: 'Dijkstra (Bi-directional)' },\n        { id: 'JumpPointFinder',                      label: 'Jump Point Search' },\n        { id: 'JPFAlwaysMoveDiagonally',              label: 'JPS (Always Diagonal)' },\n        { id: 'JPFMoveDiagonallyIfAtMostOneObstacle', label: 'JPS (Diagonal ≤1 Obstacle)' },\n        { id: 'JPFMoveDiagonallyIfNoObstacles',       label: 'JPS (No Diagonal Obstacles)' },\n        { id: 'JPFNeverMoveDiagonally',               label: 'JPS (Never Diagonal)' }\n    ],\n\n    PRESETS: {\n        'Empty 15x15': {\n            cols: 15, rows: 15,\n            walls: [],\n            startX: 1, startY: 7,\n            endX: 13, endY: 7\n        },\n        'Maze 15x15': {\n            cols: 15, rows: 15,\n            walls: [\n                [3,1],[3,2],[3,3],[3,4],[3,5],[3,6],[3,7],[3,8],[3,9],\n                [7,5],[7,6],[7,7],[7,8],[7,9],[7,10],[7,11],[7,12],[7,13],\n                [11,1],[11,2],[11,3],[11,4],[11,5],[11,6],[11,7],[11,8],[11,9]\n            ],\n            startX: 1, startY: 7,\n            endX: 13, endY: 7\n        },\n        'Corridors 20x20': {\n            cols: 20, rows: 20,\n            walls: (function() {\n                var w = [];\n                // horizontal walls with gaps\n                for (var x = 0; x < 20; x++) { if (x !== 5)  w.push([x, 5]); }\n                for (var x = 0; x < 20; x++) { if (x !== 14) w.push([x, 10]); }\n                for (var x = 0; x < 20; x++) { if (x !== 5)  w.push([x, 15]); }\n                return w;\n            }()),\n            startX: 1, startY: 1,\n            endX: 18, endY: 18\n        },\n        'Diagonal Barrier': {\n            cols: 15, rows: 15,\n            walls: (function() {\n                var w = [];\n                for (var i = 2; i <= 12; i++) { w.push([i, i]); }\n                return w;\n            }()),\n            startX: 1, startY: 7,\n            endX: 13, endY: 7\n        }\n    },\n\n    DEFAULT_GRID_SIZE: { cols: 15, rows: 15 },\n\n    /**\n     * Validate grid dimensions.\n     * cols and rows must be integers in [5, 100].\n     */\n    validateGridSize: function(cols, rows) {\n        if (typeof cols !== 'number' || typeof rows !== 'number') return false;\n        if (!isFinite(cols) || !isFinite(rows)) return false;\n        if (cols !== Math.floor(cols) || rows !== Math.floor(rows)) return false;\n        return cols >= 5 && cols <= 100 && rows >= 5 && rows <= 100;\n    },\n\n    /**\n     * Map speed slider value [1..10] to animation interval in ms.\n     * Speed 1 → 500ms/op, speed 10 → 10ms/op.\n     */\n    getAnimationInterval: function(speed) {\n        var s = Math.min(10, Math.max(1, speed));\n        // exponential scale: speed 1 = 500ms, speed 10 = 10ms\n        return Math.round(500 * Math.pow(10 / 500, (s - 1) / 9));\n    },\n\n    /**\n     * Map speed slider value [1..10] to operations per second.\n     * Inverse of getAnimationInterval: ops/sec = 1000 / interval.\n     */\n    getOperationsPerSecond: function(speed) {\n        return Math.round(1000 / this.getAnimationInterval(speed));\n    },\n\n    /**\n     * Serialize current scenario to JSON string.\n     * opts: { cols, rows, walls, startX, startY, endX, endY, algorithm }\n     */\n    serializeScenario: function(opts) {\n        return JSON.stringify({\n            cols:      opts.cols,\n            rows:      opts.rows,\n            walls:     opts.walls,\n            startX:    opts.startX,\n            startY:    opts.startY,\n            endX:      opts.endX,\n            endY:      opts.endY,\n            algorithm: opts.algorithm\n        }, null, 2);\n    },\n\n    /**\n     * Deserialize scenario from JSON string or plain object.\n     * Throws on parse error or missing required fields.\n     */\n    deserializeScenario: function(input) {\n        var obj;\n        if (typeof input === 'string') {\n            obj = JSON.parse(input); // throws on bad JSON\n        } else {\n            obj = input;\n        }\n        for (var i = 0; i < REQUIRED_FIELDS.length; i++) {\n            if (!Object.prototype.hasOwnProperty.call(obj, REQUIRED_FIELDS[i])) {\n                throw new Error('Missing required field: ' + REQUIRED_FIELDS[i]);\n            }\n        }\n        return obj;\n    },\n\n    /**\n     * Return sorted list of preset names.\n     */\n    getPresetNames: function() {\n        return Object.keys(this.PRESETS).sort();\n    },\n\n    /**\n     * Return preset data by name, or throw if not found.\n     */\n    loadPreset: function(name) {\n        if (!Object.prototype.hasOwnProperty.call(this.PRESETS, name)) {\n            throw new Error('Unknown preset: ' + name);\n        }\n        return this.PRESETS[name];\n    }\n};\n\nmodule.exports = ScenarioControls;\n","numLines":152,"startLine":1,"totalLines":152}}}
