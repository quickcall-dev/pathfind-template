{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SDhKwZJJf6xU7ZL49ZJ4RK","type":"tool_result","content":"1\t/**\n2\t * The control panel.\n3\t */\n4\tvar Panel = {\n5\t    init: function() {\n6\t        var $algo = $('#algorithm_panel');\n7\t\n8\t        $('.panel').draggable();\n9\t        $('.accordion').accordion({\n10\t            collapsible: false,\n11\t        });\n12\t        $('.option_label').click(function() {\n13\t            $(this).prev().click();\n14\t        });\n15\t        $('#hide_instructions').click(function() {\n16\t            $('#instructions_panel').slideUp();\n17\t        });\n18\t        $('#play_panel').css({\n19\t            top: $algo.offset().top + $algo.outerHeight() + 20\n20\t        });\n21\t        $('#button2').attr('disabled', 'disabled');\n22\t    },\n23\t    /**\n24\t     * Return a human-readable name for the currently selected finder.\n25\t     */\n26\t    getFinderName: function() {\n27\t        var selected_header = $(\n28\t            '#algorithm_panel .ui-accordion-header[aria-selected=true]'\n29\t        ).attr('id');\n30\t        var nameMap = {\n31\t            'astar_header':          'A*',\n32\t            'breadthfirst_header':   'BreadthFirst',\n33\t            'bestfirst_header':      'BestFirst',\n34\t            'dijkstra_header':       'Dijkstra',\n35\t            'jump_point_header':     'JumpPoint',\n36\t            'orth_jump_point_header':'JumpPoint (Orthogonal)',\n37\t            'ida_header':            'IDA*'\n38\t        };\n39\t        return nameMap[selected_header] || selected_header || 'Unknown';\n40\t    },\n41\t\n42\t    /**\n43\t     * Get the user selected path-finder.\n44\t     * TODO: clean up this messy code.\n45\t     */\n46\t    getFinder: function() {\n47\t        var finder, selected_header, heuristic, allowDiagonal, biDirectional, dontCrossCorners, weight, trackRecursion, timeLimit;\n48\t        \n49\t        selected_header = $(\n50\t            '#algorithm_panel ' +\n51\t            '.ui-accordion-header[aria-selected=true]'\n52\t        ).attr('id');\n53\t        \n54\t        switch (selected_header) {\n55\t\n56\t        case 'astar_header':\n57\t            allowDiagonal = typeof $('#astar_section ' +\n58\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n59\t            biDirectional = typeof $('#astar_section ' +\n60\t                                     '.bi-directional:checked').val() !=='undefined';\n61\t            dontCrossCorners = typeof $('#astar_section ' +\n62\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n63\t\n64\t            /* parseInt returns NaN (which is falsy) if the string can't be parsed */\n65\t            weight = parseInt($('#astar_section .spinner').val()) || 1;\n66\t            weight = weight >= 1 ? weight : 1; /* if negative or 0, use 1 */\n67\t\n68\t            heuristic = $('input[name=astar_heuristic]:checked').val();\n69\t            if (biDirectional) {\n70\t                finder = new PF.BiAStarFinder({\n71\t                    allowDiagonal: allowDiagonal,\n72\t                    dontCrossCorners: dontCrossCorners,\n73\t                    heuristic: PF.Heuristic[heuristic],\n74\t                    weight: weight\n75\t                });\n76\t            } else {\n77\t                finder = new PF.AStarFinder({\n78\t                    allowDiagonal: allowDiagonal,\n79\t                    dontCrossCorners: dontCrossCorners,\n80\t                    heuristic: PF.Heuristic[heuristic],\n81\t                    weight: weight\n82\t                });\n83\t            }\n84\t            break;\n85\t\n86\t        case 'breadthfirst_header':\n87\t            allowDiagonal = typeof $('#breadthfirst_section ' +\n88\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n89\t            biDirectional = typeof $('#breadthfirst_section ' +\n90\t                                     '.bi-directional:checked').val() !== 'undefined';\n91\t            dontCrossCorners = typeof $('#breadthfirst_section ' +\n92\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n93\t            if (biDirectional) {\n94\t                finder = new PF.BiBreadthFirstFinder({\n95\t                    allowDiagonal: allowDiagonal,\n96\t                    dontCrossCorners: dontCrossCorners\n97\t                });\n98\t            } else {\n99\t                finder = new PF.BreadthFirstFinder({\n100\t                    allowDiagonal: allowDiagonal,\n101\t                    dontCrossCorners: dontCrossCorners\n102\t                });\n103\t            }\n104\t            break;\n105\t\n106\t        case 'bestfirst_header':\n107\t            allowDiagonal = typeof $('#bestfirst_section ' +\n108\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n109\t            biDirectional = typeof $('#bestfirst_section ' +\n110\t                                     '.bi-directional:checked').val() !== 'undefined';\n111\t            dontCrossCorners = typeof $('#bestfirst_section ' +\n112\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n113\t            heuristic = $('input[name=bestfirst_heuristic]:checked').val();\n114\t            if (biDirectional) {\n115\t                finder = new PF.BiBestFirstFinder({\n116\t                    allowDiagonal: allowDiagonal,\n117\t                    dontCrossCorners: dontCrossCorners,\n118\t                    heuristic: PF.Heuristic[heuristic]\n119\t                });\n120\t            } else {\n121\t                finder = new PF.BestFirstFinder({\n122\t                    allowDiagonal: allowDiagonal,\n123\t                    dontCrossCorners: dontCrossCorners,\n124\t                    heuristic: PF.Heuristic[heuristic]\n125\t                });\n126\t            }\n127\t            break;\n128\t\n129\t        case 'dijkstra_header':\n130\t            allowDiagonal = typeof $('#dijkstra_section ' +\n131\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n132\t            biDirectional = typeof $('#dijkstra_section ' +\n133\t                                     '.bi-directional:checked').val() !=='undefined';\n134\t            dontCrossCorners = typeof $('#dijkstra_section ' +\n135\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n136\t            if (biDirectional) {\n137\t                finder = new PF.BiDijkstraFinder({\n138\t                    allowDiagonal: allowDiagonal,\n139\t                    dontCrossCorners: dontCrossCorners\n140\t                });\n141\t            } else {\n142\t                finder = new PF.DijkstraFinder({\n143\t                    allowDiagonal: allowDiagonal,\n144\t                    dontCrossCorners: dontCrossCorners\n145\t                });\n146\t            }\n147\t            break;\n148\t\n149\t        case 'jump_point_header':\n150\t            trackRecursion = typeof $('#jump_point_section ' +\n151\t                                     '.track_recursion:checked').val() !== 'undefined';\n152\t            heuristic = $('input[name=jump_point_heuristic]:checked').val();\n153\t            \n154\t            finder = new PF.JumpPointFinder({\n155\t              trackJumpRecursion: trackRecursion,\n156\t              heuristic: PF.Heuristic[heuristic],\n157\t              diagonalMovement: PF.DiagonalMovement.IfAtMostOneObstacle\n158\t            });\n159\t            break;\n160\t        case 'orth_jump_point_header':\n161\t            trackRecursion = typeof $('#orth_jump_point_section ' +\n162\t                                     '.track_recursion:checked').val() !== 'undefined';\n163\t            heuristic = $('input[name=orth_jump_point_heuristic]:checked').val();\n164\t\n165\t            finder = new PF.JumpPointFinder({\n166\t              trackJumpRecursion: trackRecursion,\n167\t              heuristic: PF.Heuristic[heuristic],\n168\t              diagonalMovement: PF.DiagonalMovement.Never\n169\t            });\n170\t            break;\n171\t        case 'ida_header':\n172\t            allowDiagonal = typeof $('#ida_section ' +\n173\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n174\t            dontCrossCorners = typeof $('#ida_section ' +\n175\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n176\t            trackRecursion = typeof $('#ida_section ' +\n177\t                                     '.track_recursion:checked').val() !== 'undefined';\n178\t\n179\t            heuristic = $('input[name=ida_heuristic]:checked').val();\n180\t\n181\t            weight = parseInt($('#ida_section input[name=astar_weight]').val()) || 1;\n182\t            weight = weight >= 1 ? weight : 1; /* if negative or 0, use 1 */\n183\t\n184\t            timeLimit = parseInt($('#ida_section input[name=time_limit]').val());\n185\t\n186\t            // Any non-negative integer, indicates \"forever\".\n187\t            timeLimit = (timeLimit <= 0 || isNaN(timeLimit)) ? -1 : timeLimit;\n188\t\n189\t            finder = new PF.IDAStarFinder({\n190\t              timeLimit: timeLimit,\n191\t              trackRecursion: trackRecursion,\n192\t              allowDiagonal: allowDiagonal,\n193\t              dontCrossCorners: dontCrossCorners,\n194\t              heuristic: PF.Heuristic[heuristic],\n195\t              weight: weight\n196\t            });\n197\t\n198\t            break;\n199\t        }\n200\t\n201\t        return finder;\n202\t    }\n203\t};\n204\t"}]},"parent_tool_use_id":null,"session_id":"af9f5486-7903-4156-b0c4-5cf18c74697f","uuid":"ad908191-5176-4ac1-9fd7-c1061d41dc9d","timestamp":"2026-04-16T15:38:29.675Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/visual/js/panel.js","content":"/**\n * The control panel.\n */\nvar Panel = {\n    init: function() {\n        var $algo = $('#algorithm_panel');\n\n        $('.panel').draggable();\n        $('.accordion').accordion({\n            collapsible: false,\n        });\n        $('.option_label').click(function() {\n            $(this).prev().click();\n        });\n        $('#hide_instructions').click(function() {\n            $('#instructions_panel').slideUp();\n        });\n        $('#play_panel').css({\n            top: $algo.offset().top + $algo.outerHeight() + 20\n        });\n        $('#button2').attr('disabled', 'disabled');\n    },\n    /**\n     * Return a human-readable name for the currently selected finder.\n     */\n    getFinderName: function() {\n        var selected_header = $(\n            '#algorithm_panel .ui-accordion-header[aria-selected=true]'\n        ).attr('id');\n        var nameMap = {\n            'astar_header':          'A*',\n            'breadthfirst_header':   'BreadthFirst',\n            'bestfirst_header':      'BestFirst',\n            'dijkstra_header':       'Dijkstra',\n            'jump_point_header':     'JumpPoint',\n            'orth_jump_point_header':'JumpPoint (Orthogonal)',\n            'ida_header':            'IDA*'\n        };\n        return nameMap[selected_header] || selected_header || 'Unknown';\n    },\n\n    /**\n     * Get the user selected path-finder.\n     * TODO: clean up this messy code.\n     */\n    getFinder: function() {\n        var finder, selected_header, heuristic, allowDiagonal, biDirectional, dontCrossCorners, weight, trackRecursion, timeLimit;\n        \n        selected_header = $(\n            '#algorithm_panel ' +\n            '.ui-accordion-header[aria-selected=true]'\n        ).attr('id');\n        \n        switch (selected_header) {\n\n        case 'astar_header':\n            allowDiagonal = typeof $('#astar_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            biDirectional = typeof $('#astar_section ' +\n                                     '.bi-directional:checked').val() !=='undefined';\n            dontCrossCorners = typeof $('#astar_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n\n            /* parseInt returns NaN (which is falsy) if the string can't be parsed */\n            weight = parseInt($('#astar_section .spinner').val()) || 1;\n            weight = weight >= 1 ? weight : 1; /* if negative or 0, use 1 */\n\n            heuristic = $('input[name=astar_heuristic]:checked').val();\n            if (biDirectional) {\n                finder = new PF.BiAStarFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners,\n                    heuristic: PF.Heuristic[heuristic],\n                    weight: weight\n                });\n            } else {\n                finder = new PF.AStarFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners,\n                    heuristic: PF.Heuristic[heuristic],\n                    weight: weight\n                });\n            }\n            break;\n\n        case 'breadthfirst_header':\n            allowDiagonal = typeof $('#breadthfirst_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            biDirectional = typeof $('#breadthfirst_section ' +\n                                     '.bi-directional:checked').val() !== 'undefined';\n            dontCrossCorners = typeof $('#breadthfirst_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n            if (biDirectional) {\n                finder = new PF.BiBreadthFirstFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners\n                });\n            } else {\n                finder = new PF.BreadthFirstFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners\n                });\n            }\n            break;\n\n        case 'bestfirst_header':\n            allowDiagonal = typeof $('#bestfirst_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            biDirectional = typeof $('#bestfirst_section ' +\n                                     '.bi-directional:checked').val() !== 'undefined';\n            dontCrossCorners = typeof $('#bestfirst_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n            heuristic = $('input[name=bestfirst_heuristic]:checked').val();\n            if (biDirectional) {\n                finder = new PF.BiBestFirstFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners,\n                    heuristic: PF.Heuristic[heuristic]\n                });\n            } else {\n                finder = new PF.BestFirstFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners,\n                    heuristic: PF.Heuristic[heuristic]\n                });\n            }\n            break;\n\n        case 'dijkstra_header':\n            allowDiagonal = typeof $('#dijkstra_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            biDirectional = typeof $('#dijkstra_section ' +\n                                     '.bi-directional:checked').val() !=='undefined';\n            dontCrossCorners = typeof $('#dijkstra_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n            if (biDirectional) {\n                finder = new PF.BiDijkstraFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners\n                });\n            } else {\n                finder = new PF.DijkstraFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners\n                });\n            }\n            break;\n\n        case 'jump_point_header':\n            trackRecursion = typeof $('#jump_point_section ' +\n                                     '.track_recursion:checked').val() !== 'undefined';\n            heuristic = $('input[name=jump_point_heuristic]:checked').val();\n            \n            finder = new PF.JumpPointFinder({\n              trackJumpRecursion: trackRecursion,\n              heuristic: PF.Heuristic[heuristic],\n              diagonalMovement: PF.DiagonalMovement.IfAtMostOneObstacle\n            });\n            break;\n        case 'orth_jump_point_header':\n            trackRecursion = typeof $('#orth_jump_point_section ' +\n                                     '.track_recursion:checked').val() !== 'undefined';\n            heuristic = $('input[name=orth_jump_point_heuristic]:checked').val();\n\n            finder = new PF.JumpPointFinder({\n              trackJumpRecursion: trackRecursion,\n              heuristic: PF.Heuristic[heuristic],\n              diagonalMovement: PF.DiagonalMovement.Never\n            });\n            break;\n        case 'ida_header':\n            allowDiagonal = typeof $('#ida_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            dontCrossCorners = typeof $('#ida_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n            trackRecursion = typeof $('#ida_section ' +\n                                     '.track_recursion:checked').val() !== 'undefined';\n\n            heuristic = $('input[name=ida_heuristic]:checked').val();\n\n            weight = parseInt($('#ida_section input[name=astar_weight]').val()) || 1;\n            weight = weight >= 1 ? weight : 1; /* if negative or 0, use 1 */\n\n            timeLimit = parseInt($('#ida_section input[name=time_limit]').val());\n\n            // Any non-negative integer, indicates \"forever\".\n            timeLimit = (timeLimit <= 0 || isNaN(timeLimit)) ? -1 : timeLimit;\n\n            finder = new PF.IDAStarFinder({\n              timeLimit: timeLimit,\n              trackRecursion: trackRecursion,\n              allowDiagonal: allowDiagonal,\n              dontCrossCorners: dontCrossCorners,\n              heuristic: PF.Heuristic[heuristic],\n              weight: weight\n            });\n\n            break;\n        }\n\n        return finder;\n    }\n};\n","numLines":204,"startLine":1,"totalLines":204}}}
