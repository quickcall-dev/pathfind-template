{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Sjqd7D2pSF2EwaNcbgSEE8","type":"tool_result","content":"1\t/**\n2\t * ScenarioManager — save/load and preset library for pathfinding scenarios.\n3\t *\n4\t * Scenario schema:\n5\t *   { width, height, startX, startY, endX, endY, matrix }\n6\t *   matrix[y][x] === 1 → wall, 0 → walkable\n7\t */\n8\t\n9\tvar REQUIRED_FIELDS = ['width', 'height', 'startX', 'startY', 'endX', 'endY', 'matrix'];\n10\tvar PRESET_SIZE = 15;\n11\t\n12\t// ---------------------------------------------------------------------------\n13\t// Helpers\n14\t// ---------------------------------------------------------------------------\n15\t\n16\tfunction emptyMatrix(width, height) {\n17\t    var m = [];\n18\t    for (var y = 0; y < height; y++) {\n19\t        m[y] = [];\n20\t        for (var x = 0; x < width; x++) {\n21\t            m[y][x] = 0;\n22\t        }\n23\t    }\n24\t    return m;\n25\t}\n26\t\n27\tfunction validateObject(obj) {\n28\t    REQUIRED_FIELDS.forEach(function(f) {\n29\t        if (obj[f] === undefined || obj[f] === null) {\n30\t            throw new Error('Missing required field: ' + f);\n31\t        }\n32\t    });\n33\t    if (!Array.isArray(obj.matrix) || obj.matrix.length !== obj.height ||\n34\t        !Array.isArray(obj.matrix[0]) || obj.matrix[0].length !== obj.width) {\n35\t        throw new Error('matrix dimensions do not match width/height');\n36\t    }\n37\t}\n38\t\n39\t// ---------------------------------------------------------------------------\n40\t// Public API\n41\t// ---------------------------------------------------------------------------\n42\t\n43\tfunction save(scenario) {\n44\t    return JSON.stringify(scenario);\n45\t}\n46\t\n47\tfunction load(jsonString) {\n48\t    var obj;\n49\t    try {\n50\t        obj = JSON.parse(jsonString);\n51\t    } catch (e) {\n52\t        throw new Error('Invalid JSON: ' + e.message);\n53\t    }\n54\t    validateObject(obj);\n55\t    return obj;\n56\t}\n57\t\n58\tfunction saveObject(scenario) {\n59\t    return JSON.parse(JSON.stringify(scenario)); // deep clone\n60\t}\n61\t\n62\tfunction loadObject(obj) {\n63\t    validateObject(obj);\n64\t    return JSON.parse(JSON.stringify(obj)); // defensive clone\n65\t}\n66\t\n67\t// ---------------------------------------------------------------------------\n68\t// Preset generators (all 15x15, deterministic except 'random')\n69\t// ---------------------------------------------------------------------------\n70\t\n71\tfunction makeEmpty() {\n72\t    return {\n73\t        width: PRESET_SIZE,\n74\t        height: PRESET_SIZE,\n75\t        startX: 0,\n76\t        startY: 0,\n77\t        endX: PRESET_SIZE - 1,\n78\t        endY: PRESET_SIZE - 1,\n79\t        matrix: emptyMatrix(PRESET_SIZE, PRESET_SIZE)\n80\t    };\n81\t}\n82\t\n83\tfunction makeMaze() {\n84\t    var S = PRESET_SIZE;\n85\t    var m = emptyMatrix(S, S);\n86\t\n87\t    // Horizontal walls every 2 rows with staggered gaps (corridor maze)\n88\t    for (var y = 2; y < S - 1; y += 4) {\n89\t        for (var x = 0; x < S; x++) {\n90\t            m[y][x] = 1;\n91\t        }\n92\t        // gap on right side\n93\t        m[y][S - 2] = 0;\n94\t    }\n95\t    for (var y2 = 4; y2 < S - 1; y2 += 4) {\n96\t        for (var x2 = 0; x2 < S; x2++) {\n97\t            m[y2][x2] = 1;\n98\t        }\n99\t        // gap on left side\n100\t        m[y2][1] = 0;\n101\t    }\n102\t\n103\t    // Keep start/end clear\n104\t    m[0][0] = 0;\n105\t    m[S - 1][S - 1] = 0;\n106\t\n107\t    return {\n108\t        width: S, height: S,\n109\t        startX: 0, startY: 0,\n110\t        endX: S - 1, endY: S - 1,\n111\t        matrix: m\n112\t    };\n113\t}\n114\t\n115\tfunction makeSpiral() {\n116\t    var S = PRESET_SIZE;\n117\t    var m = emptyMatrix(S, S);\n118\t\n119\t    // Draw concentric rectangular rings (partial, leaving a gap to enter inner ring)\n120\t    var rings = Math.floor(S / 4);\n121\t    for (var r = 0; r < rings; r++) {\n122\t        var top    = r * 2;\n123\t        var left   = r * 2;\n124\t        var bottom = S - 1 - r * 2;\n125\t        var right  = S - 1 - r * 2;\n126\t\n127\t        if (top >= bottom || left >= right) break;\n128\t\n129\t        // top row\n130\t        for (var x = left; x <= right; x++) m[top][x] = 1;\n131\t        // right col\n132\t        for (var y = top; y <= bottom; y++) m[y][right] = 1;\n133\t        // bottom row\n134\t        for (var x2 = left; x2 <= right; x2++) m[bottom][x2] = 1;\n135\t        // left col\n136\t        for (var y2 = top; y2 <= bottom; y2++) m[y2][left] = 1;\n137\t\n138\t        // opening: alternate top-right gap and bottom-left gap per ring\n139\t        if (r % 2 === 0) {\n140\t            // gap at bottom-left\n141\t            m[bottom][left + 1] = 0;\n142\t        } else {\n143\t            // gap at top-right\n144\t            m[top][right - 1] = 0;\n145\t        }\n146\t    }\n147\t\n148\t    // Always clear start and end\n149\t    m[0][0] = 0;\n150\t    m[S - 1][S - 1] = 0;\n151\t\n152\t    return {\n153\t        width: S, height: S,\n154\t        startX: 0, startY: 0,\n155\t        endX: S - 1, endY: S - 1,\n156\t        matrix: m\n157\t    };\n158\t}\n159\t\n160\tfunction makeBottleneck() {\n161\t    var S = PRESET_SIZE;\n162\t    var m = emptyMatrix(S, S);\n163\t    var midY = Math.floor(S / 2);\n164\t    var gapX = Math.floor(S / 2); // single cell gap in the middle\n165\t\n166\t    // Wall across the full middle row except one gap\n167\t    for (var x = 0; x < S; x++) {\n168\t        if (x !== gapX) {\n169\t            m[midY][x] = 1;\n170\t        }\n171\t    }\n172\t\n173\t    m[0][0] = 0;\n174\t    m[S - 1][S - 1] = 0;\n175\t\n176\t    return {\n177\t        width: S, height: S,\n178\t        startX: 0, startY: 0,\n179\t        endX: S - 1, endY: S - 1,\n180\t        matrix: m\n181\t    };\n182\t}\n183\t\n184\tfunction makeRandom() {\n185\t    var S = PRESET_SIZE;\n186\t    var m = emptyMatrix(S, S);\n187\t    var startX = 0, startY = 0, endX = S - 1, endY = S - 1;\n188\t\n189\t    // Seeded-ish deterministic \"random\" using a simple LCG for reproducibility\n190\t    var seed = 42;\n191\t    function rand() {\n192\t        seed = (seed * 1664525 + 1013904223) & 0xffffffff;\n193\t        return (seed >>> 0) / 0xffffffff;\n194\t    }\n195\t\n196\t    var density = 0.25;\n197\t    for (var y = 0; y < S; y++) {\n198\t        for (var x = 0; x < S; x++) {\n199\t            // Never wall start or end\n200\t            if ((x === startX && y === startY) || (x === endX && y === endY)) continue;\n201\t            if (rand() < density) m[y][x] = 1;\n202\t        }\n203\t    }\n204\t\n205\t    return {\n206\t        width: S, height: S,\n207\t        startX: startX, startY: startY,\n208\t        endX: endX, endY: endY,\n209\t        matrix: m\n210\t    };\n211\t}\n212\t\n213\t// ---------------------------------------------------------------------------\n214\t// Preset registry\n215\t// ---------------------------------------------------------------------------\n216\t\n217\tvar PRESETS = {\n218\t    empty:       makeEmpty,\n219\t    maze:        makeMaze,\n220\t    spiral:      makeSpiral,\n221\t    bottleneck:  makeBottleneck,\n222\t    random:      makeRandom\n223\t};\n224\t\n225\tfunction presetNames() {\n226\t    return Object.keys(PRESETS);\n227\t}\n228\t\n229\tfunction loadPreset(name) {\n230\t    if (!PRESETS[name]) {\n231\t        throw new Error('Unknown preset: \"' + name + '\"');\n232\t    }\n233\t    return PRESETS[name]();\n234\t}\n235\t\n236\t// ---------------------------------------------------------------------------\n237\t// Exports\n238\t// ---------------------------------------------------------------------------\n239\t\n240\tmodule.exports = {\n241\t    emptyMatrix:  emptyMatrix,\n242\t    save:         save,\n243\t    load:         load,\n244\t    saveObject:   saveObject,\n245\t    loadObject:   loadObject,\n246\t    presetNames:  presetNames,\n247\t    loadPreset:   loadPreset\n248\t};\n249\t"}]},"parent_tool_use_id":null,"session_id":"e2eec0a0-4abd-4b8c-8ab1-dfbeb62622fc","uuid":"0ffadd1b-0217-4b12-8424-4a642dfa69da","timestamp":"2026-04-16T15:38:44.868Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/src/scenario/ScenarioManager.js","content":"/**\n * ScenarioManager — save/load and preset library for pathfinding scenarios.\n *\n * Scenario schema:\n *   { width, height, startX, startY, endX, endY, matrix }\n *   matrix[y][x] === 1 → wall, 0 → walkable\n */\n\nvar REQUIRED_FIELDS = ['width', 'height', 'startX', 'startY', 'endX', 'endY', 'matrix'];\nvar PRESET_SIZE = 15;\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfunction emptyMatrix(width, height) {\n    var m = [];\n    for (var y = 0; y < height; y++) {\n        m[y] = [];\n        for (var x = 0; x < width; x++) {\n            m[y][x] = 0;\n        }\n    }\n    return m;\n}\n\nfunction validateObject(obj) {\n    REQUIRED_FIELDS.forEach(function(f) {\n        if (obj[f] === undefined || obj[f] === null) {\n            throw new Error('Missing required field: ' + f);\n        }\n    });\n    if (!Array.isArray(obj.matrix) || obj.matrix.length !== obj.height ||\n        !Array.isArray(obj.matrix[0]) || obj.matrix[0].length !== obj.width) {\n        throw new Error('matrix dimensions do not match width/height');\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\nfunction save(scenario) {\n    return JSON.stringify(scenario);\n}\n\nfunction load(jsonString) {\n    var obj;\n    try {\n        obj = JSON.parse(jsonString);\n    } catch (e) {\n        throw new Error('Invalid JSON: ' + e.message);\n    }\n    validateObject(obj);\n    return obj;\n}\n\nfunction saveObject(scenario) {\n    return JSON.parse(JSON.stringify(scenario)); // deep clone\n}\n\nfunction loadObject(obj) {\n    validateObject(obj);\n    return JSON.parse(JSON.stringify(obj)); // defensive clone\n}\n\n// ---------------------------------------------------------------------------\n// Preset generators (all 15x15, deterministic except 'random')\n// ---------------------------------------------------------------------------\n\nfunction makeEmpty() {\n    return {\n        width: PRESET_SIZE,\n        height: PRESET_SIZE,\n        startX: 0,\n        startY: 0,\n        endX: PRESET_SIZE - 1,\n        endY: PRESET_SIZE - 1,\n        matrix: emptyMatrix(PRESET_SIZE, PRESET_SIZE)\n    };\n}\n\nfunction makeMaze() {\n    var S = PRESET_SIZE;\n    var m = emptyMatrix(S, S);\n\n    // Horizontal walls every 2 rows with staggered gaps (corridor maze)\n    for (var y = 2; y < S - 1; y += 4) {\n        for (var x = 0; x < S; x++) {\n            m[y][x] = 1;\n        }\n        // gap on right side\n        m[y][S - 2] = 0;\n    }\n    for (var y2 = 4; y2 < S - 1; y2 += 4) {\n        for (var x2 = 0; x2 < S; x2++) {\n            m[y2][x2] = 1;\n        }\n        // gap on left side\n        m[y2][1] = 0;\n    }\n\n    // Keep start/end clear\n    m[0][0] = 0;\n    m[S - 1][S - 1] = 0;\n\n    return {\n        width: S, height: S,\n        startX: 0, startY: 0,\n        endX: S - 1, endY: S - 1,\n        matrix: m\n    };\n}\n\nfunction makeSpiral() {\n    var S = PRESET_SIZE;\n    var m = emptyMatrix(S, S);\n\n    // Draw concentric rectangular rings (partial, leaving a gap to enter inner ring)\n    var rings = Math.floor(S / 4);\n    for (var r = 0; r < rings; r++) {\n        var top    = r * 2;\n        var left   = r * 2;\n        var bottom = S - 1 - r * 2;\n        var right  = S - 1 - r * 2;\n\n        if (top >= bottom || left >= right) break;\n\n        // top row\n        for (var x = left; x <= right; x++) m[top][x] = 1;\n        // right col\n        for (var y = top; y <= bottom; y++) m[y][right] = 1;\n        // bottom row\n        for (var x2 = left; x2 <= right; x2++) m[bottom][x2] = 1;\n        // left col\n        for (var y2 = top; y2 <= bottom; y2++) m[y2][left] = 1;\n\n        // opening: alternate top-right gap and bottom-left gap per ring\n        if (r % 2 === 0) {\n            // gap at bottom-left\n            m[bottom][left + 1] = 0;\n        } else {\n            // gap at top-right\n            m[top][right - 1] = 0;\n        }\n    }\n\n    // Always clear start and end\n    m[0][0] = 0;\n    m[S - 1][S - 1] = 0;\n\n    return {\n        width: S, height: S,\n        startX: 0, startY: 0,\n        endX: S - 1, endY: S - 1,\n        matrix: m\n    };\n}\n\nfunction makeBottleneck() {\n    var S = PRESET_SIZE;\n    var m = emptyMatrix(S, S);\n    var midY = Math.floor(S / 2);\n    var gapX = Math.floor(S / 2); // single cell gap in the middle\n\n    // Wall across the full middle row except one gap\n    for (var x = 0; x < S; x++) {\n        if (x !== gapX) {\n            m[midY][x] = 1;\n        }\n    }\n\n    m[0][0] = 0;\n    m[S - 1][S - 1] = 0;\n\n    return {\n        width: S, height: S,\n        startX: 0, startY: 0,\n        endX: S - 1, endY: S - 1,\n        matrix: m\n    };\n}\n\nfunction makeRandom() {\n    var S = PRESET_SIZE;\n    var m = emptyMatrix(S, S);\n    var startX = 0, startY = 0, endX = S - 1, endY = S - 1;\n\n    // Seeded-ish deterministic \"random\" using a simple LCG for reproducibility\n    var seed = 42;\n    function rand() {\n        seed = (seed * 1664525 + 1013904223) & 0xffffffff;\n        return (seed >>> 0) / 0xffffffff;\n    }\n\n    var density = 0.25;\n    for (var y = 0; y < S; y++) {\n        for (var x = 0; x < S; x++) {\n            // Never wall start or end\n            if ((x === startX && y === startY) || (x === endX && y === endY)) continue;\n            if (rand() < density) m[y][x] = 1;\n        }\n    }\n\n    return {\n        width: S, height: S,\n        startX: startX, startY: startY,\n        endX: endX, endY: endY,\n        matrix: m\n    };\n}\n\n// ---------------------------------------------------------------------------\n// Preset registry\n// ---------------------------------------------------------------------------\n\nvar PRESETS = {\n    empty:       makeEmpty,\n    maze:        makeMaze,\n    spiral:      makeSpiral,\n    bottleneck:  makeBottleneck,\n    random:      makeRandom\n};\n\nfunction presetNames() {\n    return Object.keys(PRESETS);\n}\n\nfunction loadPreset(name) {\n    if (!PRESETS[name]) {\n        throw new Error('Unknown preset: \"' + name + '\"');\n    }\n    return PRESETS[name]();\n}\n\n// ---------------------------------------------------------------------------\n// Exports\n// ---------------------------------------------------------------------------\n\nmodule.exports = {\n    emptyMatrix:  emptyMatrix,\n    save:         save,\n    load:         load,\n    saveObject:   saveObject,\n    loadObject:   loadObject,\n    presetNames:  presetNames,\n    loadPreset:   loadPreset\n};\n","numLines":249,"startLine":1,"totalLines":249}}}
