{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0166Qf6NTdHw62JYZc6Rzu2V","type":"tool_result","content":"1\t'use strict';\n2\t\n3\t/**\n4\t * GridCanvas — pure model for a 15x15 interactive pathfinding grid.\n5\t *\n6\t * Cell types: 'empty' | 'wall' | 'start' | 'end'\n7\t *\n8\t * API:\n9\t *   getCellType(x, y)       → string\n10\t *   toggleWall(x, y)        → void\n11\t *   setStart(x, y)          → void\n12\t *   setEnd(x, y)            → void\n13\t *   getStart()              → {x,y} | null\n14\t *   getEnd()                → {x,y} | null\n15\t *   getState()              → snapshot {width, height, start, end, walls}\n16\t *   setState(snapshot)      → void\n17\t *   toMatrix()              → number[][] (0=walkable, 1=wall)\n18\t *   reset()                 → void\n19\t */\n20\tfunction GridCanvas(width, height) {\n21\t    this.width  = width  || 15;\n22\t    this.height = height || 15;\n23\t    this._walls = {};   // key: \"x,y\"\n24\t    this._start = null; // {x, y}\n25\t    this._end   = null; // {x, y}\n26\t    this._onChange = null; // optional callback(state)\n27\t}\n28\t\n29\tGridCanvas.prototype._key = function(x, y) {\n30\t    return x + ',' + y;\n31\t};\n32\t\n33\tGridCanvas.prototype._inBounds = function(x, y) {\n34\t    return x >= 0 && x < this.width && y >= 0 && y < this.height;\n35\t};\n36\t\n37\tGridCanvas.prototype.getCellType = function(x, y) {\n38\t    if (this._start && this._start.x === x && this._start.y === y) return 'start';\n39\t    if (this._end   && this._end.x   === x && this._end.y   === y) return 'end';\n40\t    if (this._walls[this._key(x, y)]) return 'wall';\n41\t    return 'empty';\n42\t};\n43\t\n44\tGridCanvas.prototype.onChange = function(fn) {\n45\t    this._onChange = fn;\n46\t};\n47\t\n48\tGridCanvas.prototype._notify = function() {\n49\t    if (typeof this._onChange === 'function') {\n50\t        this._onChange(this.getState());\n51\t    }\n52\t};\n53\t\n54\tGridCanvas.prototype.setWall = function(x, y) {\n55\t    if (!this._inBounds(x, y)) return;\n56\t    var type = this.getCellType(x, y);\n57\t    if (type === 'start' || type === 'end') return;\n58\t    this._walls[this._key(x, y)] = true;\n59\t    this._notify();\n60\t};\n61\t\n62\tGridCanvas.prototype.toggleWall = function(x, y) {\n63\t    if (!this._inBounds(x, y)) return;\n64\t    var type = this.getCellType(x, y);\n65\t    if (type === 'start' || type === 'end') return;\n66\t    var k = this._key(x, y);\n67\t    if (this._walls[k]) {\n68\t        delete this._walls[k];\n69\t    } else {\n70\t        this._walls[k] = true;\n71\t    }\n72\t    this._notify();\n73\t};\n74\t\n75\tGridCanvas.prototype.setStart = function(x, y) {\n76\t    if (!this._inBounds(x, y)) return;\n77\t    // Clear previous start\n78\t    this._start = null;\n79\t    // If end is here, clear it\n80\t    if (this._end && this._end.x === x && this._end.y === y) {\n81\t        this._end = null;\n82\t    }\n83\t    // Clear wall if any\n84\t    delete this._walls[this._key(x, y)];\n85\t    this._start = { x: x, y: y };\n86\t    this._notify();\n87\t};\n88\t\n89\tGridCanvas.prototype.setEnd = function(x, y) {\n90\t    if (!this._inBounds(x, y)) return;\n91\t    // Clear previous end\n92\t    this._end = null;\n93\t    // If start is here, clear it\n94\t    if (this._start && this._start.x === x && this._start.y === y) {\n95\t        this._start = null;\n96\t    }\n97\t    // Clear wall if any\n98\t    delete this._walls[this._key(x, y)];\n99\t    this._end = { x: x, y: y };\n100\t    this._notify();\n101\t};\n102\t\n103\tGridCanvas.prototype.getStart = function() {\n104\t    return this._start ? { x: this._start.x, y: this._start.y } : null;\n105\t};\n106\t\n107\tGridCanvas.prototype.getEnd = function() {\n108\t    return this._end ? { x: this._end.x, y: this._end.y } : null;\n109\t};\n110\t\n111\tGridCanvas.prototype.getState = function() {\n112\t    var walls = [];\n113\t    var keys = Object.keys(this._walls);\n114\t    for (var i = 0; i < keys.length; i++) {\n115\t        var parts = keys[i].split(',');\n116\t        walls.push({ x: parseInt(parts[0], 10), y: parseInt(parts[1], 10) });\n117\t    }\n118\t    return {\n119\t        width:  this.width,\n120\t        height: this.height,\n121\t        start:  this._start ? { x: this._start.x, y: this._start.y } : null,\n122\t        end:    this._end   ? { x: this._end.x,   y: this._end.y   } : null,\n123\t        walls:  walls\n124\t    };\n125\t};\n126\t\n127\tGridCanvas.prototype.setState = function(snapshot) {\n128\t    this.reset();\n129\t    if (snapshot.start) this.setStart(snapshot.start.x, snapshot.start.y);\n130\t    if (snapshot.end)   this.setEnd(snapshot.end.x, snapshot.end.y);\n131\t    var walls = snapshot.walls || [];\n132\t    for (var i = 0; i < walls.length; i++) {\n133\t        var w = walls[i];\n134\t        if (this._inBounds(w.x, w.y) && this.getCellType(w.x, w.y) === 'empty') {\n135\t            this._walls[this._key(w.x, w.y)] = true;\n136\t        }\n137\t    }\n138\t    this._notify();\n139\t};\n140\t\n141\tGridCanvas.prototype.toMatrix = function() {\n142\t    var matrix = [];\n143\t    for (var y = 0; y < this.height; y++) {\n144\t        matrix[y] = [];\n145\t        for (var x = 0; x < this.width; x++) {\n146\t            matrix[y][x] = this._walls[this._key(x, y)] ? 1 : 0;\n147\t        }\n148\t    }\n149\t    return matrix;\n150\t};\n151\t\n152\tGridCanvas.prototype.reset = function() {\n153\t    this._walls = {};\n154\t    this._start = null;\n155\t    this._end   = null;\n156\t    this._notify();\n157\t};\n158\t\n159\tmodule.exports = GridCanvas;\n160\t"}]},"parent_tool_use_id":null,"session_id":"e2eec0a0-4abd-4b8c-8ab1-dfbeb62622fc","uuid":"21e309d3-0229-4be8-9f5a-a59d66bf620c","timestamp":"2026-04-16T15:38:44.000Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/docs/experiments/001-demo-artifacts/fleets/fleet-02-scenario-builder/workers/canvas-worker/output/GridCanvas.js","content":"'use strict';\n\n/**\n * GridCanvas — pure model for a 15x15 interactive pathfinding grid.\n *\n * Cell types: 'empty' | 'wall' | 'start' | 'end'\n *\n * API:\n *   getCellType(x, y)       → string\n *   toggleWall(x, y)        → void\n *   setStart(x, y)          → void\n *   setEnd(x, y)            → void\n *   getStart()              → {x,y} | null\n *   getEnd()                → {x,y} | null\n *   getState()              → snapshot {width, height, start, end, walls}\n *   setState(snapshot)      → void\n *   toMatrix()              → number[][] (0=walkable, 1=wall)\n *   reset()                 → void\n */\nfunction GridCanvas(width, height) {\n    this.width  = width  || 15;\n    this.height = height || 15;\n    this._walls = {};   // key: \"x,y\"\n    this._start = null; // {x, y}\n    this._end   = null; // {x, y}\n    this._onChange = null; // optional callback(state)\n}\n\nGridCanvas.prototype._key = function(x, y) {\n    return x + ',' + y;\n};\n\nGridCanvas.prototype._inBounds = function(x, y) {\n    return x >= 0 && x < this.width && y >= 0 && y < this.height;\n};\n\nGridCanvas.prototype.getCellType = function(x, y) {\n    if (this._start && this._start.x === x && this._start.y === y) return 'start';\n    if (this._end   && this._end.x   === x && this._end.y   === y) return 'end';\n    if (this._walls[this._key(x, y)]) return 'wall';\n    return 'empty';\n};\n\nGridCanvas.prototype.onChange = function(fn) {\n    this._onChange = fn;\n};\n\nGridCanvas.prototype._notify = function() {\n    if (typeof this._onChange === 'function') {\n        this._onChange(this.getState());\n    }\n};\n\nGridCanvas.prototype.setWall = function(x, y) {\n    if (!this._inBounds(x, y)) return;\n    var type = this.getCellType(x, y);\n    if (type === 'start' || type === 'end') return;\n    this._walls[this._key(x, y)] = true;\n    this._notify();\n};\n\nGridCanvas.prototype.toggleWall = function(x, y) {\n    if (!this._inBounds(x, y)) return;\n    var type = this.getCellType(x, y);\n    if (type === 'start' || type === 'end') return;\n    var k = this._key(x, y);\n    if (this._walls[k]) {\n        delete this._walls[k];\n    } else {\n        this._walls[k] = true;\n    }\n    this._notify();\n};\n\nGridCanvas.prototype.setStart = function(x, y) {\n    if (!this._inBounds(x, y)) return;\n    // Clear previous start\n    this._start = null;\n    // If end is here, clear it\n    if (this._end && this._end.x === x && this._end.y === y) {\n        this._end = null;\n    }\n    // Clear wall if any\n    delete this._walls[this._key(x, y)];\n    this._start = { x: x, y: y };\n    this._notify();\n};\n\nGridCanvas.prototype.setEnd = function(x, y) {\n    if (!this._inBounds(x, y)) return;\n    // Clear previous end\n    this._end = null;\n    // If start is here, clear it\n    if (this._start && this._start.x === x && this._start.y === y) {\n        this._start = null;\n    }\n    // Clear wall if any\n    delete this._walls[this._key(x, y)];\n    this._end = { x: x, y: y };\n    this._notify();\n};\n\nGridCanvas.prototype.getStart = function() {\n    return this._start ? { x: this._start.x, y: this._start.y } : null;\n};\n\nGridCanvas.prototype.getEnd = function() {\n    return this._end ? { x: this._end.x, y: this._end.y } : null;\n};\n\nGridCanvas.prototype.getState = function() {\n    var walls = [];\n    var keys = Object.keys(this._walls);\n    for (var i = 0; i < keys.length; i++) {\n        var parts = keys[i].split(',');\n        walls.push({ x: parseInt(parts[0], 10), y: parseInt(parts[1], 10) });\n    }\n    return {\n        width:  this.width,\n        height: this.height,\n        start:  this._start ? { x: this._start.x, y: this._start.y } : null,\n        end:    this._end   ? { x: this._end.x,   y: this._end.y   } : null,\n        walls:  walls\n    };\n};\n\nGridCanvas.prototype.setState = function(snapshot) {\n    this.reset();\n    if (snapshot.start) this.setStart(snapshot.start.x, snapshot.start.y);\n    if (snapshot.end)   this.setEnd(snapshot.end.x, snapshot.end.y);\n    var walls = snapshot.walls || [];\n    for (var i = 0; i < walls.length; i++) {\n        var w = walls[i];\n        if (this._inBounds(w.x, w.y) && this.getCellType(w.x, w.y) === 'empty') {\n            this._walls[this._key(w.x, w.y)] = true;\n        }\n    }\n    this._notify();\n};\n\nGridCanvas.prototype.toMatrix = function() {\n    var matrix = [];\n    for (var y = 0; y < this.height; y++) {\n        matrix[y] = [];\n        for (var x = 0; x < this.width; x++) {\n            matrix[y][x] = this._walls[this._key(x, y)] ? 1 : 0;\n        }\n    }\n    return matrix;\n};\n\nGridCanvas.prototype.reset = function() {\n    this._walls = {};\n    this._start = null;\n    this._end   = null;\n    this._notify();\n};\n\nmodule.exports = GridCanvas;\n","numLines":160,"startLine":1,"totalLines":160}}}
