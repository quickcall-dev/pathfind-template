{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pq2xnewZddKp3XodLRm1nj","type":"tool_result","content":"1\t'use strict';\n2\t\n3\t/**\n4\t * GridCanvas — pure model for a 15x15 interactive pathfinding grid.\n5\t *\n6\t * Cell types: 'empty' | 'wall' | 'start' | 'end'\n7\t *\n8\t * API:\n9\t *   getCellType(x, y)       → string\n10\t *   toggleWall(x, y)        → void\n11\t *   setStart(x, y)          → void\n12\t *   setEnd(x, y)            → void\n13\t *   getStart()              → {x,y} | null\n14\t *   getEnd()                → {x,y} | null\n15\t *   getState()              → snapshot {width, height, start, end, walls}\n16\t *   setState(snapshot)      → void\n17\t *   toMatrix()              → number[][] (0=walkable, 1=wall)\n18\t *   reset()                 → void\n19\t */\n20\tfunction GridCanvas(width, height) {\n21\t    this.width  = width  || 15;\n22\t    this.height = height || 15;\n23\t    this._walls = {};   // key: \"x,y\"\n24\t    this._start = null; // {x, y}\n25\t    this._end   = null; // {x, y}\n26\t    this._onChange = null; // optional callback(state)\n27\t}\n28\t\n29\tGridCanvas.prototype._key = function(x, y) {\n30\t    return x + ',' + y;\n31\t};\n32\t\n33\tGridCanvas.prototype._inBounds = function(x, y) {\n34\t    return x >= 0 && x < this.width && y >= 0 && y < this.height;\n35\t};\n36\t\n37\tGridCanvas.prototype.getCellType = function(x, y) {\n38\t    if (this._start && this._start.x === x && this._start.y === y) return 'start';\n39\t    if (this._end   && this._end.x   === x && this._end.y   === y) return 'end';\n40\t    if (this._walls[this._key(x, y)]) return 'wall';\n41\t    return 'empty';\n42\t};\n43\t\n44\tGridCanvas.prototype.onChange = function(fn) {\n45\t    this._onChange = fn;\n46\t};\n47\t\n48\tGridCanvas.prototype._notify = function() {\n49\t    if (typeof this._onChange === 'function') {\n50\t        this._onChange(this.getState());\n51\t    }\n52\t};\n53\t\n54\tGridCanvas.prototype.setWall = function(x, y) {\n55\t    if (!this._inBounds(x, y)) return;\n56\t    var type = this.getCellType(x, y);\n57\t    if (type === 'start' || type === 'end') return;\n58\t    this._walls[this._key(x, y)] = true;\n59\t    this._notify();\n60\t};\n61\t\n62\tGridCanvas.prototype.toggleWall = function(x, y) {\n63\t    if (!this._inBounds(x, y)) return;\n64\t    var type = this.getCellType(x, y);\n65\t    if (type === 'start' || type === 'end') return;\n66\t    var k = this._key(x, y);\n67\t    if (this._walls[k]) {\n68\t        delete this._walls[k];\n69\t    } else {\n70\t        this._walls[k] = true;\n71\t    }\n72\t    this._notify();\n73\t};\n74\t\n75\tGridCanvas.prototype.setStart = function(x, y) {\n76\t    if (!this._inBounds(x, y)) return;\n77\t    // Clear previous start\n78\t    this._start = null;\n79\t    // If end is here, clear it\n80\t    if (this._end && this._end.x === x && this._end.y === y) {\n81\t        this._end = null;\n82\t    }\n83\t    // Clear wall if any\n84\t    delete this._walls[this._key(x, y)];\n85\t    this._start = { x: x, y: y };\n86\t    this._notify();\n87\t};\n88\t\n89\tGridCanvas.prototype.setEnd = function(x, y) {\n90\t    if (!this._inBounds(x, y)) return;\n91\t    // Clear previous end\n92\t    this._end = null;\n93\t    // If start is here, clear it\n94\t    if (this._start && this._start.x === x && this._start.y === y) {\n95\t        this._start = null;\n96\t    }\n97\t    // Clear wall if any\n98\t    delete this._walls[this._key(x, y)];\n99\t    this._end = { x: x, y: y };\n100\t    this._notify();\n101\t};\n102\t\n103\tGridCanvas.prototype.getStart = function() {\n104\t    return this._start ? { x: this._start.x, y: this._start.y } : null;\n105\t};\n106\t\n107\tGridCanvas.prototype.getEnd = function() {\n108\t    return this._end ? { x: this._end.x, y: this._end.y } : null;\n109\t};\n110\t\n111\tGridCanvas.prototype.getState = function() {\n112\t    var walls = [];\n113\t    var keys = Object.keys(this._walls);\n114\t    for (var i = 0; i < keys.length; i++) {\n115\t        var parts = keys[i].split(',');\n116\t        walls.push({ x: parseInt(parts[0], 10), y: parseInt(parts[1], 10) });\n117\t    }\n118\t    return {\n119\t        width:  this.width,\n120\t        height: this.height,\n121\t        start:  this._start ? { x: this._start.x, y: this._start.y } : null,\n122\t        end:    this._end   ? { x: this._end.x,   y: this._end.y   } : null,\n123\t        walls:  walls\n124\t    };\n125\t};\n126\t\n127\tGridCanvas.prototype.setState = function(snapshot) {\n128\t    this.reset();\n129\t    if (snapshot.start) this.setStart(snapshot.start.x, snapshot.start.y);\n130\t    if (snapshot.end)   this.setEnd(snapshot.end.x, snapshot.end.y);\n131\t    var walls = snapshot.walls || [];\n132\t    for (var i = 0; i < walls.length; i++) {\n133\t        var w = walls[i];\n134\t        if (this._inBounds(w.x, w.y) && this.getCellType(w.x, w.y) === 'empty') {\n135\t            this._walls[this._key(w.x, w.y)] = true;\n136\t        }\n137\t    }\n138\t    this._notify();\n139\t};\n140\t\n141\tGridCanvas.prototype.toMatrix = function() {\n142\t    var matrix = [];\n143\t    for (var y = 0; y < this.height; y++) {\n144\t        matrix[y] = [];\n145\t        for (var x = 0; x < this.width; x++) {\n146\t            matrix[y][x] = this._walls[this._key(x, y)] ? 1 : 0;\n147\t        }\n148\t    }\n149\t    return matrix;\n150\t};\n151\t\n152\tGridCanvas.prototype.reset = function() {\n153\t    this._walls = {};\n154\t    this._start = null;\n155\t    this._end   = null;\n156\t    this._notify();\n157\t};\n158\t\n159\tmodule.exports = GridCanvas;\n160\t"}]},"parent_tool_use_id":null,"session_id":"40303421-34a1-4e10-bbe6-47f3bba038c9","uuid":"67c5eab0-b0da-411b-b0a2-0f7a723f7cad","timestamp":"2026-04-16T15:38:31.384Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/docs/experiments/001-demo-artifacts/fleets/fleet-02-scenario-builder/workers/canvas-worker/output/GridCanvas.js","content":"'use strict';\n\n/**\n * GridCanvas — pure model for a 15x15 interactive pathfinding grid.\n *\n * Cell types: 'empty' | 'wall' | 'start' | 'end'\n *\n * API:\n *   getCellType(x, y)       → string\n *   toggleWall(x, y)        → void\n *   setStart(x, y)          → void\n *   setEnd(x, y)            → void\n *   getStart()              → {x,y} | null\n *   getEnd()                → {x,y} | null\n *   getState()              → snapshot {width, height, start, end, walls}\n *   setState(snapshot)      → void\n *   toMatrix()              → number[][] (0=walkable, 1=wall)\n *   reset()                 → void\n */\nfunction GridCanvas(width, height) {\n    this.width  = width  || 15;\n    this.height = height || 15;\n    this._walls = {};   // key: \"x,y\"\n    this._start = null; // {x, y}\n    this._end   = null; // {x, y}\n    this._onChange = null; // optional callback(state)\n}\n\nGridCanvas.prototype._key = function(x, y) {\n    return x + ',' + y;\n};\n\nGridCanvas.prototype._inBounds = function(x, y) {\n    return x >= 0 && x < this.width && y >= 0 && y < this.height;\n};\n\nGridCanvas.prototype.getCellType = function(x, y) {\n    if (this._start && this._start.x === x && this._start.y === y) return 'start';\n    if (this._end   && this._end.x   === x && this._end.y   === y) return 'end';\n    if (this._walls[this._key(x, y)]) return 'wall';\n    return 'empty';\n};\n\nGridCanvas.prototype.onChange = function(fn) {\n    this._onChange = fn;\n};\n\nGridCanvas.prototype._notify = function() {\n    if (typeof this._onChange === 'function') {\n        this._onChange(this.getState());\n    }\n};\n\nGridCanvas.prototype.setWall = function(x, y) {\n    if (!this._inBounds(x, y)) return;\n    var type = this.getCellType(x, y);\n    if (type === 'start' || type === 'end') return;\n    this._walls[this._key(x, y)] = true;\n    this._notify();\n};\n\nGridCanvas.prototype.toggleWall = function(x, y) {\n    if (!this._inBounds(x, y)) return;\n    var type = this.getCellType(x, y);\n    if (type === 'start' || type === 'end') return;\n    var k = this._key(x, y);\n    if (this._walls[k]) {\n        delete this._walls[k];\n    } else {\n        this._walls[k] = true;\n    }\n    this._notify();\n};\n\nGridCanvas.prototype.setStart = function(x, y) {\n    if (!this._inBounds(x, y)) return;\n    // Clear previous start\n    this._start = null;\n    // If end is here, clear it\n    if (this._end && this._end.x === x && this._end.y === y) {\n        this._end = null;\n    }\n    // Clear wall if any\n    delete this._walls[this._key(x, y)];\n    this._start = { x: x, y: y };\n    this._notify();\n};\n\nGridCanvas.prototype.setEnd = function(x, y) {\n    if (!this._inBounds(x, y)) return;\n    // Clear previous end\n    this._end = null;\n    // If start is here, clear it\n    if (this._start && this._start.x === x && this._start.y === y) {\n        this._start = null;\n    }\n    // Clear wall if any\n    delete this._walls[this._key(x, y)];\n    this._end = { x: x, y: y };\n    this._notify();\n};\n\nGridCanvas.prototype.getStart = function() {\n    return this._start ? { x: this._start.x, y: this._start.y } : null;\n};\n\nGridCanvas.prototype.getEnd = function() {\n    return this._end ? { x: this._end.x, y: this._end.y } : null;\n};\n\nGridCanvas.prototype.getState = function() {\n    var walls = [];\n    var keys = Object.keys(this._walls);\n    for (var i = 0; i < keys.length; i++) {\n        var parts = keys[i].split(',');\n        walls.push({ x: parseInt(parts[0], 10), y: parseInt(parts[1], 10) });\n    }\n    return {\n        width:  this.width,\n        height: this.height,\n        start:  this._start ? { x: this._start.x, y: this._start.y } : null,\n        end:    this._end   ? { x: this._end.x,   y: this._end.y   } : null,\n        walls:  walls\n    };\n};\n\nGridCanvas.prototype.setState = function(snapshot) {\n    this.reset();\n    if (snapshot.start) this.setStart(snapshot.start.x, snapshot.start.y);\n    if (snapshot.end)   this.setEnd(snapshot.end.x, snapshot.end.y);\n    var walls = snapshot.walls || [];\n    for (var i = 0; i < walls.length; i++) {\n        var w = walls[i];\n        if (this._inBounds(w.x, w.y) && this.getCellType(w.x, w.y) === 'empty') {\n            this._walls[this._key(w.x, w.y)] = true;\n        }\n    }\n    this._notify();\n};\n\nGridCanvas.prototype.toMatrix = function() {\n    var matrix = [];\n    for (var y = 0; y < this.height; y++) {\n        matrix[y] = [];\n        for (var x = 0; x < this.width; x++) {\n            matrix[y][x] = this._walls[this._key(x, y)] ? 1 : 0;\n        }\n    }\n    return matrix;\n};\n\nGridCanvas.prototype.reset = function() {\n    this._walls = {};\n    this._start = null;\n    this._end   = null;\n    this._notify();\n};\n\nmodule.exports = GridCanvas;\n","numLines":160,"startLine":1,"totalLines":160}}}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01M3SKczih8KbMW5yewtVfhf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MvLC35oqguyKKuTSXWEBJw","name":"Read","input":{"file_path":"/home/sagar/template-repo/docs/experiments/001-demo-artifacts/fleets/fleet-02-scenario-builder/workers/canvas-worker/output/GridCanvas.test.js"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":295,"cache_read_input_tokens":17496,"cache_creation":{"ephemeral_5m_input_tokens":295,"ephemeral_1h_input_tokens":0},"output_tokens":65,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"40303421-34a1-4e10-bbe6-47f3bba038c9","uuid":"e28b8936-2842-4061-86c3-e51fdff29f92"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MvLC35oqguyKKuTSXWEBJw","type":"tool_result","content":"1\t'use strict';\n2\t\n3\tvar should = require('should');\n4\tvar GridCanvas = require('./GridCanvas');\n5\t\n6\tdescribe('GridCanvas', function() {\n7\t\n8\t    describe('initialization', function() {\n9\t        it('should create a 15x15 grid by default', function() {\n10\t            var gc = new GridCanvas();\n11\t            gc.width.should.equal(15);\n12\t            gc.height.should.equal(15);\n13\t        });\n14\t\n15\t        it('should accept custom dimensions', function() {\n16\t            var gc = new GridCanvas(10, 8);\n17\t            gc.width.should.equal(10);\n18\t            gc.height.should.equal(8);\n19\t        });\n20\t\n21\t        it('should initialize all cells as empty', function() {\n22\t            var gc = new GridCanvas();\n23\t            for (var y = 0; y < 15; y++) {\n24\t                for (var x = 0; x < 15; x++) {\n25\t                    gc.getCellType(x, y).should.equal('empty');\n26\t                }\n27\t            }\n28\t        });\n29\t\n30\t        it('should have no start or end points initially', function() {\n31\t            var gc = new GridCanvas();\n32\t            should(gc.getStart()).be.null();\n33\t            should(gc.getEnd()).be.null();\n34\t        });\n35\t    });\n36\t\n37\t    describe('wall toggling', function() {\n38\t        var gc;\n39\t        beforeEach(function() { gc = new GridCanvas(); });\n40\t\n41\t        it('should toggle empty cell to wall', function() {\n42\t            gc.toggleWall(3, 4);\n43\t            gc.getCellType(3, 4).should.equal('wall');\n44\t        });\n45\t\n46\t        it('should toggle wall back to empty', function() {\n47\t            gc.toggleWall(3, 4);\n48\t            gc.toggleWall(3, 4);\n49\t            gc.getCellType(3, 4).should.equal('empty');\n50\t        });\n51\t\n52\t        it('should not toggle wall on start cell', function() {\n53\t            gc.setStart(2, 2);\n54\t            gc.toggleWall(2, 2);\n55\t            gc.getCellType(2, 2).should.equal('start');\n56\t        });\n57\t\n58\t        it('should not toggle wall on end cell', function() {\n59\t            gc.setEnd(5, 5);\n60\t            gc.toggleWall(5, 5);\n61\t            gc.getCellType(5, 5).should.equal('end');\n62\t        });\n63\t\n64\t        it('should ignore out-of-bounds coordinates', function() {\n65\t            (function() { gc.toggleWall(-1, 0); }).should.not.throw();\n66\t            (function() { gc.toggleWall(0, 15); }).should.not.throw();\n67\t            (function() { gc.toggleWall(15, 0); }).should.not.throw();\n68\t        });\n69\t    });\n70\t\n71\t    describe('start/end placement', function() {\n72\t        var gc;\n73\t        beforeEach(function() { gc = new GridCanvas(); });\n74\t\n75\t        it('should set start point', function() {\n76\t            gc.setStart(1, 2);\n77\t            gc.getCellType(1, 2).should.equal('start');\n78\t            gc.getStart().should.deepEqual({ x: 1, y: 2 });\n79\t        });\n80\t\n81\t        it('should set end point', function() {\n82\t            gc.setEnd(7, 8);\n83\t            gc.getCellType(7, 8).should.equal('end');\n84\t            gc.getEnd().should.deepEqual({ x: 7, y: 8 });\n85\t        });\n86\t\n87\t        it('should move start to new position', function() {\n88\t            gc.setStart(1, 1);\n89\t            gc.setStart(5, 5);\n90\t            gc.getCellType(1, 1).should.equal('empty');\n91\t            gc.getCellType(5, 5).should.equal('start');\n92\t        });\n93\t\n94\t        it('should move end to new position', function() {\n95\t            gc.setEnd(1, 1);\n96\t            gc.setEnd(9, 9);\n97\t            gc.getCellType(1, 1).should.equal('empty');\n98\t            gc.getCellType(9, 9).should.equal('end');\n99\t        });\n100\t\n101\t        it('should clear wall when start placed on it', function() {\n102\t            gc.toggleWall(3, 3);\n103\t            gc.setStart(3, 3);\n104\t            gc.getCellType(3, 3).should.equal('start');\n105\t        });\n106\t\n107\t        it('should clear wall when end placed on it', function() {\n108\t            gc.toggleWall(6, 6);\n109\t            gc.setEnd(6, 6);\n110\t            gc.getCellType(6, 6).should.equal('end');\n111\t        });\n112\t\n113\t        it('should not allow start and end on same cell', function() {\n114\t            gc.setStart(4, 4);\n115\t            gc.setEnd(4, 4);\n116\t            gc.getCellType(4, 4).should.equal('end');\n117\t            should(gc.getStart()).be.null();\n118\t        });\n119\t\n120\t        it('should ignore out-of-bounds for start', function() {\n121\t            (function() { gc.setStart(-1, 0); }).should.not.throw();\n122\t            should(gc.getStart()).be.null();\n123\t        });\n124\t\n125\t        it('should ignore out-of-bounds for end', function() {\n126\t            (function() { gc.setEnd(0, 20); }).should.not.throw();\n127\t            should(gc.getEnd()).be.null();\n128\t        });\n129\t    });\n130\t\n131\t    describe('getState', function() {\n132\t        it('should return full grid state', function() {\n133\t            var gc = new GridCanvas();\n134\t            gc.setStart(0, 0);\n135\t            gc.setEnd(14, 14);\n136\t            gc.toggleWall(7, 7);\n137\t\n138\t            var state = gc.getState();\n139\t            state.width.should.equal(15);\n140\t            state.height.should.equal(15);\n141\t            state.start.should.deepEqual({ x: 0, y: 0 });\n142\t            state.end.should.deepEqual({ x: 14, y: 14 });\n143\t            state.walls.should.containEql({ x: 7, y: 7 });\n144\t        });\n145\t\n146\t        it('should return immutable snapshot — mutations do not affect returned state', function() {\n147\t            var gc = new GridCanvas();\n148\t            gc.toggleWall(1, 1);\n149\t            var state = gc.getState();\n150\t            gc.toggleWall(1, 1); // remove wall\n151\t            state.walls.should.containEql({ x: 1, y: 1 });\n152\t        });\n153\t    });\n154\t\n155\t    describe('toMatrix', function() {\n156\t        it('should export 0/1 matrix — walls are 1', function() {\n157\t            var gc = new GridCanvas(3, 3);\n158\t            gc.toggleWall(1, 1);\n159\t            var m = gc.toMatrix();\n160\t            m.length.should.equal(3);\n161\t            m[0].length.should.equal(3);\n162\t            m[1][1].should.equal(1);\n163\t            m[0][0].should.equal(0);\n164\t        });\n165\t\n166\t        it('should treat start and end as walkable (0)', function() {\n167\t            var gc = new GridCanvas(3, 3);\n168\t            gc.setStart(0, 0);\n169\t            gc.setEnd(2, 2);\n170\t            var m = gc.toMatrix();\n171\t            m[0][0].should.equal(0);\n172\t            m[2][2].should.equal(0);\n173\t        });\n174\t    });\n175\t\n176\t    describe('reset', function() {\n177\t        it('should clear all walls, start, and end', function() {\n178\t            var gc = new GridCanvas();\n179\t            gc.setStart(0, 0);\n180\t            gc.setEnd(14, 14);\n181\t            gc.toggleWall(5, 5);\n182\t            gc.reset();\n183\t\n184\t            should(gc.getStart()).be.null();\n185\t            should(gc.getEnd()).be.null();\n186\t            gc.getState().walls.length.should.equal(0);\n187\t            gc.getCellType(5, 5).should.equal('empty');\n188\t        });\n189\t    });\n190\t\n191\t    describe('setState', function() {\n192\t        it('should restore state from a snapshot', function() {\n193\t            var gc = new GridCanvas();\n194\t            gc.setStart(1, 1);\n195\t            gc.setEnd(13, 13);\n196\t            gc.toggleWall(3, 3);\n197\t            var snap = gc.getState();\n198\t\n199\t            var gc2 = new GridCanvas();\n200\t            gc2.setState(snap);\n201\t            gc2.getCellType(1, 1).should.equal('start');\n202\t            gc2.getCellType(13, 13).should.equal('end');\n203\t            gc2.getCellType(3, 3).should.equal('wall');\n204\t        });\n205\t    });\n206\t\n207\t    describe('setWall', function() {\n208\t        var gc;\n209\t        beforeEach(function() { gc = new GridCanvas(); });\n210\t\n211\t        it('should directly set a wall without toggling', function() {\n212\t            gc.setWall(5, 5);\n213\t            gc.getCellType(5, 5).should.equal('wall');\n214\t        });\n215\t\n216\t        it('should not unset an existing wall', function() {\n217\t            gc.setWall(5, 5);\n218\t            gc.setWall(5, 5); // second call keeps wall\n219\t            gc.getCellType(5, 5).should.equal('wall');\n220\t        });\n221\t\n222\t        it('should not overwrite start cell', function() {\n223\t            gc.setStart(2, 2);\n224\t            gc.setWall(2, 2);\n225\t            gc.getCellType(2, 2).should.equal('start');\n226\t        });\n227\t\n228\t        it('should not overwrite end cell', function() {\n229\t            gc.setEnd(8, 8);\n230\t            gc.setWall(8, 8);\n231\t            gc.getCellType(8, 8).should.equal('end');\n232\t        });\n233\t\n234\t        it('should ignore out-of-bounds', function() {\n235\t            (function() { gc.setWall(20, 0); }).should.not.throw();\n236\t        });\n237\t    });\n238\t\n239\t    describe('onChange', function() {\n240\t        it('should fire callback after toggleWall', function() {\n241\t            var gc = new GridCanvas();\n242\t            var fired = 0;\n243\t            gc.onChange(function() { fired++; });\n244\t            gc.toggleWall(1, 1);\n245\t            fired.should.equal(1);\n246\t        });\n247\t\n248\t        it('should fire callback after setStart', function() {\n249\t            var gc = new GridCanvas();\n250\t            var fired = 0;\n251\t            gc.onChange(function() { fired++; });\n252\t            gc.setStart(0, 0);\n253\t            fired.should.equal(1);\n254\t        });\n255\t\n256\t        it('should fire callback after setEnd', function() {\n257\t            var gc = new GridCanvas();\n258\t            var fired = 0;\n259\t            gc.onChange(function() { fired++; });\n260\t            gc.setEnd(14, 14);\n261\t            fired.should.equal(1);\n262\t        });\n263\t\n264\t        it('should fire callback after reset', function() {\n265\t            var gc = new GridCanvas();\n266\t            var fired = 0;\n267\t            gc.onChange(function() { fired++; });\n268\t            gc.reset();\n269\t            fired.should.equal(1);\n270\t        });\n271\t\n272\t        it('should pass current state snapshot to callback', function() {\n273\t            var gc = new GridCanvas();\n274\t            var received;\n275\t            gc.onChange(function(state) { received = state; });\n276\t            gc.setStart(3, 3);\n277\t            received.start.should.deepEqual({ x: 3, y: 3 });\n278\t        });\n279\t    });\n280\t\n281\t});\n282\t"}]},"parent_tool_use_id":null,"session_id":"40303421-34a1-4e10-bbe6-47f3bba038c9","uuid":"172d7c9d-4de5-47fc-b7d2-21f7f34b1a1a","timestamp":"2026-04-16T15:38:31.740Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/docs/experiments/001-demo-artifacts/fleets/fleet-02-scenario-builder/workers/canvas-worker/output/GridCanvas.test.js","content":"'use strict';\n\nvar should = require('should');\nvar GridCanvas = require('./GridCanvas');\n\ndescribe('GridCanvas', function() {\n\n    describe('initialization', function() {\n        it('should create a 15x15 grid by default', function() {\n            var gc = new GridCanvas();\n            gc.width.should.equal(15);\n            gc.height.should.equal(15);\n        });\n\n        it('should accept custom dimensions', function() {\n            var gc = new GridCanvas(10, 8);\n            gc.width.should.equal(10);\n            gc.height.should.equal(8);\n        });\n\n        it('should initialize all cells as empty', function() {\n            var gc = new GridCanvas();\n            for (var y = 0; y < 15; y++) {\n                for (var x = 0; x < 15; x++) {\n                    gc.getCellType(x, y).should.equal('empty');\n                }\n            }\n        });\n\n        it('should have no start or end points initially', function() {\n            var gc = new GridCanvas();\n            should(gc.getStart()).be.null();\n            should(gc.getEnd()).be.null();\n        });\n    });\n\n    describe('wall toggling', function() {\n        var gc;\n        beforeEach(function() { gc = new GridCanvas(); });\n\n        it('should toggle empty cell to wall', function() {\n            gc.toggleWall(3, 4);\n            gc.getCellType(3, 4).should.equal('wall');\n        });\n\n        it('should toggle wall back to empty', function() {\n            gc.toggleWall(3, 4);\n            gc.toggleWall(3, 4);\n            gc.getCellType(3, 4).should.equal('empty');\n        });\n\n        it('should not toggle wall on start cell', function() {\n            gc.setStart(2, 2);\n            gc.toggleWall(2, 2);\n            gc.getCellType(2, 2).should.equal('start');\n        });\n\n        it('should not toggle wall on end cell', function() {\n            gc.setEnd(5, 5);\n            gc.toggleWall(5, 5);\n            gc.getCellType(5, 5).should.equal('end');\n        });\n\n        it('should ignore out-of-bounds coordinates', function() {\n            (function() { gc.toggleWall(-1, 0); }).should.not.throw();\n            (function() { gc.toggleWall(0, 15); }).should.not.throw();\n            (function() { gc.toggleWall(15, 0); }).should.not.throw();\n        });\n    });\n\n    describe('start/end placement', function() {\n        var gc;\n        beforeEach(function() { gc = new GridCanvas(); });\n\n        it('should set start point', function() {\n            gc.setStart(1, 2);\n            gc.getCellType(1, 2).should.equal('start');\n            gc.getStart().should.deepEqual({ x: 1, y: 2 });\n        });\n\n        it('should set end point', function() {\n            gc.setEnd(7, 8);\n            gc.getCellType(7, 8).should.equal('end');\n            gc.getEnd().should.deepEqual({ x: 7, y: 8 });\n        });\n\n        it('should move start to new position', function() {\n            gc.setStart(1, 1);\n            gc.setStart(5, 5);\n            gc.getCellType(1, 1).should.equal('empty');\n            gc.getCellType(5, 5).should.equal('start');\n        });\n\n        it('should move end to new position', function() {\n            gc.setEnd(1, 1);\n            gc.setEnd(9, 9);\n            gc.getCellType(1, 1).should.equal('empty');\n            gc.getCellType(9, 9).should.equal('end');\n        });\n\n        it('should clear wall when start placed on it', function() {\n            gc.toggleWall(3, 3);\n            gc.setStart(3, 3);\n            gc.getCellType(3, 3).should.equal('start');\n        });\n\n        it('should clear wall when end placed on it', function() {\n            gc.toggleWall(6, 6);\n            gc.setEnd(6, 6);\n            gc.getCellType(6, 6).should.equal('end');\n        });\n\n        it('should not allow start and end on same cell', function() {\n            gc.setStart(4, 4);\n            gc.setEnd(4, 4);\n            gc.getCellType(4, 4).should.equal('end');\n            should(gc.getStart()).be.null();\n        });\n\n        it('should ignore out-of-bounds for start', function() {\n            (function() { gc.setStart(-1, 0); }).should.not.throw();\n            should(gc.getStart()).be.null();\n        });\n\n        it('should ignore out-of-bounds for end', function() {\n            (function() { gc.setEnd(0, 20); }).should.not.throw();\n            should(gc.getEnd()).be.null();\n        });\n    });\n\n    describe('getState', function() {\n        it('should return full grid state', function() {\n            var gc = new GridCanvas();\n            gc.setStart(0, 0);\n            gc.setEnd(14, 14);\n            gc.toggleWall(7, 7);\n\n            var state = gc.getState();\n            state.width.should.equal(15);\n            state.height.should.equal(15);\n            state.start.should.deepEqual({ x: 0, y: 0 });\n            state.end.should.deepEqual({ x: 14, y: 14 });\n            state.walls.should.containEql({ x: 7, y: 7 });\n        });\n\n        it('should return immutable snapshot — mutations do not affect returned state', function() {\n            var gc = new GridCanvas();\n            gc.toggleWall(1, 1);\n            var state = gc.getState();\n            gc.toggleWall(1, 1); // remove wall\n            state.walls.should.containEql({ x: 1, y: 1 });\n        });\n    });\n\n    describe('toMatrix', function() {\n        it('should export 0/1 matrix — walls are 1', function() {\n            var gc = new GridCanvas(3, 3);\n            gc.toggleWall(1, 1);\n            var m = gc.toMatrix();\n            m.length.should.equal(3);\n            m[0].length.should.equal(3);\n            m[1][1].should.equal(1);\n            m[0][0].should.equal(0);\n        });\n\n        it('should treat start and end as walkable (0)', function() {\n            var gc = new GridCanvas(3, 3);\n            gc.setStart(0, 0);\n            gc.setEnd(2, 2);\n            var m = gc.toMatrix();\n            m[0][0].should.equal(0);\n            m[2][2].should.equal(0);\n        });\n    });\n\n    describe('reset', function() {\n        it('should clear all walls, start, and end', function() {\n            var gc = new GridCanvas();\n            gc.setStart(0, 0);\n            gc.setEnd(14, 14);\n            gc.toggleWall(5, 5);\n            gc.reset();\n\n            should(gc.getStart()).be.null();\n            should(gc.getEnd()).be.null();\n            gc.getState().walls.length.should.equal(0);\n            gc.getCellType(5, 5).should.equal('empty');\n        });\n    });\n\n    describe('setState', function() {\n        it('should restore state from a snapshot', function() {\n            var gc = new GridCanvas();\n            gc.setStart(1, 1);\n            gc.setEnd(13, 13);\n            gc.toggleWall(3, 3);\n            var snap = gc.getState();\n\n            var gc2 = new GridCanvas();\n            gc2.setState(snap);\n            gc2.getCellType(1, 1).should.equal('start');\n            gc2.getCellType(13, 13).should.equal('end');\n            gc2.getCellType(3, 3).should.equal('wall');\n        });\n    });\n\n    describe('setWall', function() {\n        var gc;\n        beforeEach(function() { gc = new GridCanvas(); });\n\n        it('should directly set a wall without toggling', function() {\n            gc.setWall(5, 5);\n            gc.getCellType(5, 5).should.equal('wall');\n        });\n\n        it('should not unset an existing wall', function() {\n            gc.setWall(5, 5);\n            gc.setWall(5, 5); // second call keeps wall\n            gc.getCellType(5, 5).should.equal('wall');\n        });\n\n        it('should not overwrite start cell', function() {\n            gc.setStart(2, 2);\n            gc.setWall(2, 2);\n            gc.getCellType(2, 2).should.equal('start');\n        });\n\n        it('should not overwrite end cell', function() {\n            gc.setEnd(8, 8);\n            gc.setWall(8, 8);\n            gc.getCellType(8, 8).should.equal('end');\n        });\n\n        it('should ignore out-of-bounds', function() {\n            (function() { gc.setWall(20, 0); }).should.not.throw();\n        });\n    });\n\n    describe('onChange', function() {\n        it('should fire callback after toggleWall', function() {\n            var gc = new GridCanvas();\n            var fired = 0;\n            gc.onChange(function() { fired++; });\n            gc.toggleWall(1, 1);\n            fired.should.equal(1);\n        });\n\n        it('should fire callback after setStart', function() {\n            var gc = new GridCanvas();\n            var fired = 0;\n            gc.onChange(function() { fired++; });\n            gc.setStart(0, 0);\n            fired.should.equal(1);\n        });\n\n        it('should fire callback after setEnd', function() {\n            var gc = new GridCanvas();\n            var fired = 0;\n            gc.onChange(function() { fired++; });\n            gc.setEnd(14, 14);\n            fired.should.equal(1);\n        });\n\n        it('should fire callback after reset', function() {\n            var gc = new GridCanvas();\n            var fired = 0;\n            gc.onChange(function() { fired++; });\n            gc.reset();\n            fired.should.equal(1);\n        });\n\n        it('should pass current state snapshot to callback', function() {\n            var gc = new GridCanvas();\n            var received;\n            gc.onChange(function(state) { received = state; });\n            gc.setStart(3, 3);\n            received.start.should.deepEqual({ x: 3, y: 3 });\n        });\n    });\n\n});\n","numLines":282,"startLine":1,"totalLines":282}}}
