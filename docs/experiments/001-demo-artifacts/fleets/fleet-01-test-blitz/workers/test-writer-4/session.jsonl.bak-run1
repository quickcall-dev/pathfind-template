{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SRNcccfeZbwf8Bf2fyGhNa","type":"tool_result","content":"1\t/**\n2\t * @author imor / https://github.com/imor\n3\t */\n4\tvar JumpPointFinderBase = require('./JumpPointFinderBase');\n5\tvar DiagonalMovement = require('../core/DiagonalMovement');\n6\t\n7\t/**\n8\t * Path finder using the Jump Point Search algorithm allowing only horizontal\n9\t * or vertical movements.\n10\t */\n11\tfunction JPFNeverMoveDiagonally(opt) {\n12\t    JumpPointFinderBase.call(this, opt);\n13\t}\n14\t\n15\tJPFNeverMoveDiagonally.prototype = new JumpPointFinderBase();\n16\tJPFNeverMoveDiagonally.prototype.constructor = JPFNeverMoveDiagonally;\n17\t\n18\t/**\n19\t * Search recursively in the direction (parent -> child), stopping only when a\n20\t * jump point is found.\n21\t * @protected\n22\t * @return {Array<Array<number>>} The x, y coordinate of the jump point\n23\t *     found, or null if not found\n24\t */\n25\tJPFNeverMoveDiagonally.prototype._jump = function(x, y, px, py) {\n26\t    var grid = this.grid,\n27\t        dx = x - px, dy = y - py;\n28\t\n29\t    if (!grid.isWalkableAt(x, y)) {\n30\t        return null;\n31\t    }\n32\t\n33\t    if(this.trackJumpRecursion === true) {\n34\t        grid.getNodeAt(x, y).tested = true;\n35\t    }\n36\t\n37\t    if (grid.getNodeAt(x, y) === this.endNode) {\n38\t        return [x, y];\n39\t    }\n40\t\n41\t    if (dx !== 0) {\n42\t        if ((grid.isWalkableAt(x, y - 1) && !grid.isWalkableAt(x - dx, y - 1)) ||\n43\t            (grid.isWalkableAt(x, y + 1) && !grid.isWalkableAt(x - dx, y + 1))) {\n44\t            return [x, y];\n45\t        }\n46\t    }\n47\t    else if (dy !== 0) {\n48\t        if ((grid.isWalkableAt(x - 1, y) && !grid.isWalkableAt(x - 1, y - dy)) ||\n49\t            (grid.isWalkableAt(x + 1, y) && !grid.isWalkableAt(x + 1, y - dy))) {\n50\t            return [x, y];\n51\t        }\n52\t        //When moving vertically, must check for horizontal jump points\n53\t        if (this._jump(x + 1, y, x, y) || this._jump(x - 1, y, x, y)) {\n54\t            return [x, y];\n55\t        }\n56\t    }\n57\t    else {\n58\t        throw new Error(\"Only horizontal and vertical movements are allowed\");\n59\t    }\n60\t\n61\t    return this._jump(x + dx, y + dy, x, y);\n62\t};\n63\t\n64\t/**\n65\t * Find the neighbors for the given node. If the node has a parent,\n66\t * prune the neighbors based on the jump point search algorithm, otherwise\n67\t * return all available neighbors.\n68\t * @return {Array<Array<number>>} The neighbors found.\n69\t */\n70\tJPFNeverMoveDiagonally.prototype._findNeighbors = function(node) {\n71\t    var parent = node.parent,\n72\t        x = node.x, y = node.y,\n73\t        grid = this.grid,\n74\t        px, py, nx, ny, dx, dy,\n75\t        neighbors = [], neighborNodes, neighborNode, i, l;\n76\t\n77\t    // directed pruning: can ignore most neighbors, unless forced.\n78\t    if (parent) {\n79\t        px = parent.x;\n80\t        py = parent.y;\n81\t        // get the normalized direction of travel\n82\t        dx = (x - px) / Math.max(Math.abs(x - px), 1);\n83\t        dy = (y - py) / Math.max(Math.abs(y - py), 1);\n84\t\n85\t        if (dx !== 0) {\n86\t            if (grid.isWalkableAt(x, y - 1)) {\n87\t                neighbors.push([x, y - 1]);\n88\t            }\n89\t            if (grid.isWalkableAt(x, y + 1)) {\n90\t                neighbors.push([x, y + 1]);\n91\t            }\n92\t            if (grid.isWalkableAt(x + dx, y)) {\n93\t                neighbors.push([x + dx, y]);\n94\t            }\n95\t        }\n96\t        else if (dy !== 0) {\n97\t            if (grid.isWalkableAt(x - 1, y)) {\n98\t                neighbors.push([x - 1, y]);\n99\t            }\n100\t            if (grid.isWalkableAt(x + 1, y)) {\n101\t                neighbors.push([x + 1, y]);\n102\t            }\n103\t            if (grid.isWalkableAt(x, y + dy)) {\n104\t                neighbors.push([x, y + dy]);\n105\t 