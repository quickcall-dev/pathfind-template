{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016nm1bdDzTinVBaqmTpAMc3","type":"tool_result","content":"1\t/**\n2\t * @author imor / https://github.com/imor\n3\t */\n4\tvar Heap       = require('heap');\n5\tvar Util       = require('../core/Util');\n6\tvar Heuristic  = require('../core/Heuristic');\n7\tvar DiagonalMovement = require('../core/DiagonalMovement');\n8\t\n9\t/**\n10\t * Base class for the Jump Point Search algorithm\n11\t * @param {object} opt\n12\t * @param {function} opt.heuristic Heuristic function to estimate the distance\n13\t *     (defaults to manhattan).\n14\t */\n15\tfunction JumpPointFinderBase(opt) {\n16\t    opt = opt || {};\n17\t    this.heuristic = opt.heuristic || Heuristic.manhattan;\n18\t    this.trackJumpRecursion = opt.trackJumpRecursion || false;\n19\t}\n20\t\n21\t/**\n22\t * Find and return the path.\n23\t * @return {Array<Array<number>>} The path, including both start and\n24\t *     end positions.\n25\t */\n26\tJumpPointFinderBase.prototype.findPath = function(startX, startY, endX, endY, grid) {\n27\t    var openList = this.openList = new Heap(function(nodeA, nodeB) {\n28\t            return nodeA.f - nodeB.f;\n29\t        }),\n30\t        startNode = this.startNode = grid.getNodeAt(startX, startY),\n31\t        endNode = this.endNode = grid.getNodeAt(endX, endY), node;\n32\t\n33\t    this.grid = grid;\n34\t\n35\t\n36\t    // set the `g` and `f` value of the start node to be 0\n37\t    startNode.g = 0;\n38\t    startNode.f = 0;\n39\t\n40\t    // push the start node into the open list\n41\t    openList.push(startNode);\n42\t    startNode.opened = true;\n43\t\n44\t    // while the open list is not empty\n45\t    while (!openList.empty()) {\n46\t        // pop the position of node which has the minimum `f` value.\n47\t        node = openList.pop();\n48\t        node.closed = true;\n49\t\n50\t        if (node === endNode) {\n51\t            return Util.expandPath(Util.backtrace(endNode));\n52\t        }\n53\t\n54\t        this._identifySuccessors(node);\n55\t    }\n56\t\n57\t    // fail to find the path\n58\t    return [];\n59\t};\n60\t\n61\t/**\n62\t * Identify successors for the given node. Runs a jump point search in the\n63\t * direction of each available neighbor, adding any points found to the open\n64\t * list.\n65\t * @protected\n66\t */\n67\tJumpPointFinderBase.prototype._identifySuccessors = function(node) {\n68\t    var grid = this.grid,\n69\t        heuristic = this.heuristic,\n70\t        openList = this.openList,\n71\t        endX = this.endNode.x,\n72\t        endY = this.endNode.y,\n73\t        neighbors, neighbor,\n74\t        jumpPoint, i, l,\n75\t        x = node.x, y = node.y,\n76\t        jx, jy, dx, dy, d, ng, jumpNode,\n77\t        abs = Math.abs, max = Math.max;\n78\t\n79\t    neighbors = this._findNeighbors(node);\n80\t    for(i = 0, l = neighbors.length; i < l; ++i) {\n81\t        neighbor = neighbors[i];\n82\t        jumpPoint = this._jump(neighbor[0], neighbor[1], x, y);\n83\t        if (jumpPoint) {\n84\t\n85\t            jx = jumpPoint[0];\n86\t            jy = jumpPoint[1];\n87\t            jumpNode = grid.getNodeAt(jx, jy);\n88\t\n89\t            if (jumpNode.closed) {\n90\t                continue;\n91\t            }\n92\t\n93\t            // include distance, as parent may not be immediately adjacent:\n94\t            d = Heuristic.octile(abs(jx - x), abs(jy - y));\n95\t            ng = node.g + d; // next `g` value\n96\t\n97\t            if (!jumpNode.opened || ng < jumpNode.g) {\n98\t                jumpNode.g = ng;\n99\t                jumpNode.h = jumpNode.h || heuristic(abs(jx - endX), abs(jy - endY));\n100\t                jumpNode.f = jumpNode.g + jumpNode.h;\n101\t                jumpNode.parent = node;\n102\t\n103\t                if (!jumpNode.opened) {\n104\t                    openList.push(jumpNode);\n105\t                    jumpNode.opened = true;\n106\t                } else {\n107\t                    openList.updateItem(jumpNode);\n108\t                }\n109\t            }\n110\t        }\n111\t    }\n112\t};\n113\t\n114\tmodule.exports = JumpPointFinderBase;\n115\t"}]},"parent_tool_use_id":null,"session_id":"431bead7-f8d6-4a32-b19f-2263c9e78722","uuid":"2c246c26-cb4d-4ccf-8dc2-44a22e5c9b0a","timestamp":"2026-04-16T13:57:04.982Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/src/finders/JumpPointFinderBase.js","content":"/**\n * @author imor / https://github.com/imor\n */\nvar Heap       = require('heap');\nvar Util       = require('../core/Util');\nvar Heuristic  = require('../core/Heuristic');\nvar DiagonalMovement = require('../core/DiagonalMovement');\n\n/**\n * Base class for the Jump Point Search algorithm\n * @param {object} opt\n * @param {function} opt.heuristic Heuristic function to estimate the distance\n *     (defaults to manhattan).\n */\nfunction JumpPointFinderBase(opt) {\n    opt = opt || {};\n    this.heuristic = opt.heuristic || Heuristic.manhattan;\n    this.trackJumpRecursion = opt.trackJumpRecursion || false;\n}\n\n/**\n * Find and return the path.\n * @return {Array<Array<number>>} The path, including both start and\n *     end positions.\n */\nJumpPointFinderBase.prototype.findPath = function(startX, startY, endX, endY, grid) {\n    var openList = this.openList = new Heap(function(nodeA, nodeB) {\n            return nodeA.f - nodeB.f;\n        }),\n        startNode = this.startNode = grid.getNodeAt(startX, startY),\n        endNode = this.endNode = grid.getNodeAt(endX, endY), node;\n\n    this.grid = grid;\n\n\n    // set the `g` and `f` value of the start node to be 0\n    startNode.g = 0;\n    startNode.f = 0;\n\n    // push the start node into the open list\n    openList.push(startNode);\n    startNode.opened = true;\n\n    // while the open list is not empty\n    while (!openList.empty()) {\n        // pop the position of node which has the minimum `f` value.\n        node = openList.pop();\n        node.closed = true;\n\n        if (node === endNode) {\n            return Util.expandPath(Util.backtrace(endNode));\n        }\n\n        this._identifySuccessors(node);\n    }\n\n    // fail to find the path\n    return [];\n};\n\n/**\n * Identify successors for the given node. Runs a jump point search in the\n * direction of each available neighbor, adding any points found to the open\n * list.\n * @protected\n */\nJumpPointFinderBase.prototype._identifySuccessors = function(node) {\n    var grid = this.grid,\n        heuristic = this.heuristic,\n        openList = this.openList,\n        endX = this.endNode.x,\n        endY = this.endNode.y,\n        neighbors, neighbor,\n        jumpPoint, i, l,\n        x = node.x, y = node.y,\n        jx, jy, dx, dy, d, ng, jumpNode,\n        abs = Math.abs, max = Math.max;\n\n    neighbors = this._findNeighbors(node);\n    for(i = 0, l = neighbors.length; i < l; ++i) {\n        neighbor = neighbors[i];\n        jumpPoint = this._jump(neighbor[0], neighbor[1], x, y);\n        if (jumpPoint) {\n\n            jx = jumpPoint[0];\n            jy = jumpPoint[1];\n            jumpNode = grid.getNodeAt(jx, jy);\n\n            if (jumpNode.closed) {\n                continue;\n            }\n\n            // include distance, as parent may not be immediately adjacent:\n            d = Heuristic.octile(abs(jx - x), abs(jy - y));\n            ng = node.g + d; // next `g` value\n\n            if (!jumpNode.opened || ng < jumpNode.g) {\n                jumpNode.g = ng;\n                jumpNode.h = jumpNode.h || heuristic(abs(jx - endX), abs(jy - endY));\n                jumpNode.f = jumpNode.g + jumpNode.h;\n                jumpNode.parent = node;\n\n                if (!jumpNode.opened) {\n                    openList.push(jumpNode);\n                    jumpNode.opened = true;\n                } else {\n                    openList.updateItem(jumpNode);\n                }\n            }\n        }\n    }\n};\n\nmodule.exports = JumpPointFinderBase;\n","numLines":115,"startLine":1,"totalLines":115}}}
