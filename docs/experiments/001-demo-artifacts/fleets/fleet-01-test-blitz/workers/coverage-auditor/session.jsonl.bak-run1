t should be octile instead\n43\t    if (this.diagonalMovement === DiagonalMovement.Never) {\n44\t        this.heuristic = opt.heuristic || Heuristic.manhattan;\n45\t    } else {\n46\t        this.heuristic = opt.heuristic || Heuristic.octile;\n47\t    }\n48\t}\n49\t\n50\t/**\n51\t * Find and return the the path.\n52\t * @return {Array<Array<number>>} The path, including both start and\n53\t *     end positions.\n54\t */\n55\tBiAStarFinder.prototype.findPath = function(startX, startY, endX, endY, grid) {\n56\t    var cmp = function(nodeA, nodeB) {\n57\t            return nodeA.f - nodeB.f;\n58\t        },\n59\t        startOpenList = new Heap(cmp),\n60\t        endOpenList = new Heap(cmp),\n61\t        startNode = grid.getNodeAt(startX, startY),\n62\t        endNode = grid.getNodeAt(endX, endY),\n63\t        heuristic = this.heuristic,\n64\t        diagonalMovement = this.diagonalMovement,\n65\t        weight = this.weight,\n66\t        abs = Math.abs, SQRT2 = Math.SQRT2,\n67\t        node, neighbors, neighbor, i, l, x, y, ng,\n68\t        BY_START = 1, BY_END = 2;\n69\t\n70\t    // set the `g` and `f` value of the start node to be 0\n71\t    // and push it into the start open list\n72\t    startNode.g = 0;\n73\t    startNode.f = 0;\n74\t    startOpenList.push(startNode);\n75\t    startNode.opened = BY_START;\n76\t\n77\t    // set the `g` and `f` value of the end node to be 0\n78\t    // and push it into the open open list\n79\t    endNode.g = 0;\n80\t    endNode.f = 0;\n81\t    endOpenList.push(endNode);\n82\t    endNode.opened = BY_END;\n83\t\n84\t    // while both the open lists are not empty\n85\t    while (!startOpenList.empty() && !endOpenList.empty()) {\n86\t\n87\t        // pop the position of start node which has the minimum `f` value.\n88\t        node = startOpenList.pop();\n89\t        node.closed = true;\n90\t\n91\t        // get neigbours of the current node\n92\t        neighbors = grid.getNeighbors(node, diagonalMovement);\n93\t        for (i = 0, l =