{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E9U9qspEHKzYdPbZrER6ce","type":"tool_result","content":"1\tvar PF = require('..');\n2\tvar Grid = PF.Grid;\n3\tvar AStarFinder = PF.AStarFinder;\n4\tvar DijkstraFinder = PF.DijkstraFinder;\n5\tvar DiagonalMovement = PF.DiagonalMovement;\n6\tvar Heuristic = PF.Heuristic;\n7\t\n8\t// ---------------------------------------------------------------------------\n9\t// AStarFinder\n10\t// ---------------------------------------------------------------------------\n11\tdescribe('AStarFinder', function() {\n12\t\n13\t    describe('constructor defaults', function() {\n14\t        it('no options → Never diagonal, manhattan heuristic', function() {\n15\t            var f = new AStarFinder();\n16\t            f.diagonalMovement.should.equal(DiagonalMovement.Never);\n17\t            f.heuristic.should.equal(Heuristic.manhattan);\n18\t            f.weight.should.equal(1);\n19\t        });\n20\t    });\n21\t\n22\t    describe('constructor — allowDiagonal flag', function() {\n23\t        it('allowDiagonal:true → IfAtMostOneObstacle + octile', function() {\n24\t            var f = new AStarFinder({ allowDiagonal: true });\n25\t            f.diagonalMovement.should.equal(DiagonalMovement.IfAtMostOneObstacle);\n26\t            f.heuristic.should.equal(Heuristic.octile);\n27\t        });\n28\t\n29\t        it('allowDiagonal:true, dontCrossCorners:true → OnlyWhenNoObstacles', function() {\n30\t            var f = new AStarFinder({ allowDiagonal: true, dontCrossCorners: true });\n31\t            f.diagonalMovement.should.equal(DiagonalMovement.OnlyWhenNoObstacles);\n32\t            f.heuristic.should.equal(Heuristic.octile);\n33\t        });\n34\t    });\n35\t\n36\t    describe('constructor — explicit diagonalMovement', function() {\n37\t        [\n38\t            DiagonalMovement.Never,\n39\t            DiagonalMovement.Always,\n40\t            DiagonalMovement.IfAtMostOneObstacle,\n41\t            DiagonalMovement.OnlyWhenNoObstacles\n42\t        ].forEach(function(dm) {\n43\t            it('diagonalMovement=' + dm + ' stored correctly', function() {\n44\t                var f = new AStarFinder({ diagonalMovement: dm });\n45\t                f.diagonalMovement.should.equal(dm);\n46\t            });\n47\t        });\n48\t\n49\t        it('explicit Never → manhattan heuristic', function() {\n50\t            var f = new AStarFinder({ diagonalMovement: DiagonalMovement.Never });"}]},"parent_tool_use_id":null,"session_id":"fb2c7ec1-8b93-4f0c-93e3-1380bfdce95e","uuid":"1ae04c57-96de-4135-b03d-5ec13f894e70","timestamp":"2026-04-16T14:11:14.265Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/test/AStarFinder.js","content":"var PF = require('..');\nvar Grid = PF.Grid;\nvar AStarFinder = PF.AStarFinder;\nvar DijkstraFinder = PF.DijkstraFinder;\nvar DiagonalMovement = PF.DiagonalMovement;\nvar Heuristic = PF.Heuristic;\n\n// ---------------------------------------------------------------------------\n// AStarFinder\n// ---------------------------------------------------------------------------\ndescribe('AStarFinder', function() {\n\n    describe('constructor defaults', function() {\n        it('no options → Never diagonal, manhattan heuristic', function() {\n            var f = new AStarFinder();\n            f.diagonalMovement.should.equal(DiagonalMovement.Never);\n            f.heuristic.should.equal(Heuristic.manhattan);\n            f.weight.should.equal(1);\n        });\n    });\n\n    describe('constructor — allowDiagonal flag', function() {\n        it('allowDiagonal:true → IfAtMostOneObstacle + octile', function() {\n            var f = new AStarFinder({ allowDiagonal: true });\n            f.diagonalMovement.should.equal(DiagonalMovement.IfAtMostOneObstacle);\n            f.heuristic.should.equal(Heuristic.octile);\n        });\n\n        it('allowDiagonal:true, dontCrossCorners:true → OnlyWhenNoObstacles', function() {\n            var f = new AStarFinder({ allowDiagonal: true, dontCrossCorners: true });\n            f.diagonalMovement.should.equal(DiagonalMovement.OnlyWhenNoObstacles);\n            f.heuristic.should.equal(Heuristic.octile);\n        });\n    });\n\n    describe('constructor — explicit diagonalMovement', function() {\n        [\n            DiagonalMovement.Never,\n            DiagonalMovement.Always,\n            DiagonalMovement.IfAtMostOneObstacle,\n            DiagonalMovement.OnlyWhenNoObstacles\n        ].forEach(function(dm) {\n            it('diagonalMovement=' + dm + ' stored correctly', function() {\n                var f = new AStarFinder({ diagonalMovement: dm });\n                f.diagonalMovement.should.equal(dm);\n            });\n        });\n\n        it('explicit Never → manhattan heuristic', function() {\n            var f = new AStarFinder({ diagonalMovement: DiagonalMovement.Never });","numLines":50,"startLine":1,"totalLines":240}}}
