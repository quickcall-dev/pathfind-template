{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JS2UTbCynVe16bEocoWz7c","type":"tool_result","content":"1\t/**\n2\t * The visualization controller will works as a state machine.\n3\t * See files under the `doc` folder for transition descriptions.\n4\t * See https://github.com/jakesgordon/javascript-state-machine\n5\t * for the document of the StateMachine module.\n6\t */\n7\tvar Controller = StateMachine.create({\n8\t    initial: 'none',\n9\t    events: [\n10\t        {\n11\t            name: 'init',\n12\t            from: 'none',\n13\t            to:   'ready'\n14\t        },\n15\t        {\n16\t            name: 'search',\n17\t            from: 'starting',\n18\t            to:   'searching'\n19\t        },\n20\t        {\n21\t            name: 'pause',\n22\t            from: 'searching',\n23\t            to:   'paused'\n24\t        },\n25\t        {\n26\t            name: 'finish',\n27\t            from: 'searching',\n28\t            to:   'finished'\n29\t        },\n30\t        {\n31\t            name: 'resume',\n32\t            from: 'paused',\n33\t            to:   'searching'\n34\t        },\n35\t        {\n36\t            name: 'cancel',\n37\t            from: 'paused',\n38\t            to:   'ready'\n39\t        },\n40\t        {\n41\t            name: 'modify',\n42\t            from: 'finished',\n43\t            to:   'modified'\n44\t        },\n45\t        {\n46\t            name: 'reset',\n47\t            from: '*',\n48\t            to:   'ready'\n49\t        },\n50\t        {\n51\t            name: 'clear',\n52\t            from: ['finished', 'modified'],\n53\t            to:   'ready'\n54\t        },\n55\t        {\n56\t            name: 'start',\n57\t            from: ['ready', 'modified', 'restarting'],\n58\t            to:   'starting'\n59\t        },\n60\t        {\n61\t            name: 'restart',\n62\t            from: ['searching', 'finished'],\n63\t            to:   'restarting'\n64\t        },\n65\t        {\n66\t            name: 'dragStart',\n67\t            from: ['ready', 'finished'],\n68\t            to:   'draggingStart'\n69\t        },\n70\t        {\n71\t            name: 'dragEnd',\n72\t            from: ['ready', 'finished'],\n73\t            to:   'draggingEnd'\n74\t        },\n75\t        {\n76\t            name: 'drawWall',\n77\t            from: ['ready', 'finished'],\n78\t            to:   'drawingWall'\n79\t        },\n80\t        {\n81\t            name: 'eraseWall',\n82\t            from: ['ready', 'finished'],\n83\t            to:   'erasingWall'\n84\t        },\n85\t        {\n86\t            name: 'rest',\n87\t            from: ['draggingStart', 'draggingEnd', 'drawingWall', 'erasingWall'],\n88\t            to  : 'ready'\n89\t        },\n90\t    ],\n91\t});\n92\t\n93\t$.extend(Controller, {\n94\t    gridSize: [64, 36], // number of nodes horizontally and vertically\n95\t    operationsPerSecond: 300,\n96\t\n97\t    /**\n98\t     * Asynchronous transition from `none` state to `ready` state.\n99\t     */\n100\t    onleavenone: function() {\n101\t        var numCols = this.gridSize[0],\n102\t            numRows = this.gridSize[1];\n103\t\n104\t        this.grid = new PF.Grid(numCols, numRows);\n105\t\n106\t        View.init({\n107\t            numCols: numCols,\n108\t            numRows: numRows\n109\t        });\n110\t        View.generateGrid(function() {\n111\t            Controller.setDefaultStartEndPos();\n112\t            Controller.bindEvents();\n113\t            Controller.transition(); // transit to the next state (ready)\n114\t        });\n115\t\n116\t        this.$buttons = $('.control_button');\n117\t\n118\t        this.hookPathFinding();\n119\t\n120\t        return StateMachine.ASYNC;\n121\t        // => ready\n122\t    },\n123\t    ondrawWall: function(event, from, to, gridX, gridY) {\n124\t        this.setWalkableAt(gridX, gridY, false);\n125\t        // => drawingWall\n126\t    },\n127\t    oneraseWall: function(event, from, to, gridX, gridY) {\n128\t        this.setWalkableAt(gridX, gridY, true);\n129\t        // => erasingWall\n130\t    },\n131\t    onsearch: function(event, from, to) {\n132\t        var grid,\n133\t            timeStart, timeEnd,\n134\t            finder = Panel.getFinder();\n135\t\n136\t        timeStart = window.performance ? performance.now() : Date.now();\n137\t        grid = this.grid.clone();\n138\t        this.path = finder.findPath(\n139\t            this.startX, this.startY, this.endX, this.endY, grid\n140\t        );\n141\t        this.operationCount = this.operations.length;\n142\t        timeEnd = window.performance ? performance.now() : Date.now();\n143\t        this.timeSpent = (timeEnd - timeStart).toFixed(4);\n144\t\n145\t        this.loop();\n146\t        // => searching\n147\t    },\n148\t    onrestart: function() {\n149\t        // When clearing the colorized nodes, there may be\n150\t        // nodes still animating, which is an asynchronous procedure.\n151\t        // Therefore, we have to defer the `abort` routine to make sure\n152\t        // that all the animations are done by the time we clear the colors.\n153\t        // The same reason applies for the `onreset` event handler.\n154\t        setTimeout(function() {\n155\t            Controller.clearOperations();\n156\t            Controller.clearFootprints();\n157\t            Controller.start();\n158\t        }, View.nodeColorizeEffect.duration * 1.2);\n159\t        // => restarting\n160\t    },\n161\t    onpause: function(event, from, to) {\n162\t        // => paused\n163\t    },\n164\t    onresume: function(event, from, to) {\n165\t        this.loop();\n166\t        // => searching\n167\t    },\n168\t    oncancel: function(event, from, to) {\n169\t        this.clearOperations();\n170\t        this.clearFootprints();\n171\t        // => ready\n172\t    },\n173\t    onfinish: function(event, from, to) {\n174\t        View.showStats({\n175\t            pathLength: PF.Util.pathLength(this.path),\n176\t            timeSpent:  this.timeSpent,\n177\t            operationCount: this.operationCount,\n178\t        });\n179\t        View.drawPath(this.path);\n180\t        // => finished\n181\t    },\n182\t    onclear: function(event, from, to) {\n183\t        this.clearOperations();\n184\t        this.clearFootprints();\n185\t        // => ready\n186\t    },\n187\t    onmodify: function(event, from, to) {\n188\t        // => modified\n189\t    },\n190\t    onreset: function(event, from, to) {\n191\t        setTimeout(function() {\n192\t            Controller.clearOperations();\n193\t            Controller.clearAll();\n194\t            Controller.buildNewGrid();\n195\t        }, View.nodeColorizeEffect.duration * 1.2);\n196\t        // => ready\n197\t    },\n198\t\n199\t    /**\n200\t     * The following functions are called on entering states.\n201\t     */\n202\t\n203\t    onready: function() {\n204\t        console.log('=> ready');\n205\t        this.setButtonStates({\n206\t            id: 1,\n207\t            text: 'Start Search',\n208\t            enabled: true,\n209\t            callback: $.proxy(this.start, this),\n210\t        }, {\n211\t            id: 2,\n212\t            text: 'Pause Search',\n213\t            enabled: false,\n214\t        }, {\n215\t            id: 3,\n216\t            text: 'Clear Walls',\n217\t            enabled: true,\n218\t            callback: $.proxy(this.reset, this),\n219\t        });\n220\t        // => [starting, draggingStart, draggingEnd, drawingStart, drawingEnd]\n221\t    },\n222\t    onstarting: function(event, from, to) {\n223\t        console.log('=> starting');\n224\t        // Clears any existing search progress\n225\t        this.clearFootprints();\n226\t        this.setButtonStates({\n227\t            id: 2,\n228\t            enabled: true,\n229\t        });\n230\t        this.search();\n231\t        // => searching\n232\t    },\n233\t    onsearching: function() {\n234\t        console.log('=> searching');\n235\t        this.setButtonStates({\n236\t            id: 1,\n237\t            text: 'Restart Search',\n238\t            enabled: true,\n239\t            callback: $.proxy(this.restart, this),\n240\t        }, {\n241\t            id: 2,\n242\t            text: 'Pause Search',\n243\t            enabled: true,\n244\t            callback: $.proxy(this.pause, this),\n245\t        });\n246\t        // => [paused, finished]\n247\t    },\n248\t    onpaused: function() {\n249\t        console.log('=> paused');\n250\t        this.setButtonStates({\n251\t            id: 1,\n252\t            text: 'Resume Search',\n253\t            enabled: true,\n254\t            callback: $.proxy(this.resume, this),\n255\t        }, {\n256\t            id: 2,\n257\t            text: 'Cancel Search',\n258\t            enabled: true,\n259\t            callback: $.proxy(this.cancel, this),\n260\t        });\n261\t        // => [searching, ready]\n262\t    },\n263\t    onfinished: function() {\n264\t        console.log('=> finished');\n265\t        this.setButtonStates({\n266\t            id: 1,\n267\t            text: 'Restart Search',\n268\t            enabled: true,\n269\t            callback: $.proxy(this.restart, this),\n270\t        }, {\n271\t            id: 2,\n272\t            text: 'Clear Path',\n273\t            enabled: true,\n274\t            callback: $.proxy(this.clear, this),\n275\t        });\n276\t    },\n277\t    onmodified: function() {\n278\t        console.log('=> modified');\n279\t        this.setButtonStates({\n280\t            id: 1,\n281\t            text: 'Start Search',\n282\t            enabled: true,\n283\t            callback: $.proxy(this.start, this),\n284\t        }, {\n285\t            id: 2,\n286\t            text: 'Clear Path',\n287\t            enabled: true,\n288\t            callback: $.proxy(this.clear, this),\n289\t        });\n290\t    },\n291\t\n292\t    /**\n293\t     * Define setters and getters of PF.Node, then we can get the operations\n294\t     * of the pathfinding.\n295\t     */\n296\t    hookPathFinding: function() {\n297\t\n298\t        PF.Node.prototype = {\n299\t            get opened() {\n300\t                return this._opened;\n301\t            },\n302\t            set opened(v) {\n303\t                this._opened = v;\n304\t                Controller.operations.push({\n305\t                    x: this.x,\n306\t                    y: this.y,\n307\t                    attr: 'opened',\n308\t                    value: v\n309\t                });\n310\t            },\n311\t            get closed() {\n312\t                return this._closed;\n313\t            },\n314\t            set closed(v) {\n315\t                this._closed = v;\n316\t                Controller.operations.push({\n317\t                    x: this.x,\n318\t                    y: this.y,\n319\t                    attr: 'closed',\n320\t                    value: v\n321\t                });\n322\t            },\n323\t            get tested() {\n324\t                return this._tested;\n325\t            },\n326\t            set tested(v) {\n327\t                this._tested = v;\n328\t                Controller.operations.push({\n329\t                    x: this.x,\n330\t                    y: this.y,\n331\t                    attr: 'tested',\n332\t                    value: v\n333\t                });\n334\t            },\n335\t        };\n336\t\n337\t        this.operations = [];\n338\t    },\n339\t    bindEvents: function() {\n340\t        $('#draw_area').mousedown($.proxy(this.mousedown, this));\n341\t        $(window)\n342\t            .mousemove($.proxy(this.mousemove, this))\n343\t            .mouseup($.proxy(this.mouseup, this));\n344\t    },\n345\t    loop: function() {\n346\t        var interval = 1000 / this.operationsPerSecond;\n347\t        (function loop() {\n348\t            if (!Controller.is('searching')) {\n349\t                return;\n350\t            }\n351\t            Controller.step();\n352\t            setTimeout(loop, interval);\n353\t        })();\n354\t    },\n355\t    step: function() {\n356\t        var operations = this.operations,\n357\t            op, isSupported;\n358\t\n359\t        do {\n360\t            if (!operations.length) {\n361\t                this.finish(); // transit to `finished` state\n362\t                return;\n363\t            }\n364\t            op = operations.shift();\n365\t            isSupported = View.supportedOperations.indexOf(op.attr) !== -1;\n366\t        } while (!isSupported);\n367\t\n368\t        View.setAttributeAt(op.x, op.y, op.attr, op.value);\n369\t    },\n370\t    clearOperations: function() {\n371\t        this.operations = [];\n372\t    },\n373\t    clearFootprints: function() {\n374\t        View.clearFootprints();\n375\t        View.clearPath();\n376\t    },\n377\t    clearAll: function() {\n378\t        this.clearFootprints();\n379\t        View.clearBlockedNodes();\n380\t    },\n381\t    buildNewGrid: function() {\n382\t        this.grid = new PF.Grid(this.gridSize[0], this.gridSize[1]);\n383\t    },\n384\t    mousedown: function (event) {\n385\t        var coord = View.toGridCoordinate(event.pageX, event.pageY),\n386\t            gridX = coord[0],\n387\t            gridY = coord[1],\n388\t            grid  = this.grid;\n389\t\n390\t        if (this.can('dragStart') && this.isStartPos(gridX, gridY)) {\n391\t            this.dragStart();\n392\t            return;\n393\t        }\n394\t        if (this.can('dragEnd') && this.isEndPos(gridX, gridY)) {\n395\t            this.dragEnd();\n396\t            return;\n397\t        }\n398\t        if (this.can('drawWall') && grid.isWalkableAt(gridX, gridY)) {\n399\t            this.drawWall(gridX, gridY);\n400\t            return;\n401\t        }\n402\t        if (this.can('eraseWall') && !grid.isWalkableAt(gridX, gridY)) {\n403\t            this.eraseWall(gridX, gridY);\n404\t        }\n405\t    },\n406\t    mousemove: function(event) {\n407\t        var coord = View.toGridCoordinate(event.pageX, event.pageY),\n408\t            grid = this.grid,\n409\t            gridX = coord[0],\n410\t            gridY = coord[1];\n411\t\n412\t        if (this.isStartOrEndPos(gridX, gridY)) {\n413\t            return;\n414\t        }\n415\t\n416\t        switch (this.current) {\n417\t        case 'draggingStart':\n418\t            if (grid.isWalkableAt(gridX, gridY)) {\n419\t                this.setStartPos(gridX, gridY);\n420\t            }\n421\t            break;\n422\t        case 'draggingEnd':\n423\t            if (grid.isWalkableAt(gridX, gridY)) {\n424\t                this.setEndPos(gridX, gridY);\n425\t            }\n426\t            break;\n427\t        case 'drawingWall':\n428\t            this.setWalkableAt(gridX, gridY, false);\n429\t            break;\n430\t        case 'erasingWall':\n431\t            this.setWalkableAt(gridX, gridY, true);\n432\t            break;\n433\t        }\n434\t    },\n435\t    mouseup: function(event) {\n436\t        if (Controller.can('rest')) {\n437\t            Controller.rest();\n438\t        }\n439\t    },\n440\t    setButtonStates: function() {\n441\t        $.each(arguments, function(i, opt) {\n442\t            var $button = Controller.$buttons.eq(opt.id - 1);\n443\t            if (opt.text) {\n444\t                $button.text(opt.text);\n445\t            }\n446\t            if (opt.callback) {\n447\t                $button\n448\t                    .unbind('click')\n449\t                    .click(opt.callback);\n450\t            }\n451\t            if (opt.enabled === undefined) {\n452\t                return;\n453\t            } else if (opt.enabled) {\n454\t                $button.removeAttr('disabled');\n455\t            } else {\n456\t                $button.attr({ disabled: 'disabled' });\n457\t            }\n458\t        });\n459\t    },\n460\t    /**\n461\t     * When initializing, this method will be called to set the positions\n462\t     * of start node and end node.\n463\t     * It will detect user's display size, and compute the best positions.\n464\t     */\n465\t    setDefaultStartEndPos: function() {\n466\t        var width, height,\n467\t            marginRight, availWidth,\n468\t            centerX, centerY,\n469\t            endX, endY,\n470\t            nodeSize = View.nodeSize;\n471\t\n472\t        width  = $(window).width();\n473\t        height = $(window).height();\n474\t\n475\t        marginRight = $('#algorithm_panel').width();\n476\t        availWidth = width - marginRight;\n477\t\n478\t        centerX = Math.ceil(availWidth / 2 / nodeSize);\n479\t        centerY = Math.floor(height / 2 / nodeSize);\n480\t\n481\t        this.setStartPos(centerX - 5, centerY);\n482\t        this.setEndPos(centerX + 5, centerY);\n483\t    },\n484\t    setStartPos: function(gridX, gridY) {\n485\t        this.startX = gridX;\n486\t        this.startY = gridY;\n487\t        View.setStartPos(gridX, gridY);\n488\t    },\n489\t    setEndPos: function(gridX, gridY) {\n490\t        this.endX = gridX;\n491\t        this.endY = gridY;\n492\t        View.setEndPos(gridX, gridY);\n493\t    },\n494\t    setWalkableAt: function(gridX, gridY, walkable) {\n495\t        this.grid.setWalkableAt(gridX, gridY, walkable);\n496\t        View.setAttributeAt(gridX, gridY, 'walkable', walkable);\n497\t    },\n498\t    isStartPos: function(gridX, gridY) {\n499\t        return gridX === this.startX && gridY === this.startY;\n500\t    },\n501\t    isEndPos: function(gridX, gridY) {\n502\t        return gridX === this.endX && gridY === this.endY;\n503\t    },\n504\t    isStartOrEndPos: function(gridX, gridY) {\n505\t        return this.isStartPos(gridX, gridY) || this.isEndPos(gridX, gridY);\n506\t    },\n507\t});\n508\t"}]},"parent_tool_use_id":null,"session_id":"d51127d4-3ec8-4e1b-bc7c-91599c878a54","uuid":"1c14e1d1-0f58-47ee-b3d4-5f35e973304c","timestamp":"2026-04-16T13:57:04.769Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/visual/js/controller.js","content":"/**\n * The visualization controller will works as a state machine.\n * See files under the `doc` folder for transition descriptions.\n * See https://github.com/jakesgordon/javascript-state-machine\n * for the document of the StateMachine module.\n */\nvar Controller = StateMachine.create({\n    initial: 'none',\n    events: [\n        {\n            name: 'init',\n            from: 'none',\n            to:   'ready'\n        },\n        {\n            name: 'search',\n            from: 'starting',\n            to:   'searching'\n        },\n        {\n            name: 'pause',\n            from: 'searching',\n            to:   'paused'\n        },\n        {\n            name: 'finish',\n            from: 'searching',\n            to:   'finished'\n        },\n        {\n            name: 'resume',\n            from: 'paused',\n            to:   'searching'\n        },\n        {\n            name: 'cancel',\n            from: 'paused',\n            to:   'ready'\n        },\n        {\n            name: 'modify',\n            from: 'finished',\n            to:   'modified'\n        },\n        {\n            name: 'reset',\n            from: '*',\n            to:   'ready'\n        },\n        {\n            name: 'clear',\n            from: ['finished', 'modified'],\n            to:   'ready'\n        },\n        {\n            name: 'start',\n            from: ['ready', 'modified', 'restarting'],\n            to:   'starting'\n        },\n        {\n            name: 'restart',\n            from: ['searching', 'finished'],\n            to:   'restarting'\n        },\n        {\n            name: 'dragStart',\n            from: ['ready', 'finished'],\n            to:   'draggingStart'\n        },\n        {\n            name: 'dragEnd',\n            from: ['ready', 'finished'],\n            to:   'draggingEnd'\n        },\n        {\n            name: 'drawWall',\n            from: ['ready', 'finished'],\n            to:   'drawingWall'\n        },\n        {\n            name: 'eraseWall',\n            from: ['ready', 'finished'],\n            to:   'erasingWall'\n        },\n        {\n            name: 'rest',\n            from: ['draggingStart', 'draggingEnd', 'drawingWall', 'erasingWall'],\n            to  : 'ready'\n        },\n    ],\n});\n\n$.extend(Controller, {\n    gridSize: [64, 36], // number of nodes horizontally and vertically\n    operationsPerSecond: 300,\n\n    /**\n     * Asynchronous transition from `none` state to `ready` state.\n     */\n    onleavenone: function() {\n        var numCols = this.gridSize[0],\n            numRows = this.gridSize[1];\n\n        this.grid = new PF.Grid(numCols, numRows);\n\n        View.init({\n            numCols: numCols,\n            numRows: numRows\n        });\n        View.generateGrid(function() {\n            Controller.setDefaultStartEndPos();\n            Controller.bindEvents();\n            Controller.transition(); // transit to the next state (ready)\n        });\n\n        this.$buttons = $('.control_button');\n\n        this.hookPathFinding();\n\n        return StateMachine.ASYNC;\n        // => ready\n    },\n    ondrawWall: function(event, from, to, gridX, gridY) {\n        this.setWalkableAt(gridX, gridY, false);\n        // => drawingWall\n    },\n    oneraseWall: function(event, from, to, gridX, gridY) {\n        this.setWalkableAt(gridX, gridY, true);\n        // => erasingWall\n    },\n    onsearch: function(event, from, to) {\n        var grid,\n            timeStart, timeEnd,\n            finder = Panel.getFinder();\n\n        timeStart = window.performance ? performance.now() : Date.now();\n        grid = this.grid.clone();\n        this.path = finder.findPath(\n            this.startX, this.startY, this.endX, this.endY, grid\n        );\n        this.operationCount = this.operations.length;\n        timeEnd = window.performance ? performance.now() : Date.now();\n        this.timeSpent = (timeEnd - timeStart).toFixed(4);\n\n        this.loop();\n        // => searching\n    },\n    onrestart: function() {\n        // When clearing the colorized nodes, there may be\n        // nodes still animating, which is an asynchronous procedure.\n        // Therefore, we have to defer the `abort` routine to make sure\n        // that all the animations are done by the time we clear the colors.\n        // The same reason applies for the `onreset` event handler.\n        setTimeout(function() {\n            Controller.clearOperations();\n            Controller.clearFootprints();\n            Controller.start();\n        }, View.nodeColorizeEffect.duration * 1.2);\n        // => restarting\n    },\n    onpause: function(event, from, to) {\n        // => paused\n    },\n    onresume: function(event, from, to) {\n        this.loop();\n        // => searching\n    },\n    oncancel: function(event, from, to) {\n        this.clearOperations();\n        this.clearFootprints();\n        // => ready\n    },\n    onfinish: function(event, from, to) {\n        View.showStats({\n            pathLength: PF.Util.pathLength(this.path),\n            timeSpent:  this.timeSpent,\n            operationCount: this.operationCount,\n        });\n        View.drawPath(this.path);\n        // => finished\n    },\n    onclear: function(event, from, to) {\n        this.clearOperations();\n        this.clearFootprints();\n        // => ready\n    },\n    onmodify: function(event, from, to) {\n        // => modified\n    },\n    onreset: function(event, from, to) {\n        setTimeout(function() {\n            Controller.clearOperations();\n            Controller.clearAll();\n            Controller.buildNewGrid();\n        }, View.nodeColorizeEffect.duration * 1.2);\n        // => ready\n    },\n\n    /**\n     * The following functions are called on entering states.\n     */\n\n    onready: function() {\n        console.log('=> ready');\n        this.setButtonStates({\n            id: 1,\n            text: 'Start Search',\n            enabled: true,\n            callback: $.proxy(this.start, this),\n        }, {\n            id: 2,\n            text: 'Pause Search',\n            enabled: false,\n        }, {\n            id: 3,\n            text: 'Clear Walls',\n            enabled: true,\n            callback: $.proxy(this.reset, this),\n        });\n        // => [starting, draggingStart, draggingEnd, drawingStart, drawingEnd]\n    },\n    onstarting: function(event, from, to) {\n        console.log('=> starting');\n        // Clears any existing search progress\n        this.clearFootprints();\n        this.setButtonStates({\n            id: 2,\n            enabled: true,\n        });\n        this.search();\n        // => searching\n    },\n    onsearching: function() {\n        console.log('=> searching');\n        this.setButtonStates({\n            id: 1,\n            text: 'Restart Search',\n            enabled: true,\n            callback: $.proxy(this.restart, this),\n        }, {\n            id: 2,\n            text: 'Pause Search',\n            enabled: true,\n            callback: $.proxy(this.pause, this),\n        });\n        // => [paused, finished]\n    },\n    onpaused: function() {\n        console.log('=> paused');\n        this.setButtonStates({\n            id: 1,\n            text: 'Resume Search',\n            enabled: true,\n            callback: $.proxy(this.resume, this),\n        }, {\n            id: 2,\n            text: 'Cancel Search',\n            enabled: true,\n            callback: $.proxy(this.cancel, this),\n        });\n        // => [searching, ready]\n    },\n    onfinished: function() {\n        console.log('=> finished');\n        this.setButtonStates({\n            id: 1,\n            text: 'Restart Search',\n            enabled: true,\n            callback: $.proxy(this.restart, this),\n        }, {\n            id: 2,\n            text: 'Clear Path',\n            enabled: true,\n            callback: $.proxy(this.clear, this),\n        });\n    },\n    onmodified: function() {\n        console.log('=> modified');\n        this.setButtonStates({\n            id: 1,\n            text: 'Start Search',\n            enabled: true,\n            callback: $.proxy(this.start, this),\n        }, {\n            id: 2,\n            text: 'Clear Path',\n            enabled: true,\n            callback: $.proxy(this.clear, this),\n        });\n    },\n\n    /**\n     * Define setters and getters of PF.Node, then we can get the operations\n     * of the pathfinding.\n     */\n    hookPathFinding: function() {\n\n        PF.Node.prototype = {\n            get opened() {\n                return this._opened;\n            },\n            set opened(v) {\n                this._opened = v;\n                Controller.operations.push({\n                    x: this.x,\n                    y: this.y,\n                    attr: 'opened',\n                    value: v\n                });\n            },\n            get closed() {\n                return this._closed;\n            },\n            set closed(v) {\n                this._closed = v;\n                Controller.operations.push({\n                    x: this.x,\n                    y: this.y,\n                    attr: 'closed',\n                    value: v\n                });\n            },\n            get tested() {\n                return this._tested;\n            },\n            set tested(v) {\n                this._tested = v;\n                Controller.operations.push({\n                    x: this.x,\n                    y: this.y,\n                    attr: 'tested',\n                    value: v\n                });\n            },\n        };\n\n        this.operations = [];\n    },\n    bindEvents: function() {\n        $('#draw_area').mousedown($.proxy(this.mousedown, this));\n        $(window)\n            .mousemove($.proxy(this.mousemove, this))\n            .mouseup($.proxy(this.mouseup, this));\n    },\n    loop: function() {\n        var interval = 1000 / this.operationsPerSecond;\n        (function loop() {\n            if (!Controller.is('searching')) {\n                return;\n            }\n            Controller.step();\n            setTimeout(loop, interval);\n        })();\n    },\n    step: function() {\n        var operations = this.operations,\n            op, isSupported;\n\n        do {\n            if (!operations.length) {\n                this.finish(); // transit to `finished` state\n                return;\n            }\n            op = operations.shift();\n            isSupported = View.supportedOperations.indexOf(op.attr) !== -1;\n        } while (!isSupported);\n\n        View.setAttributeAt(op.x, op.y, op.attr, op.value);\n    },\n    clearOperations: function() {\n        this.operations = [];\n    },\n    clearFootprints: function() {\n        View.clearFootprints();\n        View.clearPath();\n    },\n    clearAll: function() {\n        this.clearFootprints();\n        View.clearBlockedNodes();\n    },\n    buildNewGrid: function() {\n        this.grid = new PF.Grid(this.gridSize[0], this.gridSize[1]);\n    },\n    mousedown: function (event) {\n        var coord = View.toGridCoordinate(event.pageX, event.pageY),\n            gridX = coord[0],\n            gridY = coord[1],\n            grid  = this.grid;\n\n        if (this.can('dragStart') && this.isStartPos(gridX, gridY)) {\n            this.dragStart();\n            return;\n        }\n        if (this.can('dragEnd') && this.isEndPos(gridX, gridY)) {\n            this.dragEnd();\n            return;\n        }\n        if (this.can('drawWall') && grid.isWalkableAt(gridX, gridY)) {\n            this.drawWall(gridX, gridY);\n            return;\n        }\n        if (this.can('eraseWall') && !grid.isWalkableAt(gridX, gridY)) {\n            this.eraseWall(gridX, gridY);\n        }\n    },\n    mousemove: function(event) {\n        var coord = View.toGridCoordinate(event.pageX, event.pageY),\n            grid = this.grid,\n            gridX = coord[0],\n            gridY = coord[1];\n\n        if (this.isStartOrEndPos(gridX, gridY)) {\n            return;\n        }\n\n        switch (this.current) {\n        case 'draggingStart':\n            if (grid.isWalkableAt(gridX, gridY)) {\n                this.setStartPos(gridX, gridY);\n            }\n            break;\n        case 'draggingEnd':\n            if (grid.isWalkableAt(gridX, gridY)) {\n                this.setEndPos(gridX, gridY);\n            }\n            break;\n        case 'drawingWall':\n            this.setWalkableAt(gridX, gridY, false);\n            break;\n        case 'erasingWall':\n            this.setWalkableAt(gridX, gridY, true);\n            break;\n        }\n    },\n    mouseup: function(event) {\n        if (Controller.can('rest')) {\n            Controller.rest();\n        }\n    },\n    setButtonStates: function() {\n        $.each(arguments, function(i, opt) {\n            var $button = Controller.$buttons.eq(opt.id - 1);\n            if (opt.text) {\n                $button.text(opt.text);\n            }\n            if (opt.callback) {\n                $button\n                    .unbind('click')\n                    .click(opt.callback);\n            }\n            if (opt.enabled === undefined) {\n                return;\n            } else if (opt.enabled) {\n                $button.removeAttr('disabled');\n            } else {\n                $button.attr({ disabled: 'disabled' });\n            }\n        });\n    },\n    /**\n     * When initializing, this method will be called to set the positions\n     * of start node and end node.\n     * It will detect user's display size, and compute the best positions.\n     */\n    setDefaultStartEndPos: function() {\n        var width, height,\n            marginRight, availWidth,\n            centerX, centerY,\n            endX, endY,\n            nodeSize = View.nodeSize;\n\n        width  = $(window).width();\n        height = $(window).height();\n\n        marginRight = $('#algorithm_panel').width();\n        availWidth = width - marginRight;\n\n        centerX = Math.ceil(availWidth / 2 / nodeSize);\n        centerY = Math.floor(height / 2 / nodeSize);\n\n        this.setStartPos(centerX - 5, centerY);\n        this.setEndPos(centerX + 5, centerY);\n    },\n    setStartPos: function(gridX, gridY) {\n        this.startX = gridX;\n        this.startY = gridY;\n        View.setStartPos(gridX, gridY);\n    },\n    setEndPos: function(gridX, gridY) {\n        this.endX = gridX;\n        this.endY = gridY;\n        View.setEndPos(gridX, gridY);\n    },\n    setWalkableAt: function(gridX, gridY, walkable) {\n        this.grid.setWalkableAt(gridX, gridY, walkable);\n        View.setAttributeAt(gridX, gridY, 'walkable', walkable);\n    },\n    isStartPos: function(gridX, gridY) {\n        return gridX === this.startX && gridY === this.startY;\n    },\n    isEndPos: function(gridX, gridY) {\n        return gridX === this.endX && gridY === this.endY;\n    },\n    isStartOrEndPos: function(gridX, gridY) {\n        return this.isStartPos(gridX, gridY) || this.isEndPos(gridX, gridY);\n    },\n});\n","numLines":508,"startLine":1,"totalLines":508}}}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01XSLpprJjtTKKGyPrsXypoi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0157JxH66VEd8WsyMjuFUkya","name":"Read","input":{"file_path":"/home/sagar/template-repo/visual/js/view.js"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":12419,"cache_read_input_tokens":18382,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12419},"output_tokens":37,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"d51127d4-3ec8-4e1b-bc7c-91599c878a54","uuid":"253a881b-db62-4188-a91a-0abcacecc566"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0157JxH66VEd8WsyMjuFUkya","type":"tool_result","content":"1\t/**\n2\t * The pathfinding visualization.\n3\t * It uses raphael.js to show the grids.\n4\t */\n5\tvar View = {\n6\t    nodeSize: 30, // width and height of a single node, in pixel\n7\t    nodeStyle: {\n8\t        normal: {\n9\t            fill: 'white',\n10\t            'stroke-opacity': 0.2, // the border\n11\t        },\n12\t        blocked: {\n13\t            fill: 'grey',\n14\t            'stroke-opacity': 0.2,\n15\t        },\n16\t        start: {\n17\t            fill: '#0d0',\n18\t            'stroke-opacity': 0.2,\n19\t        },\n20\t        end: {\n21\t            fill: '#e40',\n22\t            'stroke-opacity': 0.2,\n23\t        },\n24\t        opened: {\n25\t            fill: '#98fb98',\n26\t            'stroke-opacity': 0.2,\n27\t        },\n28\t        closed: {\n29\t            fill: '#afeeee',\n30\t            'stroke-opacity': 0.2,\n31\t        },\n32\t        failed: {\n33\t            fill: '#ff8888',\n34\t            'stroke-opacity': 0.2,\n35\t        },\n36\t        tested: {\n37\t            fill: '#e5e5e5',\n38\t            'stroke-opacity': 0.2,\n39\t        },\n40\t    },\n41\t    nodeColorizeEffect: {\n42\t        duration: 50,\n43\t    },\n44\t    nodeZoomEffect: {\n45\t        duration: 200,\n46\t        transform: 's1.2', // scale by 1.2x\n47\t        transformBack: 's1.0',\n48\t    },\n49\t    pathStyle: {\n50\t        stroke: 'yellow',\n51\t        'stroke-width': 3,\n52\t    },\n53\t    supportedOperations: ['opened', 'closed', 'tested'],\n54\t    init: function(opts) {\n55\t        this.numCols      = opts.numCols;\n56\t        this.numRows      = opts.numRows;\n57\t        this.paper        = Raphael('draw_area');\n58\t        this.$stats       = $('#stats');\n59\t    },\n60\t    /**\n61\t     * Generate the grid asynchronously.\n62\t     * This method will be a very expensive task.\n63\t     * Therefore, in order to not to block the rendering of browser ui,\n64\t     * I decomposed the task into smaller ones. Each will only generate a row.\n65\t     */\n66\t    generateGrid: function(callback) {\n67\t        var i, j, x, y,\n68\t            rect,\n69\t            normalStyle, nodeSize,\n70\t            createRowTask, sleep, tasks,\n71\t            nodeSize    = this.nodeSize,\n72\t            normalStyle = this.nodeStyle.normal,\n73\t            numCols     = this.numCols,\n74\t            numRows     = this.numRows,\n75\t            paper       = this.paper,\n76\t            rects       = this.rects = [],\n77\t            $stats      = this.$stats;\n78\t\n79\t        paper.setSize(numCols * nodeSize, numRows * nodeSize);\n80\t\n81\t        createRowTask = function(rowId) {\n82\t            return function(done) {\n83\t                rects[rowId] = [];\n84\t                for (j = 0; j < numCols; ++j) {\n85\t                    x = j * nodeSize;\n86\t                    y = rowId * nodeSize;\n87\t\n88\t                    rect = paper.rect(x, y, nodeSize, nodeSize);\n89\t                    rect.attr(normalStyle);\n90\t                    rects[rowId].push(rect);\n91\t                }\n92\t                $stats.text(\n93\t                    'generating grid ' +\n94\t                    Math.round((rowId + 1) / numRows * 100) + '%'\n95\t                );\n96\t                done(null);\n97\t            };\n98\t        };\n99\t\n100\t        sleep = function(done) {\n101\t            setTimeout(function() {\n102\t                done(null);\n103\t            }, 0);\n104\t        };\n105\t\n106\t        tasks = [];\n107\t        for (i = 0; i < numRows; ++i) {\n108\t            tasks.push(createRowTask(i));\n109\t            tasks.push(sleep);\n110\t        }\n111\t\n112\t        async.series(tasks, function() {\n113\t            if (callback) {\n114\t                callback();\n115\t            }\n116\t        });\n117\t    },\n118\t    setStartPos: function(gridX, gridY) {\n119\t        var coord = this.toPageCoordinate(gridX, gridY);\n120\t        if (!this.startNode) {\n121\t            this.startNode = this.paper.rect(\n122\t                coord[0],\n123\t                coord[1],\n124\t                this.nodeSize,\n125\t                this.nodeSize\n126\t            ).attr(this.nodeStyle.normal)\n127\t             .animate(this.nodeStyle.start, 1000);\n128\t        } else {\n129\t            this.startNode.attr({ x: coord[0], y: coord[1] }).toFront();\n130\t        }\n131\t    },\n132\t    setEndPos: function(gridX, gridY) {\n133\t        var coord = this.toPageCoordinate(gridX, gridY);\n134\t        if (!this.endNode) {\n135\t            this.endNode = this.paper.rect(\n136\t                coord[0],\n137\t                coord[1],\n138\t                this.nodeSize,\n139\t                this.nodeSize\n140\t            ).attr(this.nodeStyle.normal)\n141\t             .animate(this.nodeStyle.end, 1000);\n142\t        } else {\n143\t            this.endNode.attr({ x: coord[0], y: coord[1] }).toFront();\n144\t        }\n145\t    },\n146\t    /**\n147\t     * Set the attribute of the node at the given coordinate.\n148\t     */\n149\t    setAttributeAt: function(gridX, gridY, attr, value) {\n150\t        var color, nodeStyle = this.nodeStyle;\n151\t        switch (attr) {\n152\t        case 'walkable':\n153\t            color = value ? nodeStyle.normal.fill : nodeStyle.blocked.fill;\n154\t            this.setWalkableAt(gridX, gridY, value);\n155\t            break;\n156\t        case 'opened':\n157\t            this.colorizeNode(this.rects[gridY][gridX], nodeStyle.opened.fill);\n158\t            this.setCoordDirty(gridX, gridY, true);\n159\t            break;\n160\t        case 'closed':\n161\t            this.colorizeNode(this.rects[gridY][gridX], nodeStyle.closed.fill);\n162\t            this.setCoordDirty(gridX, gridY, true);\n163\t            break;\n164\t        case 'tested':\n165\t            color = (value === true) ? nodeStyle.tested.fill : nodeStyle.normal.fill;\n166\t\n167\t            this.colorizeNode(this.rects[gridY][gridX], color);\n168\t            this.setCoordDirty(gridX, gridY, true);\n169\t            break;\n170\t        case 'parent':\n171\t            // XXX: Maybe draw a line from this node to its parent?\n172\t            // This would be expensive.\n173\t            break;\n174\t        default:\n175\t            console.error('unsupported operation: ' + attr + ':' + value);\n176\t            return;\n177\t        }\n178\t    },\n179\t    colorizeNode: function(node, color) {\n180\t        node.animate({\n181\t            fill: color\n182\t        }, this.nodeColorizeEffect.duration);\n183\t    },\n184\t    zoomNode: function(node) {\n185\t        node.toFront().attr({\n186\t            transform: this.nodeZoomEffect.transform,\n187\t        }).animate({\n188\t            transform: this.nodeZoomEffect.transformBack,\n189\t        }, this.nodeZoomEffect.duration);\n190\t    },\n191\t    setWalkableAt: function(gridX, gridY, value) {\n192\t        var node, i, blockedNodes = this.blockedNodes;\n193\t        if (!blockedNodes) {\n194\t            blockedNodes = this.blockedNodes = new Array(this.numRows);\n195\t            for (i = 0; i < this.numRows; ++i) {\n196\t                blockedNodes[i] = [];\n197\t            }\n198\t        }\n199\t        node = blockedNodes[gridY][gridX];\n200\t        if (value) {\n201\t            // clear blocked node\n202\t            if (node) {\n203\t                this.colorizeNode(node, this.rects[gridY][gridX].attr('fill'));\n204\t                this.zoomNode(node);\n205\t                setTimeout(function() {\n206\t                    node.remove();\n207\t                }, this.nodeZoomEffect.duration);\n208\t                blockedNodes[gridY][gridX] = null;\n209\t            }\n210\t        } else {\n211\t            // draw blocked node\n212\t            if (node) {\n213\t                return;\n214\t            }\n215\t            node = blockedNodes[gridY][gridX] = this.rects[gridY][gridX].clone();\n216\t            this.colorizeNode(node, this.nodeStyle.blocked.fill);\n217\t            this.zoomNode(node);\n218\t        }\n219\t    },\n220\t    clearFootprints: function() {\n221\t        var i, x, y, coord, coords = this.getDirtyCoords();\n222\t        for (i = 0; i < coords.length; ++i) {\n223\t            coord = coords[i];\n224\t            x = coord[0];\n225\t            y = coord[1];\n226\t            this.rects[y][x].attr(this.nodeStyle.normal);\n227\t            this.setCoordDirty(x, y, false);\n228\t        }\n229\t    },\n230\t    clearBlockedNodes: function() {\n231\t        var i, j, blockedNodes = this.blockedNodes;\n232\t        if (!blockedNodes) {\n233\t            return;\n234\t        }\n235\t        for (i = 0; i < this.numRows; ++i) {\n236\t            for (j = 0 ;j < this.numCols; ++j) {\n237\t                if (blockedNodes[i][j]) {\n238\t                    blockedNodes[i][j].remove();\n239\t                    blockedNodes[i][j] = null;\n240\t                }\n241\t            }\n242\t        }\n243\t    },\n244\t    drawPath: function(path) {\n245\t        if (!path.length) {\n246\t            return;\n247\t        }\n248\t        var svgPath = this.buildSvgPath(path);\n249\t        this.path = this.paper.path(svgPath).attr(this.pathStyle);\n250\t    },\n251\t    /**\n252\t     * Given a path, build its SVG represention.\n253\t     */\n254\t    buildSvgPath: function(path) {\n255\t        var i, strs = [], size = this.nodeSize;\n256\t\n257\t        strs.push('M' + (path[0][0] * size + size / 2) + ' ' +\n258\t                  (path[0][1] * size + size / 2));\n259\t        for (i = 1; i < path.length; ++i) {\n260\t            strs.push('L' + (path[i][0] * size + size / 2) + ' ' +\n261\t                      (path[i][1] * size + size / 2));\n262\t        }\n263\t\n264\t        return strs.join('');\n265\t    },\n266\t    clearPath: function() {\n267\t        if (this.path) {\n268\t            this.path.remove();\n269\t        }\n270\t    },\n271\t    /**\n272\t     * Helper function to convert the page coordinate to grid coordinate\n273\t     */\n274\t    toGridCoordinate: function(pageX, pageY) {\n275\t        return [\n276\t            Math.floor(pageX / this.nodeSize),\n277\t            Math.floor(pageY / this.nodeSize)\n278\t        ];\n279\t    },\n280\t    /**\n281\t     * helper function to convert the grid coordinate to page coordinate\n282\t     */\n283\t    toPageCoordinate: function(gridX, gridY) {\n284\t        return [\n285\t            gridX * this.nodeSize,\n286\t            gridY * this.nodeSize\n287\t        ];\n288\t    },\n289\t    showStats: function(opts) {\n290\t        var texts = [\n291\t            'length: ' + Math.round(opts.pathLength * 100) / 100,\n292\t            'time: ' + opts.timeSpent + 'ms',\n293\t            'operations: ' + opts.operationCount\n294\t        ];\n295\t        $('#stats').show().html(texts.join('<br>'));\n296\t    },\n297\t    setCoordDirty: function(gridX, gridY, isDirty) {\n298\t        var x, y,\n299\t            numRows = this.numRows,\n300\t            numCols = this.numCols,\n301\t            coordDirty;\n302\t\n303\t        if (this.coordDirty === undefined) {\n304\t            coordDirty = this.coordDirty = [];\n305\t            for (y = 0; y < numRows; ++y) {\n306\t                coordDirty.push([]);\n307\t                for (x = 0; x < numCols; ++x) {\n308\t                    coordDirty[y].push(false);\n309\t                }\n310\t            }\n311\t        }\n312\t\n313\t        this.coordDirty[gridY][gridX] = isDirty;\n314\t    },\n315\t    getDirtyCoords: function() {\n316\t        var x, y,\n317\t            numRows = this.numRows,\n318\t            numCols = this.numCols,\n319\t            coordDirty = this.coordDirty,\n320\t            coords = [];\n321\t\n322\t        if (coordDirty === undefined) {\n323\t            return [];\n324\t        }\n325\t\n326\t        for (y = 0; y < numRows; ++y) {\n327\t            for (x = 0; x < numCols; ++x) {\n328\t                if (coordDirty[y][x]) {\n329\t                    coords.push([x, y]);\n330\t                }\n331\t            }\n332\t        }\n333\t        return coords;\n334\t    },\n335\t};\n336\t"}]},"parent_tool_use_id":null,"session_id":"d51127d4-3ec8-4e1b-bc7c-91599c878a54","uuid":"9e0a54c3-6fd6-4cf6-afbb-2334993b285a","timestamp":"2026-04-16T13:57:07.451Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/visual/js/view.js","content":"/**\n * The pathfinding visualization.\n * It uses raphael.js to show the grids.\n */\nvar View = {\n    nodeSize: 30, // width and height of a single node, in pixel\n    nodeStyle: {\n        normal: {\n            fill: 'white',\n            'stroke-opacity': 0.2, // the border\n        },\n        blocked: {\n            fill: 'grey',\n            'stroke-opacity': 0.2,\n        },\n        start: {\n            fill: '#0d0',\n            'stroke-opacity': 0.2,\n        },\n        end: {\n            fill: '#e40',\n            'stroke-opacity': 0.2,\n        },\n        opened: {\n            fill: '#98fb98',\n            'stroke-opacity': 0.2,\n        },\n        closed: {\n            fill: '#afeeee',\n            'stroke-opacity': 0.2,\n        },\n        failed: {\n            fill: '#ff8888',\n            'stroke-opacity': 0.2,\n        },\n        tested: {\n            fill: '#e5e5e5',\n            'stroke-opacity': 0.2,\n        },\n    },\n    nodeColorizeEffect: {\n        duration: 50,\n    },\n    nodeZoomEffect: {\n        duration: 200,\n        transform: 's1.2', // scale by 1.2x\n        transformBack: 's1.0',\n    },\n    pathStyle: {\n        stroke: 'yellow',\n        'stroke-width': 3,\n    },\n    supportedOperations: ['opened', 'closed', 'tested'],\n    init: function(opts) {\n        this.numCols      = opts.numCols;\n        this.numRows      = opts.numRows;\n        this.paper        = Raphael('draw_area');\n        this.$stats       = $('#stats');\n    },\n    /**\n     * Generate the grid asynchronously.\n     * This method will be a very expensive task.\n     * Therefore, in order to not to block the rendering of browser ui,\n     * I decomposed the task into smaller ones. Each will only generate a row.\n     */\n    generateGrid: function(callback) {\n        var i, j, x, y,\n            rect,\n            normalStyle, nodeSize,\n            createRowTask, sleep, tasks,\n            nodeSize    = this.nodeSize,\n            normalStyle = this.nodeStyle.normal,\n            numCols     = this.numCols,\n            numRows     = this.numRows,\n            paper       = this.paper,\n            rects       = this.rects = [],\n            $stats      = this.$stats;\n\n        paper.setSize(numCols * nodeSize, numRows * nodeSize);\n\n        createRowTask = function(rowId) {\n            return function(done) {\n                rects[rowId] = [];\n                for (j = 0; j < numCols; ++j) {\n                    x = j * nodeSize;\n                    y = rowId * nodeSize;\n\n                    rect = paper.rect(x, y, nodeSize, nodeSize);\n                    rect.attr(normalStyle);\n                    rects[rowId].push(rect);\n                }\n                $stats.text(\n                    'generating grid ' +\n                    Math.round((rowId + 1) / numRows * 100) + '%'\n                );\n                done(null);\n            };\n        };\n\n        sleep = function(done) {\n            setTimeout(function() {\n                done(null);\n            }, 0);\n        };\n\n        tasks = [];\n        for (i = 0; i < numRows; ++i) {\n            tasks.push(createRowTask(i));\n            tasks.push(sleep);\n        }\n\n        async.series(tasks, function() {\n            if (callback) {\n                callback();\n            }\n        });\n    },\n    setStartPos: function(gridX, gridY) {\n        var coord = this.toPageCoordinate(gridX, gridY);\n        if (!this.startNode) {\n            this.startNode = this.paper.rect(\n                coord[0],\n                coord[1],\n                this.nodeSize,\n                this.nodeSize\n            ).attr(this.nodeStyle.normal)\n             .animate(this.nodeStyle.start, 1000);\n        } else {\n            this.startNode.attr({ x: coord[0], y: coord[1] }).toFront();\n        }\n    },\n    setEndPos: function(gridX, gridY) {\n        var coord = this.toPageCoordinate(gridX, gridY);\n        if (!this.endNode) {\n            this.endNode = this.paper.rect(\n                coord[0],\n                coord[1],\n                this.nodeSize,\n                this.nodeSize\n            ).attr(this.nodeStyle.normal)\n             .animate(this.nodeStyle.end, 1000);\n        } else {\n            this.endNode.attr({ x: coord[0], y: coord[1] }).toFront();\n        }\n    },\n    /**\n     * Set the attribute of the node at the given coordinate.\n     */\n    setAttributeAt: function(gridX, gridY, attr, value) {\n        var color, nodeStyle = this.nodeStyle;\n        switch (attr) {\n        case 'walkable':\n            color = value ? nodeStyle.normal.fill : nodeStyle.blocked.fill;\n            this.setWalkableAt(gridX, gridY, value);\n            break;\n        case 'opened':\n            this.colorizeNode(this.rects[gridY][gridX], nodeStyle.opened.fill);\n            this.setCoordDirty(gridX, gridY, true);\n            break;\n        case 'closed':\n            this.colorizeNode(this.rects[gridY][gridX], nodeStyle.closed.fill);\n            this.setCoordDirty(gridX, gridY, true);\n            break;\n        case 'tested':\n            color = (value === true) ? nodeStyle.tested.fill : nodeStyle.normal.fill;\n\n            this.colorizeNode(this.rects[gridY][gridX], color);\n            this.setCoordDirty(gridX, gridY, true);\n            break;\n        case 'parent':\n            // XXX: Maybe draw a line from this node to its parent?\n            // This would be expensive.\n            break;\n        default:\n            console.error('unsupported operation: ' + attr + ':' + value);\n            return;\n        }\n    },\n    colorizeNode: function(node, color) {\n        node.animate({\n            fill: color\n        }, this.nodeColorizeEffect.duration);\n    },\n    zoomNode: function(node) {\n        node.toFront().attr({\n            transform: this.nodeZoomEffect.transform,\n        }).animate({\n            transform: this.nodeZoomEffect.transformBack,\n        }, this.nodeZoomEffect.duration);\n    },\n    setWalkableAt: function(gridX, gridY, value) {\n        var node, i, blockedNodes = this.blockedNodes;\n        if (!blockedNodes) {\n            blockedNodes = this.blockedNodes = new Array(this.numRows);\n            for (i = 0; i < this.numRows; ++i) {\n                blockedNodes[i] = [];\n            }\n        }\n        node = blockedNodes[gridY][gridX];\n        if (value) {\n            // clear blocked node\n            if (node) {\n                this.colorizeNode(node, this.rects[gridY][gridX].attr('fill'));\n                this.zoomNode(node);\n                setTimeout(function() {\n                    node.remove();\n                }, this.nodeZoomEffect.duration);\n                blockedNodes[gridY][gridX] = null;\n            }\n        } else {\n            // draw blocked node\n            if (node) {\n                return;\n            }\n            node = blockedNodes[gridY][gridX] = this.rects[gridY][gridX].clone();\n            this.colorizeNode(node, this.nodeStyle.blocked.fill);\n            this.zoomNode(node);\n        }\n    },\n    clearFootprints: function() {\n        var i, x, y, coord, coords = this.getDirtyCoords();\n        for (i = 0; i < coords.length; ++i) {\n            coord = coords[i];\n            x = coord[0];\n            y = coord[1];\n            this.rects[y][x].attr(this.nodeStyle.normal);\n            this.setCoordDirty(x, y, false);\n        }\n    },\n    clearBlockedNodes: function() {\n        var i, j, blockedNodes = this.blockedNodes;\n        if (!blockedNodes) {\n            return;\n        }\n        for (i = 0; i < this.numRows; ++i) {\n            for (j = 0 ;j < this.numCols; ++j) {\n                if (blockedNodes[i][j]) {\n                    blockedNodes[i][j].remove();\n                    blockedNodes[i][j] = null;\n                }\n            }\n        }\n    },\n    drawPath: function(path) {\n        if (!path.length) {\n            return;\n        }\n        var svgPath = this.buildSvgPath(path);\n        this.path = this.paper.path(svgPath).attr(this.pathStyle);\n    },\n    /**\n     * Given a path, build its SVG represention.\n     */\n    buildSvgPath: function(path) {\n        var i, strs = [], size = this.nodeSize;\n\n        strs.push('M' + (path[0][0] * size + size / 2) + ' ' +\n                  (path[0][1] * size + size / 2));\n        for (i = 1; i < path.length; ++i) {\n            strs.push('L' + (path[i][0] * size + size / 2) + ' ' +\n                      (path[i][1] * size + size / 2));\n        }\n\n        return strs.join('');\n    },\n    clearPath: function() {\n        if (this.path) {\n            this.path.remove();\n        }\n    },\n    /**\n     * Helper function to convert the page coordinate to grid coordinate\n     */\n    toGridCoordinate: function(pageX, pageY) {\n        return [\n            Math.floor(pageX / this.nodeSize),\n            Math.floor(pageY / this.nodeSize)\n        ];\n    },\n    /**\n     * helper function to convert the grid coordinate to page coordinate\n     */\n    toPageCoordinate: function(gridX, gridY) {\n        return [\n            gridX * this.nodeSize,\n            gridY * this.nodeSize\n        ];\n    },\n    showStats: function(opts) {\n        var texts = [\n            'length: ' + Math.round(opts.pathLength * 100) / 100,\n            'time: ' + opts.timeSpent + 'ms',\n            'operations: ' + opts.operationCount\n        ];\n        $('#stats').show().html(texts.join('<br>'));\n    },\n    setCoordDirty: function(gridX, gridY, isDirty) {\n        var x, y,\n            numRows = this.numRows,\n            numCols = this.numCols,\n            coordDirty;\n\n        if (this.coordDirty === undefined) {\n            coordDirty = this.coordDirty = [];\n            for (y = 0; y < numRows; ++y) {\n                coordDirty.push([]);\n                for (x = 0; x < numCols; ++x) {\n                    coordDirty[y].push(false);\n                }\n            }\n        }\n\n        this.coordDirty[gridY][gridX] = isDirty;\n    },\n    getDirtyCoords: function() {\n        var x, y,\n            numRows = this.numRows,\n            numCols = this.numCols,\n            coordDirty = this.coordDirty,\n            coords = [];\n\n        if (coordDirty === undefined) {\n            return [];\n        }\n\n        for (y = 0; y < numRows; ++y) {\n            for (x = 0; x < numCols; ++x) {\n                if (coordDirty[y][x]) {\n                    coords.push([x, y]);\n                }\n            }\n        }\n        return coords;\n    },\n};\n","numLines":336,"startLine":1,"totalLines":336}}}
