{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011Z7wjG3QhDBsezpWF8QEBh","type":"tool_result","content":"1\tvar PF        = require('..')\n2\tvar scenarios = require('./PathTestScenarios');\n3\t\n4\t/**\n5\t * Path-finding tests for the path-finders.\n6\t * @param {boolean} opt.optimal - Whether the finder is guaranteed to find the shortest path\n7\t */\n8\tfunction pathTest(opt) {\n9\t    var name = opt.name,\n10\t        finder = opt.finder,\n11\t        optimal = opt.optimal;\n12\t\n13\t    describe(name, function() {\n14\t        var startX, startY, endX, endY, grid, expectedLength,\n15\t            width, height, matrix, path, i, scen;\n16\t\n17\t        var test = (function() {\n18\t            var testId = 0;\n19\t\n20\t            return function(startX, startY, endX, endY, grid, expectedLength) {\n21\t                it('should solve maze '+ ++testId, function() {\n22\t                    path = finder.findPath(startX, startY, endX, endY, grid);\n23\t                    if (optimal) {\n24\t                        path.length.should.equal(expectedLength);\n25\t                    } else {\n26\t                        path[0].should.eql([startX, startY]);\n27\t                        path[path.length - 1].should.eql([endX, endY]);\n28\t                    }\n29\t                });\n30\t            };\n31\t        })();\n32\t\n33\t        // Load all the scenarios and test against the finder.\n34\t        for (i = 0; i < scenarios.length; ++i) {\n35\t            scen = scenarios[i];\n36\t\n37\t            matrix = scen.matrix;\n38\t            height = matrix.length;\n39\t            width = matrix[0].length;\n40\t\n41\t            grid = new PF.Grid(width, height, matrix);\n42\t\n43\t            test(\n44\t                scen.startX, scen.startY, \n45\t                scen.endX, scen.endY, \n46\t                grid, \n47\t                scen.expectedLength\n48\t            );\n49\t        }\n50\t    });\n51\t}\n52\t\n53\tfunction pathTests(tests) {\n54\t    for (i = 0; i < arguments.length; ++i) {\n55\t        pathTest(arguments[i]);\n56\t    }\n57\t}\n58\t\n59\t\n60\t// finders guaranteed to find the shortest path\n61\tpathTests({\n62\t    name: 'AStar',\n63\t    finder: new PF.AStarFinder(),\n64\t    optimal: true\n65\t}, {\n66\t    name: 'BreadthFirst',\n67\t    finder: new PF.BreadthFirstFinder(),\n68\t    optimal: true\n69\t}, {\n70\t    name: 'Dijkstra',\n71\t    finder: new PF.DijkstraFinder(),\n72\t    optimal: true\n73\t}, {\n74\t    name: 'BiBreadthFirst',\n75\t    finder: new PF.BiBreadthFirstFinder(),\n76\t    optimal: true\n77\t}, {\n78\t    name: 'BiDijkstra',\n79\t    finder: new PF.BiDijkstraFinder(),\n80\t    optimal: true\n81\t});\n82\t\n83\t// finders NOT guaranteed to find the shortest path\n84\tpathTests({\n85\t    name: 'BiAStar',\n86\t    finder: new PF.BiAStarFinder(),\n87\t    optimal: false\n88\t}, {\n89\t    name: 'BestFirst',\n90\t    finder: new PF.BestFirstFinder(),\n91\t    optimal: false\n92\t}, {\n93\t    name: 'BiBestFirst',\n94\t    finder: new PF.BiBestFirstFinder(),\n95\t    optimal: false\n96\t}, {\n97\t    name: 'IDAStar',\n98\t    finder: new PF.IDAStarFinder(),\n99\t    optimal: false\n100\t}, {\n101\t    name: 'JPFMoveDiagonallyIfAtMostOneObstacle',\n102\t    finder: new PF.JumpPointFinder({\n103\t      diagonalMovement: PF.DiagonalMovement.IfAtMostOneObstacle\n104\t    }),\n105\t    optimal: false\n106\t},  {\n107\t    name: 'JPFNeverMoveDiagonally',\n108\t    finder: new PF.JumpPointFinder({\n109\t      diagonalMovement: PF.DiagonalMovement.Never\n110\t    }),\n111\t    optimal: false\n112\t});\n113\t"}]},"parent_tool_use_id":null,"session_id":"d256549e-50d7-46ba-beb2-453bd9daa6a1","uuid":"b0e84589-dbb5-4596-b34a-a151fec3f4cf","timestamp":"2026-04-16T14:01:49.806Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/test/PathTest.js","content":"var PF        = require('..')\nvar scenarios = require('./PathTestScenarios');\n\n/**\n * Path-finding tests for the path-finders.\n * @param {boolean} opt.optimal - Whether the finder is guaranteed to find the shortest path\n */\nfunction pathTest(opt) {\n    var name = opt.name,\n        finder = opt.finder,\n        optimal = opt.optimal;\n\n    describe(name, function() {\n        var startX, startY, endX, endY, grid, expectedLength,\n            width, height, matrix, path, i, scen;\n\n        var test = (function() {\n            var testId = 0;\n\n            return function(startX, startY, endX, endY, grid, expectedLength) {\n                it('should solve maze '+ ++testId, function() {\n                    path = finder.findPath(startX, startY, endX, endY, grid);\n                    if (optimal) {\n                        path.length.should.equal(expectedLength);\n                    } else {\n                        path[0].should.eql([startX, startY]);\n                        path[path.length - 1].should.eql([endX, endY]);\n                    }\n                });\n            };\n        })();\n\n        // Load all the scenarios and test against the finder.\n        for (i = 0; i < scenarios.length; ++i) {\n            scen = scenarios[i];\n\n            matrix = scen.matrix;\n            height = matrix.length;\n            width = matrix[0].length;\n\n            grid = new PF.Grid(width, height, matrix);\n\n            test(\n                scen.startX, scen.startY, \n                scen.endX, scen.endY, \n                grid, \n                scen.expectedLength\n            );\n        }\n    });\n}\n\nfunction pathTests(tests) {\n    for (i = 0; i < arguments.length; ++i) {\n        pathTest(arguments[i]);\n    }\n}\n\n\n// finders guaranteed to find the shortest path\npathTests({\n    name: 'AStar',\n    finder: new PF.AStarFinder(),\n    optimal: true\n}, {\n    name: 'BreadthFirst',\n    finder: new PF.BreadthFirstFinder(),\n    optimal: true\n}, {\n    name: 'Dijkstra',\n    finder: new PF.DijkstraFinder(),\n    optimal: true\n}, {\n    name: 'BiBreadthFirst',\n    finder: new PF.BiBreadthFirstFinder(),\n    optimal: true\n}, {\n    name: 'BiDijkstra',\n    finder: new PF.BiDijkstraFinder(),\n    optimal: true\n});\n\n// finders NOT guaranteed to find the shortest path\npathTests({\n    name: 'BiAStar',\n    finder: new PF.BiAStarFinder(),\n    optimal: false\n}, {\n    name: 'BestFirst',\n    finder: new PF.BestFirstFinder(),\n    optimal: false\n}, {\n    name: 'BiBestFirst',\n    finder: new PF.BiBestFirstFinder(),\n    optimal: false\n}, {\n    name: 'IDAStar',\n    finder: new PF.IDAStarFinder(),\n    optimal: false\n}, {\n    name: 'JPFMoveDiagonallyIfAtMostOneObstacle',\n    finder: new PF.JumpPointFinder({\n      diagonalMovement: PF.DiagonalMovement.IfAtMostOneObstacle\n    }),\n    optimal: false\n},  {\n    name: 'JPFNeverMoveDiagonally',\n    finder: new PF.JumpPointFinder({\n      diagonalMovement: PF.DiagonalMovement.Never\n    }),\n    optimal: false\n});\n","numLines":113,"startLine":1,"totalLines":113}}}
