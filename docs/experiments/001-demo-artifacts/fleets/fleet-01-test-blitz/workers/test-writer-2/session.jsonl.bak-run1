\n\r  \u001b[32m  ✓\u001b[0m\u001b[90m should solve maze 3 \u001b[0m\n\r  \u001b[32m  ✓\u001b[0m\u001b[90m should solve maze 4 \u001b[0m\n\n\u001b[0m  Utility functions\u001b[0m\n\u001b[0m    interpolate\u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return the interpolated path \u001b[0m\n\u001b[0m    expandPath\u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return an empty array given an empty array \u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return the expanded path \u001b[0m\n\u001b[0m    compressPath\u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return the original path if it is too short to compress \u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return a compressed path \u001b[0m\n\u001b[0m    interpolate (additional cases)\u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return all coords on a horizontal line \u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return all coords on a diagonal line \u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return single element when start equals end \u001b[0m\n\u001b[0m    compressPath (edge cases)\u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return single-element path unchanged \u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return two-element path unchanged \u001b[0m\n\u001b[0m    backtrace\u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return the path from start to end \u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return single-node path when no parent \u001b[0m\n\u001b[0m    biBacktrace\u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should concatenate two backtraced paths meeting in middle \u001b[0m\n\u001b[0m    pathLength\u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return 0 for single-node path \u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return correct length for horizontal path \u001b[0m\n\r    \u001b[32m  ✓\u001b[0m\u001b[90m should return correct length for 3-4-5 diagonal \u00