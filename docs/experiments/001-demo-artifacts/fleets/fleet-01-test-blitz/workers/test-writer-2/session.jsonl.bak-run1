{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KKjF1bTcpovVPrLqW821Ni","type":"tool_result","content":"1\t/**\n2\t * Backtrace according to the parent records and return the path.\n3\t * (including both start and end nodes)\n4\t * @param {Node} node End node\n5\t * @return {Array<Array<number>>} the path\n6\t */\n7\tfunction backtrace(node) {\n8\t    var path = [[node.x, node.y]];\n9\t    while (node.parent) {\n10\t        node = node.parent;\n11\t        path.push([node.x, node.y]);\n12\t    }\n13\t    return path.reverse();\n14\t}\n15\texports.backtrace = backtrace;\n16\t\n17\t/**\n18\t * Backtrace from start and end node, and return the path.\n19\t * (including both start and end nodes)\n20\t * @param {Node}\n21\t * @param {Node}\n22\t */\n23\tfunction biBacktrace(nodeA, nodeB) {\n24\t    var pathA = backtrace(nodeA),\n25\t        pathB = backtrace(nodeB);\n26\t    return pathA.concat(pathB.reverse());\n27\t}\n28\texports.biBacktrace = biBacktrace;\n29\t\n30\t/**\n31\t * Compute the length of the path.\n32\t * @param {Array<Array<number>>} path The path\n33\t * @return {number} The length of the path\n34\t */\n35\tfunction pathLength(path) {\n36\t    var i, sum = 0, a, b, dx, dy;\n37\t    for (i = 1; i < path.length; ++i) {\n38\t        a = path[i - 1];\n39\t        b = path[i];\n40\t        dx = a[0] - b[0];\n41\t        dy = a[1] - b[1];\n42\t        sum += Math.sqrt(dx * dx + dy * dy);\n43\t    }\n44\t    return sum;\n45\t}\n46\texports.pathLength = pathLength;\n47\t\n48\t\n49\t/**\n50\t * Given the start and end coordinates, return all the coordinates lying\n51\t * on the line formed by these coordinates, based on Bresenham's algorithm.\n52\t * http://en.wikipedia.org/wiki/Bresenham's_line_algorithm#Simplification\n53\t * @param {number} x0 Start x coordinate\n54\t * @param {number} y0 Start y coordinate\n55\t * @param {number} x1 End x coordinate\n56\t * @param {number} y1 End y coordinate\n57\t * @return {Array<Array<number>>} The coordinates on the line\n58\t */\n59\tfunction interpolate(x0, y0, x1, y1) {\n60\t    var abs = Math.abs,\n61\t        line = [],\n62\t        sx, sy, dx, dy, err, e2;\n63\t\n64\t    dx = abs(x1 - x0);\n65\t    dy = abs(y1 - y0);\n66\t\n67\t    sx = (x0 < x1) ? 1 : -1;\n68\t    sy = (y0 < y1) ? 1 : -1;\n69\t\n70\t    err = dx - dy;\n71\t\n72\t    while (true) {\n73\t        line.push([x0, y0]);\n74\t\n75\t        if (x0 === x1 && y0 === y1) {\n76\t            break;\n77\t        }\n78\t        \n79\t        e2 = 2 * err;\n80\t        if (e2 > -dy) {\n81\t            err = err - dy;\n82\t            x0 = x0 + sx;\n83\t        }\n84\t        if (e2 < dx) {\n85\t            err = err + dx;\n86\t            y0 = y0 + sy;\n87\t        }\n88\t    }\n89\t\n90\t    return line;\n91\t}\n92\texports.interpolate = interpolate;\n93\t\n94\t\n95\t/**\n96\t * Given a compressed path, return a new path that has all the segments\n97\t * in it interpolated.\n98\t * @param {Array<Array<number>>} path The path\n99\t * @return {Array<Array<number>>} expanded path\n100\t */\n101\tfunction expandPath(path) {\n102\t    var expanded = [],\n103\t        len = path.length,\n104\t        coord0, coord1,\n105\t        interpolated,\n106\t        interpolatedLen,\n107\t        i, j;\n108\t\n109\t    if (len < 2) {\n110\t        return expanded;\n111\t    }\n112\t\n113\t    for (i = 0; i < len - 1; ++i) {\n114\t        coord0 = path[i];\n115\t        coord1 = path[i + 1];\n116\t\n117\t        interpolated = interpolate(coord0[0], coord0[1], coord1[0], coord1[1]);\n118\t        interpolatedLen = interpolated.length;\n119\t        for (j = 0; j < interpolatedLen - 1; ++j) {\n120\t            expanded.push(interpolated[j]);\n121\t        }\n122\t    }\n123\t    expanded.push(path[len - 1]);\n124\t\n125\t    return expanded;\n126\t}\n127\texports.expandPath = expandPath;\n128\t\n129\t\n130\t/**\n131\t * Smoothen the give path.\n132\t * The original path will not be modified; a new path will be returned.\n133\t * @param {PF.Grid} grid\n134\t * @param {Array<Array<number>>} path The path\n135\t */\n136\tfunction smoothenPath(grid, path) {\n137\t    var len = path.length,\n138\t        x0 = path[0][0],        // path start x\n139\t        y0 = path[0][1],        // path start y\n140\t        x1 = path[len - 1][0],  // path end x\n141\t        y1 = path[len - 1][1],  // path end y\n142\t        sx, sy,                 // current start coordinate\n143\t        ex, ey,                 // current end coordinate\n144\t        newPath,\n145\t        i, j, coord, line, testCoord, blocked;\n146\t\n147\t    sx = x0;\n148\t    sy = y0;\n149\t    newPath = [[sx, sy]];\n150\t\n151\t    for (i = 2; i < len; ++i) {\n152\t        coord = path[i];\n153\t        ex = coord[0];\n154\t        ey = coord[1];\n155\t        line = interpolate(sx, sy, ex, ey);\n156\t\n157\t        blocked = false;\n158\t        for (j = 1; j < line.length; ++j) {\n159\t            testCoord = line[j];\n160\t\n161\t            if (!grid.isWalkableAt(testCoord[0], testCoord[1])) {\n162\t                blocked = true;\n163\t                break;\n164\t            }\n165\t        }\n166\t        if (blocked) {\n167\t            lastValidCoord = path[i - 1];\n168\t            newPath.push(lastValidCoord);\n169\t            sx = lastValidCoord[0];\n170\t            sy = lastValidCoord[1];\n171\t        }\n172\t    }\n173\t    newPath.push([x1, y1]);\n174\t\n175\t    return newPath;\n176\t}\n177\texports.smoothenPath = smoothenPath;\n178\t\n179\t\n180\t/**\n181\t * Compress a path, remove redundant nodes without altering the shape\n182\t * The original path is not modified\n183\t * @param {Array<Array<number>>} path The path\n184\t * @return {Array<Array<number>>} The compressed path\n185\t */\n186\tfunction compressPath(path) {\n187\t\n188\t    // nothing to compress\n189\t    if(path.length < 3) {\n190\t        return path;\n191\t    }\n192\t\n193\t    var compressed = [],\n194\t        sx = path[0][0], 