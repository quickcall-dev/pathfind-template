{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V766vBtD7HoH9P5XGR4HYC","type":"tool_result","content":"1\tvar PF = require('..');\n2\tvar should = require('should');\n3\t\n4\tvar Grid = PF.Grid;\n5\tvar DiagonalMovement = PF.DiagonalMovement;\n6\tvar Heuristic = PF.Heuristic;\n7\tvar IDAStarFinder = PF.IDAStarFinder;\n8\t\n9\tfunction openGrid(w, h) {\n10\t    return new Grid(w || 5, h || 5);\n11\t}\n12\t\n13\tdescribe('IDAStarFinder', function() {\n14\t\n15\t    it('finds path on simple open grid', function() {\n16\t        var grid = openGrid();\n17\t        var finder = new IDAStarFinder();\n18\t        var path = finder.findPath(0, 0, 4, 4, grid);\n19\t        path.length.should.be.above(0);\n20\t        path[0].should.eql([0, 0]);\n21\t        path[path.length - 1].should.eql([4, 4]);\n22\t    });\n23\t\n24\t    it('no-path scenario returns []', function() {\n25\t        var matrix = [\n26\t            [0, 1, 0],\n27\t            [1, 1, 0],\n28\t            [0, 0, 0]\n29\t        ];\n30\t        var grid = new Grid(matrix);\n31\t        var finder = new IDAStarFinder();\n32\t        var path = finder.findPath(0, 0, 2, 0, grid);\n33\t        path.should.eql([]);\n34\t    });\n35\t\n36\t    it('route array construction: path includes start and end', function() {\n37\t        var grid = openGrid();\n38\t        var finder = new IDAStarFinder();\n39\t        var path = finder.findPath(0, 0, 3, 3, grid);\n40\t        path[0].should.eql([0, 0]);\n41\t        path[path.length - 1].should.eql([3, 3]);\n42\t    });\n43\t\n44\t    it('timeLimit option: returns [] when time expires', function() {\n45\t        // Very small timeLimit (0.000001 seconds = 0.001ms) forces expiry\n46\t        var matrix = [];\n47\t        for (var y = 0; y < 20; y++) {\n48\t            matrix.push([]);\n49\t            for (var x = 0; x < 20; x++) {\n50\t                matrix[y].push(0);\n51\t            }\n52\t        }\n53\t        var grid = new Grid(matrix);\n54\t        var finder = new IDAStarFinder({ timeLimit: 0.000001 });\n55\t        var path = finder.findPath(0, 0, 19, 19, grid);\n56\t        path.should.eql([]);\n57\t    });\n58\t\n59\t    it('trackRecursion: true — retainCount and tested tracking', function() {\n60\t        var grid = openGrid();\n61\t        var finder = new IDAStarFinder({ trackRecursion: true });\n62\t        var path = finder.findPath(0, 0, 4, 4, grid);\n63\t        path.length.should.be.above(0);\n64\t        // At least some nodes should have been marked tested during search\n65\t        var anyTested = false;\n66\t        for (var y = 0; y < 5; y++) {\n67\t            for (var x = 0; x < 5; x++) {\n68\t                var node = grid.getNodeAt(x, y);\n69\t                if (node.retainCount > 0 || node.tested === true) {\n70\t                    anyTested = true;\n71\t                }\n72\t            }\n73\t        }\n74\t        // After search completes, retainCounts decrement back to 0\n75\t        // but `tested` is reset to false on backtrack, so just verify no errors thrown\n76\t        path.should.be.an.Array();\n77\t    });\n78\t\n79\t    it('weight != 1 still finds a path', function() {\n80\t        var grid = openGrid();\n81\t        var finder = new IDAStarFinder({ weight: 2 });\n82\t        var path = finder.findPath(0, 0, 4, 4, grid);\n83\t        path.length.should.be.above(0);\n84\t        path[0].should.eql([0, 0]);\n85\t        path[path.length - 1].should.eql([4, 4]);\n86\t    });\n87\t\n88\t    it('custom heuristic: euclidean', function() {\n89\t        var grid = openGrid();\n90\t        var finder = new IDAStarFinder({ heuristic: Heuristic.euclidean });\n91\t        var path = finder.findPath(0, 0, 4, 4, grid);\n92\t        path.length.should.be.above(0);\n93\t        path[0].should.eql([0, 0]);\n94\t        path[path.length - 1].should.eql([4, 4]);\n95\t    });\n96\t\n97\t    it('custom heuristic: chebyshev', function() {\n98\t        var grid = openGrid();\n99\t        var finder = new IDAStarFinder({ heuristic: Heuristic.chebyshev });\n100\t        var path = finder.findPath(0, 0, 4, 4, grid);\n101\t        path.length.should.be.above(0);\n102\t    });\n103\t\n104\t    it('diagonal movement: Always', function() {\n105\t        var grid = openGrid();\n106\t        var finder = new IDAStarFinder({ diagonalMovement: DiagonalMovement.Always });\n107\t        var path = finder.findPath(0, 0, 4, 4, grid);\n108\t        path.length.should.be.above(0);\n109\t        path[0].should.eql([0, 0]);\n110\t        path[path.length - 1].should.eql([4, 4]);\n111\t    });\n112\t\n113\t    it('diagonal movement: Never', function() {\n114\t        var grid = openGrid();\n115\t        var finder = new IDAStarFinder({ diagonalMovement: DiagonalMovement.Never });\n116\t        var path = finder.findPath(0, 0, 4, 4, grid);\n117\t        path.length.should.be.above(0);\n118\t        path[0].should.eql([0, 0]);\n119\t        path[path.length - 1].should.eql([4, 4]);\n120\t    });\n121\t\n122\t    it('diagonal movement: IfAtMostOneObstacle', function() {\n123\t        var grid = openGrid();\n124\t        var finder = new IDAStarFinder({ diagonalMovement: DiagonalMovement.IfAtMostOneObstacle });\n125\t        var path = finder.findPath(0, 0, 4, 4, grid);\n126\t        path.length.should.be.above(0);\n127\t    });\n128\t\n129\t    it('diagonal movement: OnlyWhenNoObstacles', function() {\n130\t        var grid = openGrid();\n131\t        var finder = new IDAStarFinder({ diagonalMovement: DiagonalMovement.OnlyWhenNoObstacles });\n132\t        var path = finder.findPath(0, 0, 4, 4, grid);\n133\t        path.length.should.be.above(0);\n134\t    });\n135\t\n136\t    it('deprecated allowDiagonal=true falls back to IfAtMostOneObstacle', function() {\n137\t        var grid = openGrid();\n138\t        var finder = new IDAStarFinder({ allowDiagonal: true });\n139\t        var path = finder.findPath(0, 0, 4, 4, grid);\n140\t        path.length.should.be.above(0);\n141\t    });\n142\t\n143\t    it('deprecated allowDiagonal=false falls back to Never', function() {\n144\t        var grid = openGrid();\n145\t        var finder = new IDAStarFinder({ allowDiagonal: false });\n146\t        var path = finder.findPath(0, 0, 4, 4, grid);\n147\t        path.length.should.be.above(0);\n148\t    });\n149\t});\n150\t"}]},"parent_tool_use_id":null,"session_id":"fdbe8a25-98f6-47c1-a871-b0add9ba0ea4","uuid":"9ff71cfe-4d71-46bd-8761-0068ec60dbd2","timestamp":"2026-04-16T14:05:24.155Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/test/IDAStarFinder.js","content":"var PF = require('..');\nvar should = require('should');\n\nvar Grid = PF.Grid;\nvar DiagonalMovement = PF.DiagonalMovement;\nvar Heuristic = PF.Heuristic;\nvar IDAStarFinder = PF.IDAStarFinder;\n\nfunction openGrid(w, h) {\n    return new Grid(w || 5, h || 5);\n}\n\ndescribe('IDAStarFinder', function() {\n\n    it('finds path on simple open grid', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder();\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n        path[0].should.eql([0, 0]);\n        path[path.length - 1].should.eql([4, 4]);\n    });\n\n    it('no-path scenario returns []', function() {\n        var matrix = [\n            [0, 1, 0],\n            [1, 1, 0],\n            [0, 0, 0]\n        ];\n        var grid = new Grid(matrix);\n        var finder = new IDAStarFinder();\n        var path = finder.findPath(0, 0, 2, 0, grid);\n        path.should.eql([]);\n    });\n\n    it('route array construction: path includes start and end', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder();\n        var path = finder.findPath(0, 0, 3, 3, grid);\n        path[0].should.eql([0, 0]);\n        path[path.length - 1].should.eql([3, 3]);\n    });\n\n    it('timeLimit option: returns [] when time expires', function() {\n        // Very small timeLimit (0.000001 seconds = 0.001ms) forces expiry\n        var matrix = [];\n        for (var y = 0; y < 20; y++) {\n            matrix.push([]);\n            for (var x = 0; x < 20; x++) {\n                matrix[y].push(0);\n            }\n        }\n        var grid = new Grid(matrix);\n        var finder = new IDAStarFinder({ timeLimit: 0.000001 });\n        var path = finder.findPath(0, 0, 19, 19, grid);\n        path.should.eql([]);\n    });\n\n    it('trackRecursion: true — retainCount and tested tracking', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ trackRecursion: true });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n        // At least some nodes should have been marked tested during search\n        var anyTested = false;\n        for (var y = 0; y < 5; y++) {\n            for (var x = 0; x < 5; x++) {\n                var node = grid.getNodeAt(x, y);\n                if (node.retainCount > 0 || node.tested === true) {\n                    anyTested = true;\n                }\n            }\n        }\n        // After search completes, retainCounts decrement back to 0\n        // but `tested` is reset to false on backtrack, so just verify no errors thrown\n        path.should.be.an.Array();\n    });\n\n    it('weight != 1 still finds a path', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ weight: 2 });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n        path[0].should.eql([0, 0]);\n        path[path.length - 1].should.eql([4, 4]);\n    });\n\n    it('custom heuristic: euclidean', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ heuristic: Heuristic.euclidean });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n        path[0].should.eql([0, 0]);\n        path[path.length - 1].should.eql([4, 4]);\n    });\n\n    it('custom heuristic: chebyshev', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ heuristic: Heuristic.chebyshev });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n    });\n\n    it('diagonal movement: Always', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ diagonalMovement: DiagonalMovement.Always });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n        path[0].should.eql([0, 0]);\n        path[path.length - 1].should.eql([4, 4]);\n    });\n\n    it('diagonal movement: Never', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ diagonalMovement: DiagonalMovement.Never });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n        path[0].should.eql([0, 0]);\n        path[path.length - 1].should.eql([4, 4]);\n    });\n\n    it('diagonal movement: IfAtMostOneObstacle', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ diagonalMovement: DiagonalMovement.IfAtMostOneObstacle });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n    });\n\n    it('diagonal movement: OnlyWhenNoObstacles', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ diagonalMovement: DiagonalMovement.OnlyWhenNoObstacles });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n    });\n\n    it('deprecated allowDiagonal=true falls back to IfAtMostOneObstacle', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ allowDiagonal: true });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n    });\n\n    it('deprecated allowDiagonal=false falls back to Never', function() {\n        var grid = openGrid();\n        var finder = new IDAStarFinder({ allowDiagonal: false });\n        var path = finder.findPath(0, 0, 4, 4, grid);\n        path.length.should.be.above(0);\n    });\n});\n","numLines":150,"startLine":1,"totalLines":150}}}
