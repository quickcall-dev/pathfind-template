{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LfT6xPkqoSf5trfXwv6mGa","type":"tool_result","content":"1\t/**\n2\t * The control panel.\n3\t */\n4\tvar Panel = {\n5\t    init: function() {\n6\t        var $algo = $('#algorithm_panel');\n7\t\n8\t        $('.panel').draggable();\n9\t        $('.accordion').accordion({\n10\t            collapsible: false,\n11\t        });\n12\t        $('.option_label').click(function() {\n13\t            $(this).prev().click();\n14\t        });\n15\t        $('#hide_instructions').click(function() {\n16\t            $('#instructions_panel').slideUp();\n17\t        });\n18\t        $('#play_panel').css({\n19\t            top: $algo.offset().top + $algo.outerHeight() + 20\n20\t        });\n21\t        $('#button2').attr('disabled', 'disabled');\n22\t    },\n23\t    /**\n24\t     * Get the user selected path-finder.\n25\t     * TODO: clean up this messy code.\n26\t     */\n27\t    getFinder: function() {\n28\t        var finder, selected_header, heuristic, allowDiagonal, biDirectional, dontCrossCorners, weight, trackRecursion, timeLimit;\n29\t        \n30\t        selected_header = $(\n31\t            '#algorithm_panel ' +\n32\t            '.ui-accordion-header[aria-selected=true]'\n33\t        ).attr('id');\n34\t        \n35\t        switch (selected_header) {\n36\t\n37\t        case 'astar_header':\n38\t            allowDiagonal = typeof $('#astar_section ' +\n39\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n40\t            biDirectional = typeof $('#astar_section ' +\n41\t                                     '.bi-directional:checked').val() !=='undefined';\n42\t            dontCrossCorners = typeof $('#astar_section ' +\n43\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n44\t\n45\t            /* parseInt returns NaN (which is falsy) if the string can't be parsed */\n46\t            weight = parseInt($('#astar_section .spinner').val()) || 1;\n47\t            weight = weight >= 1 ? weight : 1; /* if negative or 0, use 1 */\n48\t\n49\t            heuristic = $('input[name=astar_heuristic]:checked').val();\n50\t            if (biDirectional) {\n51\t                finder = new PF.BiAStarFinder({\n52\t                    allowDiagonal: allowDiagonal,\n53\t                    dontCrossCorners: dontCrossCorners,\n54\t                    heuristic: PF.Heuristic[heuristic],\n55\t                    weight: weight\n56\t                });\n57\t            } else {\n58\t                finder = new PF.AStarFinder({\n59\t                    allowDiagonal: allowDiagonal,\n60\t                    dontCrossCorners: dontCrossCorners,\n61\t                    heuristic: PF.Heuristic[heuristic],\n62\t                    weight: weight\n63\t                });\n64\t            }\n65\t            break;\n66\t\n67\t        case 'breadthfirst_header':\n68\t            allowDiagonal = typeof $('#breadthfirst_section ' +\n69\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n70\t            biDirectional = typeof $('#breadthfirst_section ' +\n71\t                                     '.bi-directional:checked').val() !== 'undefined';\n72\t            dontCrossCorners = typeof $('#breadthfirst_section ' +\n73\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n74\t            if (biDirectional) {\n75\t                finder = new PF.BiBreadthFirstFinder({\n76\t                    allowDiagonal: allowDiagonal,\n77\t                    dontCrossCorners: dontCrossCorners\n78\t                });\n79\t            } else {\n80\t                finder = new PF.BreadthFirstFinder({\n81\t                    allowDiagonal: allowDiagonal,\n82\t                    dontCrossCorners: dontCrossCorners\n83\t                });\n84\t            }\n85\t            break;\n86\t\n87\t        case 'bestfirst_header':\n88\t            allowDiagonal = typeof $('#bestfirst_section ' +\n89\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n90\t            biDirectional = typeof $('#bestfirst_section ' +\n91\t                                     '.bi-directional:checked').val() !== 'undefined';\n92\t            dontCrossCorners = typeof $('#bestfirst_section ' +\n93\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n94\t            heuristic = $('input[name=bestfirst_heuristic]:checked').val();\n95\t            if (biDirectional) {\n96\t                finder = new PF.BiBestFirstFinder({\n97\t                    allowDiagonal: allowDiagonal,\n98\t                    dontCrossCorners: dontCrossCorners,\n99\t                    heuristic: PF.Heuristic[heuristic]\n100\t                });\n101\t            } else {\n102\t                finder = new PF.BestFirstFinder({\n103\t                    allowDiagonal: allowDiagonal,\n104\t                    dontCrossCorners: dontCrossCorners,\n105\t                    heuristic: PF.Heuristic[heuristic]\n106\t                });\n107\t            }\n108\t            break;\n109\t\n110\t        case 'dijkstra_header':\n111\t            allowDiagonal = typeof $('#dijkstra_section ' +\n112\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n113\t            biDirectional = typeof $('#dijkstra_section ' +\n114\t                                     '.bi-directional:checked').val() !=='undefined';\n115\t            dontCrossCorners = typeof $('#dijkstra_section ' +\n116\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n117\t            if (biDirectional) {\n118\t                finder = new PF.BiDijkstraFinder({\n119\t                    allowDiagonal: allowDiagonal,\n120\t                    dontCrossCorners: dontCrossCorners\n121\t                });\n122\t            } else {\n123\t                finder = new PF.DijkstraFinder({\n124\t                    allowDiagonal: allowDiagonal,\n125\t                    dontCrossCorners: dontCrossCorners\n126\t                });\n127\t            }\n128\t            break;\n129\t\n130\t        case 'jump_point_header':\n131\t            trackRecursion = typeof $('#jump_point_section ' +\n132\t                                     '.track_recursion:checked').val() !== 'undefined';\n133\t            heuristic = $('input[name=jump_point_heuristic]:checked').val();\n134\t            \n135\t            finder = new PF.JumpPointFinder({\n136\t              trackJumpRecursion: trackRecursion,\n137\t              heuristic: PF.Heuristic[heuristic],\n138\t              diagonalMovement: PF.DiagonalMovement.IfAtMostOneObstacle\n139\t            });\n140\t            break;\n141\t        case 'orth_jump_point_header':\n142\t            trackRecursion = typeof $('#orth_jump_point_section ' +\n143\t                                     '.track_recursion:checked').val() !== 'undefined';\n144\t            heuristic = $('input[name=orth_jump_point_heuristic]:checked').val();\n145\t\n146\t            finder = new PF.JumpPointFinder({\n147\t              trackJumpRecursion: trackRecursion,\n148\t              heuristic: PF.Heuristic[heuristic],\n149\t              diagonalMovement: PF.DiagonalMovement.Never\n150\t            });\n151\t            break;\n152\t        case 'ida_header':\n153\t            allowDiagonal = typeof $('#ida_section ' +\n154\t                                     '.allow_diagonal:checked').val() !== 'undefined';\n155\t            dontCrossCorners = typeof $('#ida_section ' +\n156\t                                     '.dont_cross_corners:checked').val() !=='undefined';\n157\t            trackRecursion = typeof $('#ida_section ' +\n158\t                                     '.track_recursion:checked').val() !== 'undefined';\n159\t\n160\t            heuristic = $('input[name=jump_point_heuristic]:checked').val();\n161\t\n162\t            weight = parseInt($('#ida_section input[name=astar_weight]').val()) || 1;\n163\t            weight = weight >= 1 ? weight : 1; /* if negative or 0, use 1 */\n164\t\n165\t            timeLimit = parseInt($('#ida_section input[name=time_limit]').val());\n166\t\n167\t            // Any non-negative integer, indicates \"forever\".\n168\t            timeLimit = (timeLimit <= 0 || isNaN(timeLimit)) ? -1 : timeLimit;\n169\t\n170\t            finder = new PF.IDAStarFinder({\n171\t              timeLimit: timeLimit,\n172\t              trackRecursion: trackRecursion,\n173\t              allowDiagonal: allowDiagonal,\n174\t              dontCrossCorners: dontCrossCorners,\n175\t              heuristic: PF.Heuristic[heuristic],\n176\t              weight: weight\n177\t            });\n178\t\n179\t            break;\n180\t        }\n181\t\n182\t        return finder;\n183\t    }\n184\t};\n185\t"}]},"parent_tool_use_id":null,"session_id":"fdbe8a25-98f6-47c1-a871-b0add9ba0ea4","uuid":"e79f14ff-acbf-4e32-b2c8-81e85035f95a","timestamp":"2026-04-16T14:04:46.963Z","tool_use_result":{"type":"text","file":{"filePath":"/home/sagar/template-repo/visual/js/panel.js","content":"/**\n * The control panel.\n */\nvar Panel = {\n    init: function() {\n        var $algo = $('#algorithm_panel');\n\n        $('.panel').draggable();\n        $('.accordion').accordion({\n            collapsible: false,\n        });\n        $('.option_label').click(function() {\n            $(this).prev().click();\n        });\n        $('#hide_instructions').click(function() {\n            $('#instructions_panel').slideUp();\n        });\n        $('#play_panel').css({\n            top: $algo.offset().top + $algo.outerHeight() + 20\n        });\n        $('#button2').attr('disabled', 'disabled');\n    },\n    /**\n     * Get the user selected path-finder.\n     * TODO: clean up this messy code.\n     */\n    getFinder: function() {\n        var finder, selected_header, heuristic, allowDiagonal, biDirectional, dontCrossCorners, weight, trackRecursion, timeLimit;\n        \n        selected_header = $(\n            '#algorithm_panel ' +\n            '.ui-accordion-header[aria-selected=true]'\n        ).attr('id');\n        \n        switch (selected_header) {\n\n        case 'astar_header':\n            allowDiagonal = typeof $('#astar_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            biDirectional = typeof $('#astar_section ' +\n                                     '.bi-directional:checked').val() !=='undefined';\n            dontCrossCorners = typeof $('#astar_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n\n            /* parseInt returns NaN (which is falsy) if the string can't be parsed */\n            weight = parseInt($('#astar_section .spinner').val()) || 1;\n            weight = weight >= 1 ? weight : 1; /* if negative or 0, use 1 */\n\n            heuristic = $('input[name=astar_heuristic]:checked').val();\n            if (biDirectional) {\n                finder = new PF.BiAStarFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners,\n                    heuristic: PF.Heuristic[heuristic],\n                    weight: weight\n                });\n            } else {\n                finder = new PF.AStarFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners,\n                    heuristic: PF.Heuristic[heuristic],\n                    weight: weight\n                });\n            }\n            break;\n\n        case 'breadthfirst_header':\n            allowDiagonal = typeof $('#breadthfirst_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            biDirectional = typeof $('#breadthfirst_section ' +\n                                     '.bi-directional:checked').val() !== 'undefined';\n            dontCrossCorners = typeof $('#breadthfirst_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n            if (biDirectional) {\n                finder = new PF.BiBreadthFirstFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners\n                });\n            } else {\n                finder = new PF.BreadthFirstFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners\n                });\n            }\n            break;\n\n        case 'bestfirst_header':\n            allowDiagonal = typeof $('#bestfirst_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            biDirectional = typeof $('#bestfirst_section ' +\n                                     '.bi-directional:checked').val() !== 'undefined';\n            dontCrossCorners = typeof $('#bestfirst_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n            heuristic = $('input[name=bestfirst_heuristic]:checked').val();\n            if (biDirectional) {\n                finder = new PF.BiBestFirstFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners,\n                    heuristic: PF.Heuristic[heuristic]\n                });\n            } else {\n                finder = new PF.BestFirstFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners,\n                    heuristic: PF.Heuristic[heuristic]\n                });\n            }\n            break;\n\n        case 'dijkstra_header':\n            allowDiagonal = typeof $('#dijkstra_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            biDirectional = typeof $('#dijkstra_section ' +\n                                     '.bi-directional:checked').val() !=='undefined';\n            dontCrossCorners = typeof $('#dijkstra_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n            if (biDirectional) {\n                finder = new PF.BiDijkstraFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners\n                });\n            } else {\n                finder = new PF.DijkstraFinder({\n                    allowDiagonal: allowDiagonal,\n                    dontCrossCorners: dontCrossCorners\n                });\n            }\n            break;\n\n        case 'jump_point_header':\n            trackRecursion = typeof $('#jump_point_section ' +\n                                     '.track_recursion:checked').val() !== 'undefined';\n            heuristic = $('input[name=jump_point_heuristic]:checked').val();\n            \n            finder = new PF.JumpPointFinder({\n              trackJumpRecursion: trackRecursion,\n              heuristic: PF.Heuristic[heuristic],\n              diagonalMovement: PF.DiagonalMovement.IfAtMostOneObstacle\n            });\n            break;\n        case 'orth_jump_point_header':\n            trackRecursion = typeof $('#orth_jump_point_section ' +\n                                     '.track_recursion:checked').val() !== 'undefined';\n            heuristic = $('input[name=orth_jump_point_heuristic]:checked').val();\n\n            finder = new PF.JumpPointFinder({\n              trackJumpRecursion: trackRecursion,\n              heuristic: PF.Heuristic[heuristic],\n              diagonalMovement: PF.DiagonalMovement.Never\n            });\n            break;\n        case 'ida_header':\n            allowDiagonal = typeof $('#ida_section ' +\n                                     '.allow_diagonal:checked').val() !== 'undefined';\n            dontCrossCorners = typeof $('#ida_section ' +\n                                     '.dont_cross_corners:checked').val() !=='undefined';\n            trackRecursion = typeof $('#ida_section ' +\n                                     '.track_recursion:checked').val() !== 'undefined';\n\n            heuristic = $('input[name=jump_point_heuristic]:checked').val();\n\n            weight = parseInt($('#ida_section input[name=astar_weight]').val()) || 1;\n            weight = weight >= 1 ? weight : 1; /* if negative or 0, use 1 */\n\n            timeLimit = parseInt($('#ida_section input[name=time_limit]').val());\n\n            // Any non-negative integer, indicates \"forever\".\n            timeLimit = (timeLimit <= 0 || isNaN(timeLimit)) ? -1 : timeLimit;\n\n            finder = new PF.IDAStarFinder({\n              timeLimit: timeLimit,\n              trackRecursion: trackRecursion,\n              allowDiagonal: allowDiagonal,\n              dontCrossCorners: dontCrossCorners,\n              heuristic: PF.Heuristic[heuristic],\n              weight: weight\n            });\n\n            break;\n        }\n\n        return finder;\n    }\n};\n","numLines":185,"startLine":1,"totalLines":185}}}
